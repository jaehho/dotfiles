{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 4,

    "modules-left": [
        "hyprland/workspaces",
        "custom/scratchpad",
        "custom/tray",
        "hyprland/window"
    ],
    "modules-center": [
        "mpris",
        "clock"
    ],
    "modules-right": [
        "tray",
        "custom/idle-inhibitor",
        "custom/swaync",
        "custom/reboot-needed",
        "cpu",
        "memory",
        "pulseaudio",
        "backlight",
        "group/power",
        "bluetooth",
        "network",
        "custom/power"
    ],

    "group/power": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 500,
            "children-class": "drawer-child",
            "transition-left-to-right": false
        },
        "modules": ["battery", "power-profiles-daemon"]
    },

    "hyprland/workspaces": {
        "format": "{name} {windows}",
        "format-window-separator": " ",
        "on-click": "activate",
        "sort-by-number": true,
        "window-rewrite-default": "󰏗",
        "window-rewrite": {
            "kitty": "󰄛",
            "foot": "󰄛",
            "Alacritty": "󰄛",
            "firefox.*": "󰈹",
            "chromium": "󰊯",
            "brave-browser": "󰊯",
            "thunar": "󰉋",
            "nautilus": "󰉋",
            "spotify": "󰓇",
            "discord": "󰙯",
            "vesktop": "󰙯",
            "code.*": "󰨞",
            "neovide": "",
            "obsidian": "󰎞",
            "steam.*": "󰓓",
            "mpv": "󰐌",
            "vlc": "󰐌",
            "org.telegram.*": "󰔁",
            "Slack": "󰒱",
            "zoom": "󰍫",
            "blueman.*": "󰂯",
            "pavucontrol": "󰕾",
            "org.gnome.Calculator": "󰃬",
            "org.pwmt.zathura": "󰈙",
            "Zotero": "󱉟",
            "microsoft-edge.*": "󰇩",
            "libreoffice.*": "󰈙",
            "com.gabm.satty": "󰄀",
            "x2goclient": "󰢹",
            "thunderbird": "󰺻",
            "wiremix": "󰕾"
        }
    },

    "hyprland/window": {
        "max-length": 50
    },

    "clock": {
        "format": "{:%a %b %d  %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%Y-%m-%d %H:%M:%S}"
    },

    "mpris": {
        "format": "{player_icon} {dynamic}",
        "format-paused": "{status_icon} {dynamic}",
        "player-icons": {
            "default": "▶",
            "mpv": "󰐌",
            "spotify": "󰓇",
            "spotify_player": "󰓇",
            "vesktop": "󰙯",
            "discord": "󰙯",
            "vlc": "󰐌",
            "firefox": "󰈹",
            "chromium": "󰊯"
        },
        "status-icons": {
            "paused": "⏸"
        },
        "dynamic-len": 50,
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-click-middle": "playerctl previous"
    },

    "cpu": {
        "interval": 5,
        "format": "CPU {usage}%",
        "tooltip-format": "{avg_frequency} GHz\n{usage}% usage",
        "on-click": "kitty -e btop"
    },

    "memory": {
        "interval": 10,
        "format": "RAM {percentage}%",
        "tooltip-format": "{used:0.1f} GiB / {total:0.1f} GiB\n{swapUsed:0.1f} GiB swap",
        "on-click": "kitty -e btop"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-connected": "󰂱 {device_alias}",
        "format-connected-battery": "󰂱 {device_alias} {device_battery_percentage}%",
        "format-off": "󰂲",
        "format-alt": "󰂯 {num_connections}",
        "on-click-right": "kitty --class floating-tui -e bluetui",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-alt": "{icon} {time}",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "{timeTo}\n{power:.1f}W\nHealth: {health}%"
    },

    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Profile: {profile}\nDriver: {driver}",
        "format-icons": {
            "default": "󰗑",
            "performance": "󱐋",
            "balanced": "󰗑",
            "power-saver": "󰌪"
        }
    },

    "network": {
        "format-wifi": "󰤨 {essid}",
        "format-ethernet": "󰈀 {ipaddr}/{cidr}",
        "format-linked": "󰈀 {ifname} (No IP)",
        "format-disconnected": "󰤭 Disconnected",
        "format-alt": "{ifname}: {ipaddr}/{cidr}",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ifname} via {gwaddr}\n{ipaddr}/{cidr}\n↑ {bandwidthUpBits} ↓ {bandwidthDownBits}",
        "tooltip-format": "{ifname} via {gwaddr}\n{ipaddr}/{cidr}",
        "on-click-right": "kitty --class floating-tui -e nmtui"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-bluetooth": "󰂰 {volume}%",
        "format-muted": "󰝟 Muted",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "kitty --class floating-tui -e wiremix",
        "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },

    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "on-scroll-up": "brightnessctl -e4 -n2 set 5%+",
        "on-scroll-down": "brightnessctl -e4 -n2 set 5%-"
    },

    "custom/idle-inhibitor": {
        "exec": "if pgrep -x hypridle > /dev/null; then echo '{\"text\": \"󰾪\", \"tooltip\": \"Stay awake: OFF\", \"class\": \"off\"}'; else echo '{\"text\": \"󰅶\", \"tooltip\": \"Stay awake: ON (idle + lid)\", \"class\": \"on\"}'; fi",
        "return-type": "json",
        "interval": 2,
        "on-click": "~/.local/bin/hypr-idle-toggle"
    },

    "custom/swaync": {
        "tooltip": true,
        "format": "{icon} {text}",
        "format-icons": {
            "notification": "󰂚",
            "none": "󰂚",
            "dnd-notification": "󰂛",
            "dnd-none": "󰂛",
            "inhibited-notification": "󰂚",
            "inhibited-none": "󰂚",
            "dnd-inhibited-notification": "󰂛",
            "dnd-inhibited-none": "󰂛"
        },
        "return-type": "json",
        "exec-if": "command -v swaync-client",
        "exec": "swaync-client -swb | jq --unbuffered -c '.text = (if .text == \"0\" then \"\" else .text end)'",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "~/.local/bin/hypr-dnd-toggle",
        "escape": true
    },

    "custom/reboot-needed": {
        "exec": "~/.config/waybar/scripts/reboot-needed.sh",
        "return-type": "json",
        "interval": 300,
        "on-click": "rofi -dmenu -p 'Reboot now?' -theme-str 'listview { lines: 2; }' <<< $'No\\nYes' | grep -q Yes && systemctl reboot"
    },

    "tray": {
        "icon-size": 18,
        "spacing": 8
    },

    "custom/scratchpad": {
        "exec": "hypr-special-waybar 'special:󰏫' '󰏫'",
        "return-type": "json",
        "interval": 5,
        "signal": 9,
        "on-click": "hyprctl dispatch togglespecialworkspace 󰏫; pkill -RTMIN+9 waybar; pkill -RTMIN+10 waybar"
    },

    "custom/tray": {
        "exec": "hypr-special-waybar 'special:󰘸' '󰘸'",
        "return-type": "json",
        "interval": 5,
        "signal": 10,
        "on-click": "hyprctl dispatch togglespecialworkspace 󰘸; pkill -RTMIN+9 waybar; pkill -RTMIN+10 waybar"
    },

    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "rofi -dmenu -p 'Power' -theme-str 'listview { lines: 5; }' <<< $'Lock\nLogout\nSuspend\nReboot\nShutdown' | xargs -I {} sh -c 'case \"{}\" in Lock) loginctl lock-session;; Logout) hyprctl dispatch exit;; Suspend) systemctl suspend;; Reboot) systemctl reboot;; Shutdown) systemctl poweroff;; esac'"
    }
}
