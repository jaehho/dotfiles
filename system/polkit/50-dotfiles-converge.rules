// Let wheel start the converge unit without a password, so `dotfiles sync` can
// run the system half on demand. Only start/restart, only this unit.
polkit.addRule(function (action, subject) {
  if (action.id == "org.freedesktop.systemd1.manage-units" &&
      action.lookup("unit") == "dotfiles-converge.service" &&
      (action.lookup("verb") == "start" || action.lookup("verb") == "restart") &&
      subject.isInGroup("wheel")) {
    return polkit.Result.YES;
  }
});
