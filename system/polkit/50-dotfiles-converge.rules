// Let the admin group start the converge unit without a password, so
// `dotfiles sync` can run the system half on demand. Only start/restart, only
// this unit. Arch's admin group is wheel; Ubuntu/Debian's is sudo.
polkit.addRule(function (action, subject) {
  if (action.id == "org.freedesktop.systemd1.manage-units" &&
      action.lookup("unit") == "dotfiles-converge.service" &&
      (action.lookup("verb") == "start" || action.lookup("verb") == "restart") &&
      (subject.isInGroup("wheel") || subject.isInGroup("sudo"))) {
    return polkit.Result.YES;
  }
});
