#%PAM-1.0
# shadow's /etc/pam.d/passwd plus pam_gnome_keyring, so `passwd` re-encrypts the
# login keyring with the new password. Without it the two drift apart and
# /etc/pam.d/login silently stops unlocking the keyring.
auth		include		system-auth
account		include		system-auth
password	include		system-auth
password	optional	pam_gnome_keyring.so
