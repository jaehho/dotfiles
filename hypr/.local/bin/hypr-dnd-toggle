#!/bin/bash
# Toggle Do Not Disturb via swaync.
# When turning DND on, notify first so the toast is visible before silencing.

state=$(swaync-client -D 2>/dev/null)

if [[ "$state" == "true" ]]; then
    swaync-client -df >/dev/null
    notify-send -u low "Notifications" "Do Not Disturb OFF"
else
    notify-send -u low "Notifications" "Do Not Disturb ON"
    sleep 1
    swaync-client -dn >/dev/null
fi
