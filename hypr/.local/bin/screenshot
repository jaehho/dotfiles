#!/usr/bin/env bash
# Capture screenshot via grim/slurp with notification feedback.
#
# Usage: screenshot <full|region|window|monitor> <copy|clip>
#
# Modes:
#   full     — all outputs
#   monitor  — focused output only
#   window   — active window (via hyprctl)
#   region   — interactive selection (via slurp)
#
# Actions:
#   copy     — save to $SCREENSHOT_DIR + clipboard + notification
#   clip     — clipboard only, no disk persistence
set -euo pipefail

dir=${SCREENSHOT_DIR:-$HOME/Pictures/screenshots}
mkdir -p "$dir"
file="$dir/$(date +%Y-%m-%d_%H-%M-%S-%3N).png"

mode=${1:?usage: screenshot <full|region|window|monitor> <copy|clip>}
action=${2:?usage: screenshot <full|region|window|monitor> <copy|clip>}

notify() {
    local title=$1 body=$2 icon=${3:-}
    if [ -n "$icon" ] && [ -f "$icon" ]; then
        notify-send -i "$icon" -t 2000 "$title" "$body"
    else
        notify-send -t 2000 "$title" "$body"
    fi
}

# notify-send with a default action that opens the file. -A implies
# --wait, so detach and let the helper outlive the script — clicking
# the notification fires xdg-open against $file.
notify_open() {
    local file=$1
    (
        action=$(notify-send -A "default=Open" -i "$file" -t 5000 \
            "Screenshot saved" "$(basename "$file")" 2>/dev/null) || true
        if [ "$action" = "default" ]; then
            xdg-open "$file" >/dev/null 2>&1 || true
        fi
    ) </dev/null >/dev/null 2>&1 &
    disown
}

tmp=$(mktemp --suffix=.png)
trap 'rm -f "$tmp"' EXIT

case "$mode" in
    full)
        grim "$tmp"
        ;;
    monitor)
        mon=$(hyprctl monitors -j | jq -r '.[] | select(.focused).name')
        grim -o "$mon" "$tmp"
        ;;
    window)
        geom=$(hyprctl activewindow -j 2>/dev/null \
            | jq -r 'select(.at) | "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"')
        if [ -z "$geom" ]; then
            notify "Screenshot" "No active window"
            exit 1
        fi
        grim -g "$geom" "$tmp"
        ;;
    region)
        geom=$(slurp 2>/dev/null) || exit 0  # user cancelled
        grim -g "$geom" "$tmp"
        ;;
    *) echo "unknown mode: $mode" >&2; exit 1 ;;
esac

case "$action" in
    copy)
        cp "$tmp" "$file"
        wl-copy --type image/png < "$file"
        notify_open "$file"
        ;;
    clip)
        wl-copy --type image/png < "$tmp"
        notify "Screenshot copied" "(clipboard only)"
        ;;
    *) echo "unknown action: $action" >&2; exit 1 ;;
esac
