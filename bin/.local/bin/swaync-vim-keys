#!/usr/bin/env bash
# Toggle a Hyprland submap while swaync's control-center panel is open,
# so j/k/g/G/x map to Down/Up/Home/End/Delete inside the panel.
# Daemon: started via exec-once from hyprland.conf.
set -euo pipefail

SOCKET="${XDG_RUNTIME_DIR:?}/hypr/${HYPRLAND_INSTANCE_SIGNATURE:?}/.socket2.sock"

state=closed
socat -u "UNIX-CONNECT:$SOCKET" - | while IFS= read -r event; do
  case "$event" in
    "openlayer>>swaync-control-center")
      # Multi-monitor: Hyprland emits one openlayer per output. Only act once
      # per panel-open so the submap dispatch isn't repeated needlessly.
      [[ $state == open ]] && continue
      state=open
      hyprctl dispatch submap swaync >/dev/null
      ;;
    "closelayer>>swaync-control-center")
      [[ $state == closed ]] && continue
      state=closed
      hyprctl dispatch submap reset >/dev/null
      ;;
  esac
done
