#!/usr/bin/env bash
# Move all windows from the active workspace to the target workspace, then switch to it.
target=$1
if [[ -z "$target" ]]; then
    echo "Usage: hypr-move-workspace-to <workspace_number>" >&2
    exit 1
fi

ws_id=$(hyprctl activeworkspace -j | jq .id)
hyprctl clients -j | \
    jq -r --argjson ws "$ws_id" '.[] | select(.workspace.id == $ws) | .address' | \
    while IFS= read -r addr; do
        # follow=false is the key that suppresses the focus jump; `silent` is accepted and ignored.
        hyprctl dispatch "hl.dsp.window.move({ workspace = $target, window = \"address:$addr\", follow = false })"
    done
hyprctl dispatch "hl.dsp.focus({ workspace = $target })"
