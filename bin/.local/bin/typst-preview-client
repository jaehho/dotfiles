#!/usr/bin/env bash
# typst-preview-client — sends a command to the local typst-preview-server
# through an SSH-forwarded unix socket. Run from the remote side (inside the
# ssh session) by nvim's <leader>tp. The local side must have an active
# RemoteForward to /tmp/typst-preview.sock (see ~/.ssh/config).
#
# Usage:
#   typst-preview-client open <host> <tag> <pdf-abs-path>
#   typst-preview-client stop <tag>
set -euo pipefail

sock=/tmp/typst-preview.sock
if [ ! -S "$sock" ]; then
  echo "typst-preview: $sock missing (RemoteForward not set up — see ~/.ssh/config)" >&2
  exit 1
fi

case "${1:-}" in
  open)
    [ $# -eq 4 ] || { echo "usage: typst-preview-client open <host> <tag> <path>" >&2; exit 2; }
    printf 'open\t%s\t%s\t%s\n' "$2" "$3" "$4" | socat - UNIX-CONNECT:"$sock"
    ;;
  stop)
    [ $# -eq 2 ] || { echo "usage: typst-preview-client stop <tag>" >&2; exit 2; }
    printf 'stop\t\t%s\t\n' "$2" | socat - UNIX-CONNECT:"$sock"
    ;;
  *)
    echo "usage: typst-preview-client {open|stop} ..." >&2
    exit 2
    ;;
esac
