#!/usr/bin/env bash
# typst-preview-client — sends a command to the local typst-preview-server
# through an SSH-forwarded TCP loopback port. Run from the remote side
# (inside the ssh session) by nvim's <leader>tp. The local side must have
# an active RemoteForward to 127.0.0.1:45876 (see ~/.ssh/config).
#
# Usage:
#   typst-preview-client open <host> <tag> <pdf-abs-path>
#   typst-preview-client stop <tag>
set -euo pipefail

port=45876
if ! (exec 3<>/dev/tcp/127.0.0.1/"$port") 2>/dev/null; then
  echo "typst-preview: 127.0.0.1:$port not reachable (RemoteForward not set up — see ~/.ssh/config)" >&2
  exit 1
fi
exec 3<&- 3>&-

case "${1:-}" in
  open)
    [ $# -eq 4 ] || { echo "usage: typst-preview-client open <host> <tag> <path>" >&2; exit 2; }
    printf 'open\t%s\t%s\t%s\n' "$2" "$3" "$4" | socat - TCP:127.0.0.1:"$port"
    ;;
  stop)
    [ $# -eq 2 ] || { echo "usage: typst-preview-client stop <tag>" >&2; exit 2; }
    printf 'stop\t\t%s\t\n' "$2" | socat - TCP:127.0.0.1:"$port"
    ;;
  *)
    echo "usage: typst-preview-client {open|stop} ..." >&2
    exit 2
    ;;
esac
