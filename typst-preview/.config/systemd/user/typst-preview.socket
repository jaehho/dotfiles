[Unit]
Description=Typst preview command socket
# Listens for "open"/"stop" commands from remote nvim sessions whose SSH
# RemoteForward terminates at this port. TCP loopback is used because
# Tailscale SSH (which intercepts ssh to mililab) doesn't support
# stream-local forwarding; see the mililab block in ~/.ssh/config.

[Socket]
ListenStream=127.0.0.1:45876
Accept=yes

[Install]
WantedBy=sockets.target
