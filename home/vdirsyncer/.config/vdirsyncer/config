# Nextcloud CalDAV/CardDAV → local vdirs for khal.
# Password is the same Nextcloud app password asst stores in the Secret
# Service (attributes application=dev.jaeho.Asst). Not in this file.

[general]
status_path = "~/.local/share/vdirsyncer/status/"

[pair nextcloud_calendar]
a = "nextcloud_calendar_local"
b = "nextcloud_calendar_remote"
# Only VEVENT collections. The rest are asst's VTODO lists — leave them.
collections = ["personal", "contact_birthdays"]
metadata = ["displayname", "color"]

[storage nextcloud_calendar_local]
type = "filesystem"
path = "~/.local/share/vdirsyncer/calendars/"
fileext = ".ics"

[storage nextcloud_calendar_remote]
type = "caldav"
url = "https://nextcloud.wonhomelab.net/remote.php/dav/calendars/jaeho/"
username = "jaeho"
password.fetch = ["command", "/home/jaeho/.local/bin/nextcloud-app-password"]

[pair nextcloud_contacts]
a = "nextcloud_contacts_local"
b = "nextcloud_contacts_remote"
# Skip z-app-generated--* and z-server-generated--* (Recent, Accounts).
collections = ["contacts"]
metadata = ["displayname"]

[storage nextcloud_contacts_local]
type = "filesystem"
path = "~/.local/share/vdirsyncer/contacts/"
fileext = ".vcf"

[storage nextcloud_contacts_remote]
type = "carddav"
url = "https://nextcloud.wonhomelab.net/remote.php/dav/addressbooks/users/jaeho/"
username = "jaeho"
password.fetch = ["command", "/home/jaeho/.local/bin/nextcloud-app-password"]

# Google Calendar (gmail + Research) via OAuth. VEVENT only — Google's CalDAV
# rejects VTODO. First `vdirsyncer sync` opens a browser; after that the timer
# refreshes the token. Collections are Google's UUIDs; run discover first.
# See google.env.example for the Cloud Console steps.

[pair google_calendar]
a = "google_calendar_local"
b = "google_calendar_remote"
collections = ["from b"]
metadata = ["displayname", "color"]

[storage google_calendar_local]
type = "filesystem"
path = "~/.local/share/vdirsyncer/google-calendars/"
fileext = ".ics"

[storage google_calendar_remote]
type = "google_calendar"
token_file = "~/.local/share/vdirsyncer/google-token"
client_id.fetch = ["command", "/home/jaeho/.local/bin/google-oauth-secret", "client_id"]
client_secret.fetch = ["command", "/home/jaeho/.local/bin/google-oauth-secret", "client_secret"]
