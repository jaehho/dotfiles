# Copy to ~/.config/vdirsyncer/google.env and fill in.
#
# Google Cloud Console → APIs & Services → Credentials:
#   1. New project (any name)
#   2. Enable the "CalDAV" API (not "Calendar API")
#   3. OAuth consent screen → External → fill required fields → publish
#   4. Credentials → Create Credentials → OAuth client ID → Desktop app
#   5. Copy Client ID and Client secret here
#
# Then run `vdirsyncer sync google_calendar/gmail` once in a terminal
# (opens a browser). After that the timer can refresh it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
