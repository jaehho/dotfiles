[user]
	email = jaeho2025@gmail.com
	name = Jaeho Cho
[init]
	defaultBranch = main
[credential "https://github.com"]
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = !/usr/bin/gh auth git-credential
[core]
	editor = nvim
	hooksPath = ~/.git-hooks
	# delta does intra-line word marks + bat syntax colors.
	# Fall back: git -c core.pager="diff-highlight | less" diff
	pager = delta
[interactive]
	# git add -p: word marks without the pager chrome
	diffFilter = delta --color-only
[sendemail]
	# Kernel patches: git send-email through Gmail. The password is a Gmail
	# app password, prompted for at send time and never stored.
	smtpServer = smtp.gmail.com
	smtpServerPort = 587
	smtpEncryption = tls
	smtpUser = jaeho2025@gmail.com
	confirm = always
[pull]
	rebase = false
[push]
	autoSetupRemote = true
[diff]
	colorMoved = default
# Fallback colors when delta is not the pager (git -c core.pager=..., --no-pager).
# Palette: catppuccin mocha, matching nvim diff_hl.lua / lazygit theme.
# Quote every style: unquoted # starts a gitconfig comment.
[color "diff"]
	meta = "#89b4fa"
	old = "#f38ba8"
	new = "#a6e3a1"
	frag = "#cba6f7 bold"
[color "diff-highlight"]
	oldNormal = "#f38ba8"
	oldHighlight = "bold #1e1e2e #f38ba8"
	newNormal = "#a6e3a1"
	newHighlight = "bold #1e1e2e #a6e3a1"
# Stock delta paint: whole +/- lines filled, words emphasized inside.
# Only theme + dark lock; style strings stay at delta defaults.
[delta]
	syntax-theme = Catppuccin Mocha
	dark = true
[alias]
	co = checkout
	br = branch
	ci = commit
	st = !git fetch --all && git status
	unstage = reset HEAD --
	lg = log --all --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(auto)%d%C(reset)'
	# Structural (AST) diff via difftastic. Default `git diff` stays on delta.
	# Opt out of external diff on a one-off: git --no-ext-diff ...
	difft = -c diff.external=difft diff
	showt = -c diff.external=difft show --ext-diff
	logt = -c diff.external=difft log --ext-diff
	# Delete local branches merged into <base> (default main). -d keeps
	# unmerged work; --no-contains skips a branch still at the base tip.
	prune-merged = "!f() { b=${1:-main}; git branch --merged \"$b\" --no-contains \"$b\" | grep -vE \"^[*+]|^[[:space:]]*$b$\" | xargs -r git branch -d; }; f"
[lfs]
	locksverify = false
