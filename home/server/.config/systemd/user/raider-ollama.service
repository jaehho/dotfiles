[Unit]
Description=Expose raider Ollama on 100.64.0.3:11434 (tailnet) with request logging
# wonlab → raider is key-based and LAN-fast. ollama-forward runs a localhost
# SSH tunnel plus ollama-log-proxy; the proxy binds only the tailnet address so
# the unauthenticated Ollama API is not on the public hairpin. Every request
# (minuet FIM, explain chat, curl) is appended to
# ~/.local/state/ollama/requests.jsonl.
# Linger must be on (loginctl enable-linger) or this dies at logout.
# Clients use end_point = http://100.64.0.3:11434/... unchanged.
Wants=network-online.target
After=network-online.target
# Disable systemd's default start-rate-limit (5 starts / 10s) so the
# Restart= backoff below is the only thing throttling restarts.
StartLimitIntervalSec=0

[Service]
ExecStart=%h/.local/bin/ollama-forward
Restart=on-failure
RestartSec=10
RestartSteps=10
RestartMaxDelaySec=60

[Install]
WantedBy=default.target
