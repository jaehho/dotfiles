[Unit]
Description=Expose raider Ollama on 100.64.0.3:11434 (tailnet) for FIM clients
# wonlab → raider is key-based and LAN-fast. Bind only the tailnet address so
# the unauthenticated Ollama API is not on the public hairpin.
# Linger must be on (loginctl enable-linger) or this dies at logout.
# Laptop minuet: end_point = http://100.64.0.3:11434/v1/completions
Wants=network-online.target
After=network-online.target
# Disable systemd's default start-rate-limit (5 starts / 10s) so the
# Restart= backoff below is the only thing throttling restarts.
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/ssh -N \
  -o BatchMode=yes \
  -o ExitOnForwardFailure=yes \
  -o ServerAliveInterval=15 \
  -o ServerAliveCountMax=3 \
  -o ConnectTimeout=10 \
  -L 100.64.0.3:11434:127.0.0.1:11434 raider
Restart=on-failure
RestartSec=10
RestartSteps=10
RestartMaxDelaySec=60

[Install]
WantedBy=default.target
