/* Official Catppuccin Mocha (catppuccin/rofi). Layout prefs (font, width,
   Papirus icons) stay on top of the stock theme. */

configuration {
  show-icons:          true;
  icon-theme:          "Papirus-Dark";
  drun-display-format: "{name}";
  drun-match-fields:   "name,generic,exec,keywords";
  matching:            "fuzzy";
  case-smart:          true;
  sort:                true;
  sorting-method:      "fzf";
  display-drun:        "";
  display-run:         "";
  display-window:      "";
  display-filebrowser: "";
}

@import "themes/catppuccin-mocha.rasi"
@import "catppuccin-default.rasi"

* {
  font: "JetBrainsMono Nerd Font 11";
}

window {
  width: 42em;
  border-radius: 12px;
}

inputbar {
  border-radius: 8px;
}

element {
  border-radius: 8px;
}
