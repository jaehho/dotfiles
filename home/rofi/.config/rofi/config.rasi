@import "~/.config/rofi/colors.rasi"

configuration {
  show-icons:          true;
  icon-theme:          "Papirus-Dark";
  drun-display-format: "{name}";
  drun-match-fields:   "name,generic,exec,keywords";
  matching:            "fuzzy";
  case-smart:          true;
  sort:                true;
  sorting-method:      "fzf";
  display-drun:        "";
  display-run:         "";
  display-window:      "";
  display-filebrowser: "";
}

* {
  selected-active-foreground:  @background;
  lightfg:                     @text;
  separatorcolor:              @surface1;
  urgent-foreground:           @red;
  alternate-urgent-background: @lightbg;
  lightbg:                     @mantle;
  background-color:            transparent;
  border-color:                @surface2;
  normal-background:           transparent;
  selected-active-background:  @blue;
  alternate-active-background: @lightbg;
  spacing:                     2;
  alternate-normal-foreground: @foreground;
  urgent-background:           @background;
  selected-normal-foreground:  @base;
  active-foreground:           @blue;
  background:                  @base;
  active-background:           transparent;
  selected-normal-background:  @blue;
  alternate-normal-background: transparent;
  foreground:                  @text;
  selected-urgent-background:  @red;
  selected-urgent-foreground:  @base;
  normal-foreground:           @foreground;
  alternate-urgent-foreground: @red;
  alternate-active-foreground: @blue;

  font:                        "JetBrainsMono Nerd Font 11";
}

window {
    width:            42em;
    padding:          0;
    border:           2px;
    border-radius:    14px;
    border-color:     @surface2;
    background-color: @base-blur;
}
mainbox {
    padding:          12px;
    spacing:          10px;
    border:           0;
    background-color: transparent;
}
inputbar {
    padding:          10px 14px;
    spacing:          10px;
    border-radius:    10px;
    background-color: @surface0-blur;
    text-color:       @text;
    children:         [ "prompt", "entry", "num-filtered-rows", "textbox-num-sep", "num-rows" ];
}
prompt {
    text-color: @blue;
    spacing:    0;
}
entry {
    text-color:        @text;
    cursor:            text;
    spacing:           0;
    placeholder:       "Search applications";
    placeholder-color: @overlay0;
}
listview {
    lines:            10;
    columns:          1;
    padding:          0;
    spacing:          4px;
    scrollbar:        true;
    fixed-height:     false;
    border:           0;
    background-color: transparent;
}
scrollbar {
    width:        4px;
    padding:      0;
    handle-width: 4px;
    border:       0;
    handle-color: @surface2;
}
element {
    padding:       8px 12px;
    spacing:       12px;
    border:        0;
    border-radius: 10px;
    cursor:        pointer;
}
element normal.normal {
    background-color: transparent;
    text-color:       @text;
}
element normal.urgent {
    background-color: @urgent-background;
    text-color:       @urgent-foreground;
}
element normal.active {
    background-color: @surface0;
    text-color:       @active-foreground;
}
element selected.normal {
    background-color: @blue;
    text-color:       @base;
}
element selected.urgent {
    background-color: @selected-urgent-background;
    text-color:       @selected-urgent-foreground;
}
element selected.active {
    background-color: @blue;
    text-color:       @base;
}
element alternate.normal {
    background-color: transparent;
    text-color:       @text;
}
element alternate.urgent {
    background-color: @alternate-urgent-background;
    text-color:       @alternate-urgent-foreground;
}
element alternate.active {
    background-color: @surface0;
    text-color:       @alternate-active-foreground;
}
element-icon {
    size:             1.7em;
    vertical-align:   0.5;
    background-color: transparent;
    cursor:           inherit;
    text-color:       inherit;
}
element-text {
    vertical-align:   0.5;
    background-color: transparent;
    cursor:           inherit;
    highlight:        inherit;
    text-color:       inherit;
}
message {
    padding:          8px 12px;
    border-radius:    10px;
    border:           0;
    background-color: @surface0;
}
textbox {
    text-color: @text;
}
num-filtered-rows {
    expand:     false;
    text-color: @overlay0;
}
num-rows {
    expand:     false;
    text-color: @overlay0;
}
textbox-num-sep {
    expand:     false;
    str:        "/";
    text-color: @overlay0;
}
button {
    cursor:     pointer;
    spacing:    0;
    text-color: @normal-foreground;
}
button selected {
    background-color: @selected-normal-background;
    text-color:       @selected-normal-foreground;
}

/* colors imported from colors.rasi — generated by theme-apply */
