/* Stock rofi colors (theme-apply retired, issue #38). */
* {
  /* named colors referenced as @name below */
  background: #232323;
  foreground: #e8e8e8;
  base: #232323;
  text: #e8e8e8;
  lightfg: #e8e8e8;
  lightbg: #1a1a1a;
  mantle: #1a1a1a;
  surface0: #2a2a2a;
  surface1: #3c3c3c;
  surface2: #555555;
  overlay0: #777777;
  blue: #268bd2;
  red: #d54e53;
  base-blur: #232323d9;
  surface0-blur: #2a2a2ae6;

  background-color: transparent;
  border-color: #3c3c3c;
  separatorcolor: #3c3c3c;

  normal-background: transparent;
  normal-foreground: #e8e8e8;
  alternate-normal-background: transparent;
  alternate-normal-foreground: #e8e8e8;

  selected-normal-background: #268bd2;
  selected-normal-foreground: #232323;
  selected-active-background: #268bd2;
  selected-active-foreground: #232323;

  active-background: transparent;
  active-foreground: #268bd2;
  alternate-active-background: #1a1a1a;
  alternate-active-foreground: #268bd2;

  urgent-background: #232323;
  urgent-foreground: #d54e53;
  alternate-urgent-background: #1a1a1a;
  alternate-urgent-foreground: #d54e53;
  selected-urgent-background: #d54e53;
  selected-urgent-foreground: #232323;
}

configuration {
  show-icons:          true;
  icon-theme:          "Papirus-Dark";
  drun-display-format: "{name}";
  drun-match-fields:   "name,generic,exec,keywords";
  matching:            "fuzzy";
  case-smart:          true;
  sort:                true;
  sorting-method:      "fzf";
  display-drun:        "";
  display-run:         "";
  display-window:      "";
  display-filebrowser: "";
}

* {
  spacing:                     2;
  font:                        "JetBrainsMono Nerd Font 11";
}

window {
    width:            42em;
    padding:          0;
    border:           2px;
    border-radius:    14px;
    border-color:     @surface2;
    background-color: @base-blur;
}
mainbox {
    padding:          12px;
    spacing:          10px;
    border:           0;
    background-color: transparent;
}
inputbar {
    padding:          10px 14px;
    spacing:          10px;
    border-radius:    10px;
    background-color: @surface0-blur;
    text-color:       @text;
    children:         [ "prompt", "entry", "num-filtered-rows", "textbox-num-sep", "num-rows" ];
}
prompt {
    text-color: @blue;
    spacing:    0;
}
entry {
    text-color:        @text;
    cursor:            text;
    spacing:           0;
    placeholder:       "Search applications";
    placeholder-color: @overlay0;
}
listview {
    lines:            10;
    columns:          1;
    padding:          0;
    spacing:          4px;
    scrollbar:        true;
    fixed-height:     false;
    border:           0;
    background-color: transparent;
}
scrollbar {
    width:        4px;
    padding:      0;
    handle-width: 4px;
    border:       0;
    handle-color: @surface2;
}
element {
    padding:       8px 12px;
    spacing:       12px;
    border:        0;
    border-radius: 10px;
    cursor:        pointer;
}
element normal.normal {
    background-color: transparent;
    text-color:       @text;
}
element normal.urgent {
    background-color: @urgent-background;
    text-color:       @urgent-foreground;
}
element normal.active {
    background-color: @surface0;
    text-color:       @active-foreground;
}
element selected.normal {
    background-color: @blue;
    text-color:       @base;
}
element selected.urgent {
    background-color: @selected-urgent-background;
    text-color:       @selected-urgent-foreground;
}
element selected.active {
    background-color: @blue;
    text-color:       @base;
}
element alternate.normal {
    background-color: transparent;
    text-color:       @text;
}
element alternate.urgent {
    background-color: @alternate-urgent-background;
    text-color:       @alternate-urgent-foreground;
}
element alternate.active {
    background-color: @surface0;
    text-color:       @alternate-active-foreground;
}
element-icon {
    size:             1.7em;
    vertical-align:   0.5;
    background-color: transparent;
    cursor:           inherit;
    text-color:       inherit;
}
element-text {
    vertical-align:   0.5;
    background-color: transparent;
    cursor:           inherit;
    highlight:        inherit;
    text-color:       inherit;
}
message {
    padding:          8px 12px;
    border-radius:    10px;
    border:           0;
    background-color: @surface0;
}
textbox {
    text-color: @text;
}
num-filtered-rows {
    expand:     false;
    text-color: @overlay0;
}
num-rows {
    expand:     false;
    text-color: @overlay0;
}
textbox-num-sep {
    expand:     false;
    str:        "/";
    text-color: @overlay0;
}
button {
    cursor:     pointer;
    spacing:    0;
    text-color: @normal-foreground;
}
button selected {
    background-color: @selected-normal-background;
    text-color:       @selected-normal-foreground;
}

