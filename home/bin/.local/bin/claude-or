#!/bin/bash
# Claude Code on open models. Prefers the z.ai GLM Coding Plan
# (~/.config/zai.env: ZAI_API_KEY), falls back to OpenRouter
# (~/.config/openrouter.env). On OpenRouter, effort and provider routing live
# in the presets (@preset/cc-*, openrouter.ai/settings/presets): Claude Code
# always sends effort=high, and a preset's config overrides it. z.ai has no
# presets, so everything there runs at the effort Claude Code sends (high).
# Override the model per session with --model. --local (any position) runs
# on Ollama instead.
export PATH="$HOME/.local/bin:$PATH"   # claude's native install; bare units lack it
command -v claude >/dev/null || { echo 'claude-or: claude not on PATH' >&2; exit 1; }
# Extract --local wherever it sits; pass everything else through verbatim.
local_mode=0
pass=()
for a in "$@"; do
    if [ "$a" = "--local" ]; then local_mode=1; else pass+=("$a"); fi
done
zai_file="${ZAI_ENV:-$HOME/.config/zai.env}"
zai_key=$(sed -n 's/^ZAI_API_KEY=//p' "$zai_file" 2>/dev/null | head -n1)
env_file="${OPENROUTER_ENV:-$HOME/.config/openrouter.env}"
key=$(sed -n 's/^OPENROUTER_API_KEY=//p' "$env_file" 2>/dev/null | head -n1)
if [ "$local_mode" -eq 1 ]; then
    # Ollama (>=0.14) serves the Anthropic Messages API natively on :11434.
    # Local Ollama. ornith:9b-49k (created via `ollama create`, num_ctx
    # 49152) is the default: agentic-coding model, and at 49152 the
    # allocator spills ~23% to CPU instead of clamping context — ollama's
    # 4096 default and any ctx below the ~34k prompt floor silently
    # truncate Claude Code's system prompt + tool schemas to garbage.
    # Needs the q4_0 KV cache on the ollama service (drop-in at
    # /etc/systemd/system/ollama.service.d/kv-quant.conf). Local models
    # are also reachable by name mid-session via the claude-or-fallback
    # proxy (/model ornith:9b-49k). CLAUDE_CODE_MAX_CONTEXT_TOKENS must
    # match num_ctx. Override with CLAUDE_OR_LOCAL_MODEL.
    lm="${CLAUDE_OR_LOCAL_MODEL:-ornith:9b-49k}"
    base_url=http://127.0.0.1:11434
    token=ollama
    ctx="${CLAUDE_OR_LOCAL_CTX:-49152}"
    export CLAUDE_CODE_MAX_CONTEXT_TOKENS="$ctx"
    fable="$lm" opus="$lm" sonnet="$lm" haiku="$lm"
elif [ -n "$zai_key" ]; then
    # GLM Coding Plan (docs.z.ai/devpack/tool/claude): opus/fable ->
    # glm-5.3, sonnet/haiku -> glm-5.3-flash, 1M context suffix.
    base_url=https://api.z.ai/api/anthropic
    token=$zai_key
    fable='glm-5.3[1m]' opus='glm-5.3[1m]' sonnet='glm-5.3-flash[1m]' haiku='glm-5.3-flash[1m]'
    if [ -n "$key" ] && [ -z "$CLAUDE_OR_NO_FALLBACK" ]; then
        # Runtime failover: route through claude-or-fallback on :8927, which
        # retries quota/auth failures against OpenRouter (model mapped to a
        # @preset). CLAUDE_OR_NO_FALLBACK=1 keeps the hard quota stop.
        if ! curl -sf -o /dev/null http://127.0.0.1:8927/healthz; then
            mkdir -p "$HOME/.local/state/claude-or"
            CLAUDE_OR_PRIMARY_KEY="$zai_key" CLAUDE_OR_FALLBACK_KEY="$key" \
                setsid claude-or-fallback serve >>"$HOME/.local/state/claude-or/proxy.log" 2>&1 &
            i=0
            while [ "$i" -lt 20 ] && ! curl -sf -o /dev/null http://127.0.0.1:8927/healthz; do
                sleep 0.1; i=$((i+1))
            done
        fi
        base_url=http://127.0.0.1:8927
    fi
elif [ -n "$key" ]; then
    echo "claude-or: no ZAI_API_KEY in $zai_file, using OpenRouter" >&2
    base_url=https://openrouter.ai/api
    token=$key
    fable='@preset/cc-astra-low[1m]' opus='@preset/cc-flash-high[1m]' sonnet='@preset/cc-flash-med[1m]' haiku='@preset/cc-glm-flash-low[1m]'
else
    echo "claude-or: no ZAI_API_KEY in $zai_file and no OPENROUTER_API_KEY in $env_file" >&2
    exit 1
fi
# Full system-prompt replacement from claude-or-system-prompt.md next to this
# script; __CC_MEMORY_DIR__ in it is filled with this project's memory dir.
# claude-or-settings.json (~/.claude, stow symlink) holds session-scoped
# settings (currently the local-model modelPicker rows) so plain/login
# claude never sees them.
sp_dir=$(dirname "$(readlink -f "$0")")
if [ -f "$sp_dir/claude-or-system-prompt.md" ]; then
    mem="$HOME/.claude/projects/$(printf '%s' "$PWD" | sed 's|/|-|g')"
    pass=("--system-prompt" "$(sed "s|__CC_MEMORY_DIR__|$mem|" "$sp_dir/claude-or-system-prompt.md")" "${pass[@]}")
fi
if [ -f "$HOME/.claude/claude-or-settings.json" ]; then
    pass=("--settings" "$HOME/.claude/claude-or-settings.json" "${pass[@]}")
fi
ANTHROPIC_BASE_URL="$base_url" \
ANTHROPIC_AUTH_TOKEN="$token" \
ANTHROPIC_API_KEY= \
API_TIMEOUT_MS=3000000 \
ANTHROPIC_DEFAULT_FABLE_MODEL="$fable" \
ANTHROPIC_DEFAULT_OPUS_MODEL="$opus" \
ANTHROPIC_DEFAULT_SONNET_MODEL="$sonnet" \
ANTHROPIC_DEFAULT_HAIKU_MODEL="$haiku" \
ANTHROPIC_MODEL=sonnet \
exec claude "${pass[@]}"
