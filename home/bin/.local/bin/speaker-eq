  background: #{mantle}; border: 1px solid #{surface0};
  border-radius: 12px; padding: 12px;
}}
.heading {{ font-size: 11px; font-weight: 700; color: #{overlay0}; }}
.dim {{ color: #{overlay1}; font-size: 12px; }}
