#!/usr/bin/env python3
"""speaker-eq -- tune the speaker EQ by ear, on the live speaker sink.

speaker-measure measures the speakers and fits a correction, but a fit is only
as right as the mic behind it, and two honest mics can disagree by as much as
the defects being corrected. This window settles it by ear: it plots the EQ
over the saved measurements and moves its bands on the live speaker sink while
music plays. It compares against the saved EQ or against no EQ at matched
loudness, because a cut-only EQ always plays quieter and quieter always sounds
worse. Save keeps the result as a run of its own and applies it the way
`speaker-measure --apply` does.

How the EQ is built into the sink and applied lives in speaker-measure, which
this loads as a module; nothing here writes PipeWire config of its own.
"""

import contextlib
import importlib.machinery
import importlib.util
import io
import json
import math
import os
import signal
import sys
import threading
import time
from datetime import datetime
from pathlib import Path

import cairo
import gi
import numpy as np

gi.require_version("Gdk", "4.0")
gi.require_version("Gtk", "4.0")
gi.require_version("Pango", "1.0")
gi.require_version("PangoCairo", "1.0")
from gi.repository import Gdk, Gio, GLib, Gtk, Pango, PangoCairo


def load_speaker_measure():
    """speaker-measure is a script rather than a package, so load it by path."""
    path = Path(__file__).resolve().parent / "speaker-measure"
    loader = importlib.machinery.SourceFileLoader("speaker_measure", str(path))
    module = importlib.util.module_from_spec(
        importlib.util.spec_from_loader(loader.name, loader))
    loader.exec_module(module)
    return module


sm = load_speaker_measure()

APP_ID = "dev.jaeho.speakereq"
MAX_BANDS = 12  # keeps the graph well inside the 4096-byte live param
FREQ, GAIN, Q = (20.0, 20000.0), (-24.0, 12.0), (0.1, 10.0)
KINDS = ("PK", "LSC", "HSC")
KIND_LABEL = {"PK": "Bell", "LSC": "Low shelf", "HSC": "High shelf"}
GRID = np.geomspace(*FREQ, 480)
Z1 = np.exp(-1j * 2 * np.pi * GRID / sm.FS)
PALETTE = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "theme/palette"


# --- the EQ ---------------------------------------------------------------
def band_db(band, grid=GRID, z1=Z1):
    kind, fc, gain, q = band
    return sm.biquad_db(grid, kind, fc, gain, q, z1=z1)


def natural_preamp(filters):
    """The preamp an EQ is saved with. No EQ plays untouched."""
    return sm.eq_preamp(GRID, filters) if filters else 0.0


def level(filters, band):
    """An EQ's average power gain over `band` in dB, its preamp included."""
    if not filters:
        return 0.0
    sel = (GRID >= band[0]) & (GRID <= band[1])
    db = sm.total_db(GRID, filters, z1=Z1)[sel] + natural_preamp(filters)
    return 10 * math.log10(float(np.mean(10 ** (db / 10))))


def sink_db_now(device):
    """The sink's volume in dB, or None. Unlike speaker-measure's pactl_json,
    it never exits the process."""
    try:
        sinks = json.loads(sm.run(["pactl", "-f", "json", "list", "sinks"]).stdout)
    except ValueError:
        return None
    sink = next((s for s in sinks if s.get("name") == device), None)
    return sm.sink_level(sink)[0] if sink else None


class Run:
    """A saved run: a fit from a measurement, or a tuning saved from here."""

    def __init__(self, path):
        self.name = path.name
        self.meta = json.loads((path / "meta.json").read_text())
        self.measured = (path / "response.csv").exists()
        self.filters = [(f["type"], float(f["hz"]), float(f["db"]), float(f["q"]))
                        for f in self.meta.get("filters", [])]
        band = self.meta.get("band")
        self.band = (float(band[0]), float(band[1])) if band else None

    def label(self):
        try:
            when = time.strftime("%b %-d, %H:%M", time.strptime(self.name[:15], "%Y%m%dT%H%M%S"))
        except ValueError:
            when = self.name
        source = str(self.meta.get("source", ""))
        how = ("tuned by ear" if "tuned_from" in self.meta
               else "phone recording" if source.startswith("external recording")
               else "built-in mic" if "__Mic1__" in source else "measured")
        n = len(self.filters)
        return f"{when} · {how} · {n} band{'s' * (n != 1)}"

    def response(self):
        data = np.loadtxt(sm.STATE / self.name / "response.csv", delimiter=",", skiprows=1)
        return data[:, 0], data[:, 1], data[:, 2]


def saved_runs():
    """Every run with readable metadata, newest first."""
    runs = []
    for meta in sorted(sm.STATE.glob("*/meta.json"), reverse=True):
        with contextlib.suppress(OSError, ValueError, KeyError, TypeError):
            runs.append(Run(meta.parent))
    return runs


def applied_run(runs):
    with contextlib.suppress(OSError, ValueError):
        name = json.loads(sm.APPLIED.read_text()).get("run")
        return next((r for r in runs if r.name == name), None)
    return None


def measured_origin(run, runs):
    """The measured run a tuning descends from, following tuned_from."""
    by_name, seen = {r.name: r for r in runs}, set()
    while run is not None and not run.measured and run.name not in seen:
        seen.add(run.name)
        run = by_name.get(run.meta.get("tuned_from"))
    return run


def save_tuned(filters, band, source, run_name=None):
    """Keep a tuning as a run of its own and make it the applied EQ.

    Saving again from the same window rewrites that run rather than piling up
    another. Returns (run name, speaker-measure's report, its warnings).
    """
    filters = sorted(filters, key=lambda f: f[1])
    preamp = natural_preamp(filters)
    now = datetime.now().astimezone()
    run_dir = sm.STATE / (run_name or now.strftime("%Y%m%dT%H%M%S"))
    if source == run_dir.name:  # reloaded this very run, so keep where it came from
        with contextlib.suppress(OSError, ValueError):
            source = json.loads((run_dir / "meta.json").read_text()).get("tuned_from")
    out, err = io.StringIO(), io.StringIO()
    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
        speaker = sm.speaker_output()
        device = speaker["device"] if speaker else None
        db = sink_db_now(device) if device else None
        run_dir.mkdir(parents=True, exist_ok=True)
        sm.write_apo(run_dir / "eq.txt", filters, preamp, [
            f"speaker-eq {now:%Y-%m-%d %H:%M}",
            f"sink {device}" + (f" at {db:+.1f} dB" if db is not None else ""),
            f"tuned by ear from {source or 'flat'}",
        ])
        # Shaped like a measured run's, so speaker-measure --verify and the
        # Load menu here both read it.
        (run_dir / "meta.json").write_text(json.dumps({
            "when": now.isoformat(timespec="seconds"),
            "sink": device, "sink_db": db, "tuned_from": source,
            "band": list(band) if band else None,
            "filters": [{"type": k, "hz": fc, "db": g, "q": q} for k, fc, g, q in filters],
            "preamp_db": preamp,
        }, indent=2) + "\n")
        sm.eq_apply(filters, preamp, run_dir.name)
    return run_dir.name, out.getvalue(), err.getvalue()


# --- PipeWire, off the GTK thread ------------------------------------------
class Link:
    """Everything that talks to PipeWire, on a thread of its own.

    A pw-cli call takes about 10 ms and a pw-dump about 20, a visible stutter
    at every step of a drag if the window waited on them. The window only says
    what should be playing; this sends the latest of it, and follows the
    speaker sink when it goes away or is rebuilt.

    Moving a band changes only control values, which PipeWire applies on its
    next cycle. Adding, removing or retyping one changes the graph's nodes, so
    the whole graph is loaded again, with the current values in it. Controls
    sent while the sink is suspended are kept and applied when it next starts,
    so only a rebuilt sink needs anything sent again.
    """

    POLL = 1.0

    def __init__(self, device, on_status):
        self.device, self.on_status = device, on_status
        self.lock, self.wake = threading.Lock(), threading.Event()
        self.want = self.sent = self.kinds = None
        self.node = self.state = None
        self.jobs, self.stopping, self.closed = [], False, False
        self.thread = threading.Thread(target=self.loop, daemon=True)
        self.thread.start()

    def play(self, filters, preamp):
        with self.lock:
            self.want = (list(filters), preamp)
        self.wake.set()

    def call(self, job, done):
        """job() here, in turn with what is sent to PipeWire; done(result) on
        the GTK thread, with the exception as the result if it raised."""
        with self.lock:
            self.jobs.append((job, done))
        self.wake.set()

    def loop(self):
        polled = 0.0
        while not self.stopping:
            self.wake.wait(self.POLL)
            self.wake.clear()
            if time.monotonic() - polled >= self.POLL:
                self.poll()
                polled = time.monotonic()
            self.send()
            while True:
                with self.lock:
                    if not self.jobs:
                        break
                    job, done = self.jobs.pop(0)
                try:
                    result = job()
                # Any failure is the job's result, so the thread outlives it;
                # speaker-measure's die() raises SystemExit.
                except (Exception, SystemExit) as e:  # noqa: BLE001
                    result = e
                GLib.idle_add(done, result)
                polled = 0.0  # a save restarts wireplumber, which rebuilds the sink

    def find(self):
        for n in sm.pw_nodes():
            if n["info"]["props"].get("node.name") == self.device:
                return n["id"], n["info"].get("state")
        return None, None

    def poll(self):
        node, self.state = self.find()
        if node != self.node:
            # New, gone, or rebuilt from the rule: whatever graph it has is not ours.
            self.kinds = self.sent = None
        self.node = node
        volume = sink_db_now(self.device) if node is not None else None
        GLib.idle_add(self.on_status, node is not None, self.state, volume)

    def send(self):
        with self.lock:
            want = self.want
        if want is None or self.node is None or want == self.sent:
            return
        filters, preamp = want
        kinds = [f[0] for f in filters]
        if kinds != self.kinds:
            # A node id is reused once its node is gone, and a whole graph
            # must not land on whatever took the id over.
            if self.find()[0] != self.node:
                self.node = self.kinds = self.sent = None
                return
            sm.engage_eq(self.node, sm.eq_graph(filters, preamp), True)
            self.kinds = kinds
        else:
            sm.run(["pw-cli", "set-param", str(self.node), "Props",
                    sm.eq_controls(filters, preamp)])
        self.sent = want

    def close(self, engaged, saved):
        """Stop, then leave the sink as its rule built it: `saved` is what that
        plays, and `engaged` whether quick settings had the EQ on."""
        self.stopping = True
        self.wake.set()
        self.thread.join(timeout=20)
        self.closed = True
        if engaged and self.kinds is not None and self.sent == saved:
            return
        node, graph = sm.speaker_eq(self.device)
        if node is not None:
            sm.engage_eq(node, graph, engaged)
        elif self.node is not None and self.kinds is not None:
            # No rule behind the sink: take out the graph loaded from here.
            sm.run(["pw-cli", "set-param", str(self.node), "Props",
                    f'{{ params = [ "{sm.EQ_PARAM}" "" ] }}'])


# --- drawing ----------------------------------------------------------------
FALLBACK = {
    "base": "141c1e", "mantle": "101719", "crust": "0c1315", "text": "cfdadc",
    "subtext0": "9da7a9", "subtext1": "b6c0c2", "surface0": "20282a",
    "surface1": "2f3739", "surface2": "41494c", "overlay0": "778184",
    "overlay1": "858f92", "blue": "609fd2", "sapphire": "3daab0",
    "green": "70a971", "peach": "ca865e", "yellow": "b0954a", "red": "cf7f79",
}


def palette():
    """The desktop theme's colors, as theme-apply writes them."""
    colors = dict(FALLBACK)
    with contextlib.suppress(OSError):
        for line in PALETTE.read_text().splitlines():
            key, sep, val = line.strip().partition("=")
            if sep and not key.startswith("#"):
                colors[key.strip()] = val.strip()
    return colors


def rgb(hex_color):
    return tuple(int(hex_color[i:i + 2], 16) / 255 for i in (0, 2, 4))


