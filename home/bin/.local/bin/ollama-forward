#!/usr/bin/env bash
# ollama-forward: SSH tunnel to raider plus a logging reverse proxy on the tailnet.
#
# raider-ollama.service runs this instead of a bare `ssh -N -L`. Clients keep
# the same URL (http://100.64.0.3:11434); every request is recorded in
# ~/.local/state/ollama/requests.jsonl by ollama-log-proxy.
#
# Tunnel stays localhost-only so the unauthenticated Ollama API is not on the
# public hairpin. The proxy binds the tailnet address and forwards there.
set -euo pipefail

TUNNEL_PORT="${OLLAMA_TUNNEL_PORT:-11435}"
LISTEN="${OLLAMA_LISTEN:-100.64.0.3:11434}"
UPSTREAM="http://127.0.0.1:${TUNNEL_PORT}"

ssh -N \
  -o BatchMode=yes \
  -o ExitOnForwardFailure=yes \
  -o ServerAliveInterval=15 \
  -o ServerAliveCountMax=3 \
  -o ConnectTimeout=10 \
  -L "127.0.0.1:${TUNNEL_PORT}:127.0.0.1:11434" \
  raider &
SSH_PID=$!

cleanup() {
  kill "$SSH_PID" 2>/dev/null || true
  wait "$SSH_PID" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

# No exec: the EXIT trap must run so the tunnel dies with the proxy.
ollama-log-proxy --listen "$LISTEN" --upstream "$UPSTREAM"
