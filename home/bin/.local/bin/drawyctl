OWNED_PROPERTIES = {
    **dict.fromkeys(SHAPE_TYPES, (*FILL, *STROKE)),
    "LINE": STROKE,
    "ARROW": (*HEADS, *STROKE),
    "FREEFORM": STROKE,
    "TEXT": ("FontSize", "Opacity", "StrokeColor"),
    "IMAGE": ("Opacity",),
    "GROUP": (),
}
# Enum order, the order Drawy writes them in (properties/property.hpp).
PROPERTY_ORDER = (*HEADS, *FILL, "FontSize", *STROKE)
INT_RANGES = {"FontSize": (1, None), "Opacity": (0, 255)}
INT_RANGES["StrokeWidth"] = (0, None)
