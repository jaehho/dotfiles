BUILD_EXTRA = "// build-extra: "

ZSTD_MAGIC = b"\x28\xb5\x2f\xfd"
ZSTD_LEVEL = 4  # common/utils/compression.cpp:17
PNG_SIGNATURE = b"\x89PNG\r\n\x1a\n"
CANVAS_COLORS = {"light": "#f8f9fa", "dark": "#121212"}
ZOOM_MIN, ZOOM_MAX = 0.1, 30.0  # common/constants.hpp:48-49
PASTE_BOX = 250.0  # mime/imagemimehandler.cpp:44-55
MAX_COORDINATE = 1e9  # beyond any real board; Drawy keeps such items
