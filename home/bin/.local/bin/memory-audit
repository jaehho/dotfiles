#!/usr/bin/env python3
# Weekly cleanup of Claude Code memory notes by two independent agents,
# for every project memory directory under ~/.claude/projects.
#
#   memory-audit run [--dir DIR]   snapshot, scan, run both agents per
#                                  project, reconcile; notifies when done
#   memory-audit summary [RUN]     the short plain-text summary
#   memory-audit review [RUN]      TUI: pick changes, apply them
#   memory-audit apply [RUN] [--dir NAME] [--yes] [--only p1,p3 | --all]
#                                  dry run by default; RUN is a run
#                                  directory or "latest"
#   memory-audit scan [--dir DIR]  print the mechanical findings only
#   memory-audit selftest          check reconcile, apply, summary and
#                                  the notification click path
#
# Agent A gets the scan findings and only judges those. Agent B never
# sees them and reads every note cold. Each works in its own copy of the
# notes, has no write tools, and returns proposals as structured output.
# The reconcile step is plain code: identical proposals are merged,
# proposals that touch the same note differently become conflicts, and
# nothing is applied without `apply --yes`, which refuses any note that
# changed since the snapshot. Replaced files go to RUN/backup.
import argparse
import contextlib
import curses
import datetime as dt
import difflib
import fcntl
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import textwrap
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

HOME = Path.home()
PROJECTS = HOME / ".claude/projects"
STATE = (
    Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state"))
    / "memory-audit"
)
INDEX = "MEMORY.md"
LONG_NOTE = 3500
DUP_RATIO = 0.45
OLD_PROJECT_DAYS = 45

SCHEMA = {
    "type": "object",
    "required": ["notes_read", "proposals"],
    "properties": {
        "notes_read": {"type": "array", "items": {"type": "string"}},
        "dismissed": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["finding", "why"],
                "properties": {
                    "finding": {"type": "string"},
                    "why": {"type": "string"},
                },
            },
        },
        "proposals": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "file", "action", "summary", "reason", "evidence",
                ],
                "properties": {
                    "summary": {"type": "string"},
                    "file": {"type": "string"},
                    "action": {"enum": ["delete", "rewrite", "merge"]},
                    "into": {"type": "string"},
                    "new_content": {"type": "string"},
                    "index_line": {"type": "string"},
                    "reason": {"type": "string"},
                    "evidence": {"type": "string"},
                },
            },
        },
    },
}

READ_ONLY_TOOLS = [
    "Read", "Grep", "Glob",
    "Bash(ls:*)", "Bash(cd:*)", "Bash(cat:*)", "Bash(head:*)",
    "Bash(tail:*)", "Bash(wc:*)", "Bash(stat:*)", "Bash(test:*)",
    "Bash(rg:*)", "Bash(grep:*)", "Bash(command -v:*)",
    "Bash(git log:*)", "Bash(git show:*)", "Bash(git status:*)",
    "Bash(git diff:*)", "Bash(which:*)", "Bash(gh issue list:*)",
    "Bash(gh issue view:*)", "Bash(systemctl --user is-active:*)",
    "Bash(systemctl --user status:*)",
]

RULES = """\
These are Claude Code auto-memory notes for one user. Each note is one
file with frontmatter (name, description, metadata.type = user |
feedback | project | reference). feedback and project notes keep a
Why: and How to apply: line. MEMORY.md is the index, one line per note;
never propose editing it directly, give an index_line instead (the full
replacement line: `- [Title](file.md) — hook`).

A note should be removed or changed only on evidence you gathered in
this run: a path, command, service, branch or date you checked, or a
newer note that contradicts it. Notes about how the user wants Claude to
work (feedback) are rules, not facts about the world: leave them unless
the evidence shows they were superseded. When unsure, make no proposal;
a missed cleanup costs a week, a wrong deletion costs a lesson.

Actions:
- delete: the note is obsolete or fully covered elsewhere.
- rewrite: same note, new full text in new_content (frontmatter
  included), for stale facts or to make it shorter without dropping a
  Why or How to apply. Add index_line if the hook line changes.
- merge: fold file into `into`; new_content is the full new text of
  `into`; file is deleted.
Each proposal needs summary (one plain line, at most 60 characters,
saying what changes and why, for a quick skim), reason and evidence
(what you ran or read). Propose
at most one action per note. Reads only: you have no way to edit. Read
notes with the Read tool, one call per file (shell loops are refused),
and list every note you read in notes_read.
Today is {today}.
"""

PROMPT_A = RULES + """
You are the mechanical pass. ./findings.json lists what a script found
(dead paths, expired dates, index mismatches, near-duplicates, long
notes). The notes are in ./notes/. For each finding, check it against
reality and either propose the fix or skip it. Propose nothing that no
finding points at. For every finding you do not act on, add a
dismissed entry (finding id and why). Return the structured result only.
"""

PROMPT_B = RULES + """
You are the independent pass. The notes are in ./notes/. Read every
note in full, then look for ones that are stale, contradicted by the
current state of the repos, services and files they describe, redundant
with another note, or too long for what they hold. Check claims against
reality (~/dotfiles, ~/projects, git log, systemd, gh issues) before
proposing. Return the structured result only.
"""


def sha(text):
    return hashlib.sha256(text.encode()).hexdigest()


def load_notes(src):
    return {
        p.name: p.read_text() for p in sorted(Path(src).glob("*.md"))
    }


def note_type(text):
    m = re.search(r"^\s+type:\s*(\w+)", text, re.M)
    return m.group(1) if m else ""


def frontmatter(text, key):
    m = re.search(rf"^{key}:\s*(.+)$", text, re.M)
    return m.group(1).strip().strip("\"'") if m else ""


def index_links(index_text):
    return re.findall(r"^- \[[^\]]*\]\(([^)]+\.md)\)", index_text, re.M)


PATH_RE = re.compile(
    r"^(~|/(?:home|etc|usr|opt|var|srv|mnt|[A-Z]\w+))(/[\w.@+-]+)+/?$"
)
SKIP_PATHS = ("/tmp/", "/run/", "/proc/", "/dev/", "/sys/")


def path_findings(name, text):
    out = []
    for tok in sorted(set(re.findall(r"`([^`\n]+)`", text))):
        if not PATH_RE.match(tok) or tok.startswith(SKIP_PATHS):
            continue
        if not os.path.exists(os.path.expanduser(tok)):
            remote = " (note mentions wonlab: may be remote)" * (
                "wonlab" in text
            )
            out.append(
                (name, "dead-path", f"`{tok}` not found here{remote}")
            )
    return out


DATE_RE = re.compile(r"\b(20\d\d-\d\d-\d\d)\b")
DEADLINE_RE = re.compile(
    r"(?:until|through|by|before|deadline|expires?)\D{0,30}"
    r"(20\d\d-\d\d-\d\d)",
    re.I,
)


def date_findings(name, text, today):
    out = []
    for d in sorted(set(DEADLINE_RE.findall(text))):
        if dt.date.fromisoformat(d) < today:
            out.append((name, "expired-date", f"deadline {d} is past"))
    dates = [dt.date.fromisoformat(d) for d in DATE_RE.findall(text)]
    if note_type(text) == "project" and dates:
        age = (today - max(dates)).days
        if age > OLD_PROJECT_DAYS:
            out.append(
                (name, "old-project", f"newest date is {age} days old")
            )
    return out


def words(text):
    return set(re.findall(r"[a-z]{4,}", text.lower()))


def dup_findings(notes):
    out = []
    bags = {n: words(t) for n, t in notes.items() if n != INDEX}
    names = sorted(bags)
    for i, a in enumerate(names):
        for b in names[i + 1:]:
            union = bags[a] | bags[b]
            ratio = len(bags[a] & bags[b]) / len(union) if union else 0
            if ratio >= DUP_RATIO:
                out.append(
                    (a, "near-duplicate", f"{b} overlaps {ratio:.0%}")
                )
    return out


def index_findings(notes):
    out = []
    linked = index_links(notes.get(INDEX, ""))
    for n in linked:
        if n not in notes:
            out.append((INDEX, "index-dead-link", f"{n} does not exist"))
    for n in notes:
        if n != INDEX and n not in linked:
            out.append((n, "not-indexed", "no line in MEMORY.md"))
    for n in {x for x in linked if linked.count(x) > 1}:
        out.append((INDEX, "index-duplicate", f"{n} listed twice"))
    return out


def scan(notes, today):
    found = index_findings(notes)
    found += dup_findings(notes)
    for name, text in notes.items():
        if name == INDEX:
            continue
        if not frontmatter(text, "name") or not note_type(text):
            found.append((name, "frontmatter", "missing name or type"))
        if len(text) > LONG_NOTE:
            found.append((name, "long", f"{len(text)} characters"))
        found += path_findings(name, text)
        found += date_findings(name, text, today)
    return [
        {"id": f"f{i}", "file": f, "kind": k, "detail": d}
        for i, (f, k, d) in enumerate(found, 1)
    ]


def touched(p):
    return {p["file"], p["into"]} if p["action"] == "merge" else {p["file"]}


def valid(p, notes):
    if not isinstance(p, dict) or p.get("file") not in notes:
        return "unknown file"
    if p["file"] == INDEX:
        return "index is edited through index_line only"
    act = p.get("action")
    if act not in ("delete", "rewrite", "merge"):
        return "unknown action"
    has_text = p.get("new_content", "").startswith("---")
    if act in ("rewrite", "merge") and not has_text:
        return "new_content missing or has no frontmatter"
    if act == "merge":
        into = p.get("into")
        if into not in notes or into in (INDEX, p["file"]):
            return "bad merge target"
    return None


def same(a, b):
    keys = ("action", "file", "into", "new_content")
    return all(a.get(k) == b.get(k) for k in keys)


def reconcile(by_source, notes):
    """Merge proposals from independent agents into ready/conflicts."""
    dropped, items = [], []
    for src, props in by_source.items():
        for p in props:
            why = valid(p, notes)
            if why:
                dropped.append({"source": src, "why": why, "proposal": p})
            else:
                items.append({**p, "source": src})
    groups = []
    for it in items:
        hit = [g for g in groups if g["files"] & touched(it)]
        merged = {"files": set(touched(it)), "items": [it]}
        for g in hit:
            merged["files"] |= g["files"]
            merged["items"] = g["items"] + merged["items"]
            groups.remove(g)
        groups.append(merged)
    ready, conflicts = [], []
    for g in groups:
        first = g["items"][0]
        if all(same(first, x) for x in g["items"]):
            srcs = sorted({x["source"] for x in g["items"]})
            ready.append({
                **first,
                "sources": srcs,
                "reason": " | ".join(
                    dict.fromkeys(x["reason"] for x in g["items"])
                ),
                "evidence": " | ".join(
                    dict.fromkeys(x["evidence"] for x in g["items"])
                ),
            })
        else:
            conflicts.append(g["items"])
    for i, r in enumerate(ready, 1):
        r["id"] = f"p{i}"
        r.pop("source", None)
        r["base"] = {n: sha(notes[n]) for n in touched(r)}
    return {"ready": ready, "conflicts": conflicts, "dropped": dropped}


def diff_text(old, new, name):
    return "".join(
        difflib.unified_diff(
            old.splitlines(True), new.splitlines(True),
            f"a/{name}", f"b/{name}",
        )
    )


DELTA = shutil.which("delta") is not None
TOKEN = re.compile(r"\s+|\S+")
WORD_DIFF_MIN_RATIO = 0.35


def word_spans(old, new):
    """Styled "-" and "+" lines with the changed words marked."""
    a, b = TOKEN.findall(old), TOKEN.findall(new)
    sm = difflib.SequenceMatcher(None, a, b, autojunk=False)
    if sm.ratio() < WORD_DIFF_MIN_RATIO:
        return [("- " + old, "del")], [("+ " + new, "add")]
    dels, adds = [("- ", "del")], [("+ ", "add")]
    for op, i1, i2, j1, j2 in sm.get_opcodes():
        if op == "equal":
            dels.append(("".join(a[i1:i2]), "del"))
            adds.append(("".join(b[j1:j2]), "add"))
            continue
        if i2 > i1:
            dels.append(("".join(a[i1:i2]), "delw"))
        if j2 > j1:
            adds.append(("".join(b[j1:j2]), "addw"))
    return dels, adds


def diff_spans(old, new, name, context=2):
    """Unified diff as styled lines, changed words marked inside."""
    a, b = old.splitlines(), new.splitlines()
    sm = difflib.SequenceMatcher(None, a, b, autojunk=False)
    out = [[(f"--- a/{name}", "hdr")], [(f"+++ b/{name}", "hdr")]]
    for group in sm.get_grouped_opcodes(context):
        first, last = group[0], group[-1]
        out.append([(f"@@ line {first[1] + 1}-{last[2]} @@", "hunk")])
        for op, i1, i2, j1, j2 in group:
            if op == "equal":
                out += [[("  " + x, "ctx")] for x in a[i1:i2]]
                continue
            olds, news = a[i1:i2], b[j1:j2]
            pairs = [word_spans(x, y) for x, y in zip(olds, news)]
            out += [d for d, _ in pairs]
            out += [[("- " + x, "del")] for x in olds[len(pairs):]]
            out += [ad for _, ad in pairs]
            out += [[("+ " + x, "add")] for x in news[len(pairs):]]
    return out


def as_spans(line):
    return [(line, "plain")] if isinstance(line, str) else line


def line_text(line):
    return "".join(text for text, _ in as_spans(line))


def wrap_spans(spans, width, indent=2):
    """Wrap one styled line at word breaks; continuations are indented."""
    width = max(width, indent + 8)
    out, cur, used = [], [], 0
    for text, style in spans:
        for tok in TOKEN.findall(text):
            if used + len(tok) > width and used > indent:
                if tok.isspace():
                    continue
                out.append(cur)
                cur, used = [(" " * indent, "plain")], indent
            while len(tok) > width - used:
                cut = width - used
                cur.append((tok[:cut], style))
                out.append(cur)
                cur, used, tok = [(" " * indent, "plain")], indent, tok[cut:]
            cur.append((tok, style))
            used += len(tok)
    out.append(cur)
    return out


def target(p):
    return p["into"] if p["action"] == "merge" else p["file"]


def label(slug):
    return re.sub(r"^-home-jaeho-(projects-)?", "", slug) or slug


def render_coverage(coverage, notes):
    out = []
    want = set(notes) - {INDEX}
    for src, d in sorted(coverage.items()):
        read = set(d.get("notes_read", [])) - {INDEX}
        if src == "A":
            out.append(f"Agent A read {len(read)} notes (its findings)")
        else:
            missing = sorted(want - read)
            n = len(want) - len(missing)
            line = f"Agent {src} read {n}/{len(want)} notes"
            if missing:
                line += f"; not read: {', '.join(missing)}"
            out.append(line)
        for x in d.get("dismissed", []):
            out.append(f"  - dismissed {x['finding']}: {x['why']}")
    return out


def render_review(result, notes, failures, title):
    ready, conflicts = result["ready"], result["conflicts"]
    out = [
        f"# {title}",
        "",
        (f"{len(ready)} ready, {len(conflicts)} conflicts, "
         f"{len(result['dropped'])} dropped."),
    ]
    for src, why in failures.items():
        out.append(f"\n**Agent {src} produced nothing:** {why}")
    out += ["", "## Coverage", *render_coverage(
        result.get("coverage", {}), notes)]
    for p in ready:
        out += [
            "",
            f"## {p['id']} {p['action']} {p['file']}"
            + (f" into {p['into']}" if p["action"] == "merge" else ""),
            f"Proposed by: {', '.join(p['sources'])}",
            f"Reason: {p['reason']}",
            f"Evidence: {p['evidence']}",
        ]
        if p["action"] in ("rewrite", "merge"):
            tgt = target(p)
            out += ["```diff", diff_text(notes[tgt], p["new_content"], tgt)
                    .rstrip(), "```"]
    if conflicts:
        out += ["", "## Conflicts (not applicable; decide by hand)"]
    for i, group in enumerate(conflicts, 1):
        out.append(f"\n### c{i}")
        for x in group:
            out += [
                f"- {x['source']}: {x['action']} {x['file']}"
                + (f" into {x['into']}" if x.get("into") else ""),
                f"  reason: {x['reason']}",
                f"  evidence: {x['evidence']}",
            ]
    if result["dropped"]:
        out += ["", "## Dropped"]
        out += [
            f"- {d['source']}: {d['why']} "
            f"({d['proposal'].get('file')})"
            for d in result["dropped"]
        ]
    return "\n".join(out) + "\n"


def edit_index(text, remove=(), replace=None):
    lines = text.splitlines()
    for name in remove:
        lines = [x for x in lines if f"({name})" not in x]
    for name, line in (replace or {}).items():
        hit = [i for i, x in enumerate(lines) if f"({name})" in x]
        if hit:
            lines[hit[0]] = line
        else:
            lines.append(line)
    return "\n".join(lines) + "\n"


def snapshot_text(sub, name):
    f = sub / "b" / "notes" / name
    return f.read_text() if f.exists() else ""


def promote(sub, ci, k):
    """Make side k of conflict ci a ready change; drop the other sides."""
    res = json.loads((sub / "proposals.json").read_text())
    group = res["conflicts"].pop(ci)
    item = {**group[k], "sources": [group[k]["source"]]}
    item.pop("source")
    item["id"] = f"p{len(res['ready']) + 1}"
    item["base"] = {n: sha(snapshot_text(sub, n)) for n in touched(item)}
    res["ready"].append(item)
    res.setdefault("resolved", []).append(group)
    (sub / "proposals.json").write_text(json.dumps(res, indent=1))
    return item["id"]


def dismiss(sub, ci):
    """Leave the notes in conflict as they are."""
    res = json.loads((sub / "proposals.json").read_text())
    res.setdefault("resolved", []).append(res["conflicts"].pop(ci))
    (sub / "proposals.json").write_text(json.dumps(res, indent=1))


def show_diff(old, new, name, pretty):
    if pretty and DELTA:
        return delta_diff(old, new, name, shutil.get_terminal_size().columns)
    return diff_text(old, new, name)


def apply_dir(sub, yes=False, only=None, say=print, pretty=False):
    """Apply (or preview) one project's ready proposals; returns ids."""
    src = Path((sub / "source.txt").read_text())
    result = json.loads((sub / "proposals.json").read_text())
    done = set(result.get("applied", []))
    index = (src / INDEX).read_text()
    new_index, applied = index, []
    for p in result["ready"]:
        if p["id"] in done or (only and p["id"] not in only):
            continue
        names = sorted(touched(p))
        stale = [
            n for n in names
            if not (src / n).exists()
            or sha((src / n).read_text()) != p["base"][n]
        ]
        head = f"{p['id']} {p['action']} {p['file']}"
        if stale:
            say(f"SKIP {head}: changed since snapshot: {stale}")
            continue
        say(f"{'APPLY' if yes else 'WOULD'} {head}: {p['reason']}")
        if p["action"] != "delete":
            tgt = target(p)
            say(show_diff((src / tgt).read_text(), p["new_content"], tgt,
                          pretty))
        gone = [p["file"]] if p["action"] in ("delete", "merge") else []
        new_index = edit_index(
            new_index, gone,
            {p["file"]: p["index_line"]} if p.get("index_line") else None,
        )
        if yes:
            backup = sub / "backup"
            backup.mkdir(exist_ok=True)
            for n in names:
                shutil.copy2(src / n, backup / n)
            if p["action"] == "delete":
                (src / p["file"]).unlink()
            else:
                (src / target(p)).write_text(p["new_content"])
                if p["action"] == "merge":
                    (src / p["file"]).unlink()
        applied.append(p["id"])
    if new_index != index:
        say(show_diff(index, new_index, INDEX, pretty))
    if yes and applied:
        (src / INDEX).write_text(new_index)
        result["applied"] = sorted(done | set(applied))
        (sub / "proposals.json").write_text(json.dumps(result, indent=1))
        say(f"applied {', '.join(applied)}; originals in {sub}/backup")
    return applied


def resolve_run(arg):
    run = STATE / "latest" if arg in (None, "latest") else Path(arg)
    if not run.is_dir():
        sys.exit(f"no such run: {run}")
    return run.resolve()


def load_run(run):
    recs = []
    for sub in sorted(run.iterdir()):
        if not (sub / "source.txt").exists():
            continue
        pj, failed = sub / "proposals.json", sub / "failed.txt"
        recs.append({
            "label": label(sub.name),
            "sub": sub,
            "result": json.loads(pj.read_text()) if pj.exists() else None,
            "error": failed.read_text() if failed.exists() else "",
        })
    return recs


def pending(rec):
    res = rec["result"] or {"ready": []}
    done = set(res.get("applied", []))
    return [p for p in res["ready"] if p["id"] not in done]


def clip(text, width):
    return text if len(text) <= width else text[: width - 1] + "…"


def render_summary(run, width=78):
    recs = load_run(run)
    n_ready = sum(len(pending(r)) for r in recs)
    n_conf = sum(len(r["result"]["conflicts"]) for r in recs if r["result"])
    out = [
        clip(
            f"Memory audit {run.name}: {n_ready} change"
            f"{'' if n_ready == 1 else 's'} ready, {n_conf} conflict"
            f"{'' if n_conf == 1 else 's'}, {len(recs)} projects", width),
        "",
    ]
    for r in recs:
        rows = pending(r)
        if r["result"] is None:
            out.append(f"{r['label']}: audit failed ({r['error'][:50]})")
            continue
        conf = len(r["result"]["conflicts"])
        if not rows and not conf:
            out.append(f"{r['label']}: nothing to change")
            continue
        out.append(r["label"])
        for p in rows:
            stem = p["file"].removesuffix(".md")
            out.append(clip(f"  {p['id']:<4}{p['action']:<8}{stem}", width))
            out += textwrap.wrap(
                p["summary"], width, initial_indent="      ",
                subsequent_indent="      ",
            )
        if conf:
            out.append(f"  {conf} conflict(s): pick a side in the review")
    out += [
        "",
        "Review and apply:  memory-audit review",
        f"Everything:        {run}/review.md",
    ]
    return "\n".join(out) + "\n"


def tui_rows(recs):
    rows = []
    for di, r in enumerate(recs):
        rows.append(("head", di, None))
        res = r["result"]
        if res is None:
            rows.append(("fail", di, r["error"] or "no result"))
            continue
        done = set(res.get("applied", []))
        for p in res["ready"]:
            rows.append(("done" if p["id"] in done else "ready", di, p))
        for i, g in enumerate(res["conflicts"], 1):
            rows.append(("conflict", di, (i, g)))
        if not res["ready"] and not res["conflicts"]:
            rows.append(("empty", di, None))
    return rows


def row_text(recs, row, sel):
    kind, di, p = row
    r = recs[di]
    if kind == "head":
        n = len(pending(r))
        conf = len(r["result"]["conflicts"]) if r["result"] else 0
        return f"{r['label']}  ({n} ready, {conf} conflicts)"
    if kind == "ready":
        mark = "x" if (di, p["id"]) in sel else " "
        stem = p["file"].removesuffix(".md")
        return f"  [{mark}] {p['id']:<4}{p['action']:<8}{stem}: {p['summary']}"
    if kind == "done":
        return f"  [✓] {p['id']:<4}applied {p['file']}"
    if kind == "conflict":
        i, g = p
        files = ", ".join(sorted({x["file"] for x in g}))
        return f"  [!] c{i}  conflict: {files}"
    if kind == "fail":
        return f"  audit failed: {p[:60]}"
    return "  nothing to change"


def detail_parts(recs, row, width):
    """Detail view as ("text", lines) and ("diff", old, new, name)."""
    kind, di, p = row
    wrap = textwrap.TextWrapper(width=max(width - 2, 20)).wrap
    sub = recs[di]["sub"]
    if kind == "conflict":
        i, group = p
        parts = [("text", [
            f"c{i}: the two agents want different things; pick one", ""])]
        for n, x in enumerate(group, 1):
            lines = [f"[{n}] agent {x['source']}: {x['action']} {x['file']}",
                     *wrap(f"why: {x['reason']}"),
                     *wrap(f"evidence: {x['evidence']}"), ""]
            parts.append(("text", lines))
            if x["action"] in ("rewrite", "merge"):
                tgt = target(x)
                parts.append(("diff", snapshot_text(sub, tgt),
                              x["new_content"], tgt))
        return parts
    parts = [("text", [
        f"{p['id']}  {p['action']}  {p['file']}", "",
        *wrap(f"Why: {p['reason']}"), "",
        *wrap(f"Evidence: {p['evidence']}"), ""])]
    if p["action"] in ("rewrite", "merge"):
        tgt = target(p)
        parts.append(("diff", snapshot_text(sub, tgt),
                      p["new_content"], tgt))
    else:
        parts.append(("text", [
            "(the note is deleted; a copy is kept in the run's backup/)"]))
    return parts


def detail_lines(recs, row, width):
    """The built-in view: text lines and styled diff lines."""
    out = []
    for part in detail_parts(recs, row, width):
        if part[0] == "text":
            out += part[1]
        else:
            out += diff_spans(*part[1:])
    return out


def delta_diff(old, new, name, cols, side=False):
    """The diff as git shows it: git diff --no-index through delta."""
    with tempfile.TemporaryDirectory() as d:
        for tag, text in (("a", old), ("b", new)):
            f = Path(d) / tag / name
            f.parent.mkdir(parents=True, exist_ok=True)
            f.write_text(text)
        git = subprocess.run(
            ["git", "--no-pager", "diff", "--no-index", "--no-color",
             f"a/{name}", f"b/{name}"],
            cwd=d, capture_output=True, text=True, check=False,
        )
    cmd = ["delta", "--paging=never", f"--width={cols}"]
    if side:
        cmd += ["--features", "side"]
    out = subprocess.run(
        cmd, input=git.stdout, capture_output=True, text=True, check=False
    )
    return out.stdout or git.stdout


def pager_text(recs, row, cols, side=False):
    out = []
    for part in detail_parts(recs, row, cols):
        if part[0] == "text":
            out += part[1]
        else:
            out.append(delta_diff(*part[1:], cols, side))
    return "\n".join(out) + "\n"


def tui(stdscr, run):
    curses.curs_set(0)
    curses.use_default_colors()
    if curses.has_colors():
        curses.init_pair(1, curses.COLOR_GREEN, -1)
        curses.init_pair(2, curses.COLOR_RED, -1)
        curses.init_pair(3, curses.COLOR_CYAN, -1)
    recs, sel, cur, top, msg = load_run(run), set(), 0, 0, ""

    def put(y, text, attr=0):
        h, w = stdscr.getmaxyx()
        if 0 <= y < h:
            stdscr.addnstr(y, 0, text.ljust(w - 1), w - 1, attr)

    green, red = curses.color_pair(1), curses.color_pair(2)
    marked = curses.A_REVERSE | curses.A_BOLD
    styles = {
        "plain": 0, "ctx": curses.A_DIM, "hdr": curses.A_BOLD,
        "hunk": curses.color_pair(3), "add": green, "del": red,
        "addw": green | marked, "delw": red | marked,
    }

    def put_spans(y, spans):
        h, w = stdscr.getmaxyx()
        x = 0
        for text, style in spans:
            if y >= h or x >= w - 1:
                return
            stdscr.addnstr(y, x, text, w - 1 - x, styles[style])
            x += len(text)

    def open_pager(row, side=False):
        text = pager_text(recs, row, shutil.get_terminal_size().columns,
                          side)
        curses.def_prog_mode()
        curses.endwin()
        subprocess.run(["less", "-R"], input=text.encode(), check=False)
        curses.reset_prog_mode()
        stdscr.refresh()

    def ask(prompt):
        put(stdscr.getmaxyx()[0] - 2, prompt, curses.A_BOLD)
        stdscr.refresh()
        return stdscr.getch() in (ord("y"), ord("Y"))

    def show(row):
        pos = 0
        conflict = row[0] == "conflict"
        while True:
            h, w = stdscr.getmaxyx()
            lines = [
                piece for ln in detail_lines(recs, row, w)
                for piece in wrap_spans(as_spans(ln), w - 1)
            ]
            stdscr.erase()
            for i, ln in enumerate(lines[pos: pos + h - 2]):
                put_spans(i, ln)
            put(h - 1, "1-9 use that side   d keep notes as they are   "
                "j/k scroll   q back" if conflict else
                "j/k scroll   q or enter: back", curses.A_REVERSE)
            key = stdscr.getch()
            if key in (ord("q"), 27, 10, ord("h")):
                return "", None
            if conflict and ord("1") <= key <= ord("9"):
                group, sub_dir = row[2][1], recs[row[1]]["sub"]
                if key - ord("1") < len(group):
                    pid = promote(sub_dir, row[2][0] - 1, key - ord("1"))
                    return f"chose side {chr(key)}; selected {pid}", pid
            if conflict and key == ord("d"):
                dismiss(recs[row[1]]["sub"], row[2][0] - 1)
                return "conflict dismissed; notes left as they are", None
            if key in (ord("j"), curses.KEY_DOWN):
                pos = min(pos + 1, max(len(lines) - 1, 0))
            elif key in (ord("k"), curses.KEY_UP):
                pos = max(pos - 1, 0)
            elif key == curses.KEY_NPAGE:
                pos = min(pos + h - 3, max(len(lines) - 1, 0))
            elif key == curses.KEY_PPAGE:
                pos = max(pos - (h - 3), 0)

    while True:
        rows = tui_rows(recs)
        cur = max(0, min(cur, len(rows) - 1))
        h = stdscr.getmaxyx()[0]
        span = max(h - 4, 1)
        top = min(max(top, cur - span + 1), cur)
        stdscr.erase()
        put(0, f"Memory audit {run.name}   {len(sel)} selected",
            curses.A_BOLD)
        for i, row in enumerate(rows[top: top + span]):
            idx = top + i
            attr = curses.A_REVERSE if idx == cur else 0
            if row[0] == "head" and idx != cur:
                attr = curses.A_BOLD | curses.color_pair(3)
            elif row[0] in ("done", "empty") and idx != cur:
                attr = curses.A_DIM
            put(2 + i, row_text(recs, row, sel), attr)
        put(h - 2, msg, curses.A_BOLD)
        put(h - 1, "j/k move  space select  a project  enter diff  "
            "s side-by-side  1-9/d resolve  A apply  q quit",
            curses.A_REVERSE)
        key = stdscr.getch()
        msg = ""
        row = rows[cur] if rows else None
        if key in (ord("q"), 27):
            return
        if key in (ord("j"), curses.KEY_DOWN):
            cur += 1
        elif key in (ord("k"), curses.KEY_UP):
            cur -= 1
        elif key == ord(" ") and row and row[0] == "ready":
            sel ^= {(row[1], row[2]["id"])}
            cur += 1
        elif key == ord("a") and row:
            ids = {(row[1], p["id"]) for p in pending(recs[row[1]])}
            sel = sel - ids if ids <= sel else sel | ids
        elif key in (10, curses.KEY_ENTER, ord("l")) and row:
            if row[0] in ("ready", "done", "conflict") and DELTA:
                open_pager(row)
            elif row[0] in ("ready", "done", "conflict"):
                msg, pid = show(row)
                if row[0] == "conflict" and msg:
                    recs = load_run(run)
                if pid:
                    sel.add((row[1], pid))
                    msg += "; press A to apply"
        elif key == ord("s") and row and DELTA:
            if row[0] in ("ready", "done", "conflict"):
                open_pager(row, side=True)
        elif row and row[0] == "conflict" and ord("1") <= key <= ord("9"):
            group, ci = row[2][1], row[2][0] - 1
            if key - ord("1") < len(group):
                pid = promote(recs[row[1]]["sub"], ci, key - ord("1"))
                recs = load_run(run)
                sel.add((row[1], pid))
                msg = f"chose side {chr(key)}; selected {pid}; A applies"
        elif row and row[0] == "conflict" and key == ord("d"):
            dismiss(recs[row[1]]["sub"], row[2][0] - 1)
            recs = load_run(run)
            msg = "conflict dismissed; notes left as they are"
        elif key == ord("A"):
            if not sel:
                msg = "nothing selected (space selects)"
            elif ask(f"Apply {len(sel)} change(s) to your memory notes? "
                     "Originals are kept in the run's backup/. (y/N)"):
                msg = apply_selected(recs, sel)
                recs, sel = load_run(run), set()


def apply_selected(recs, sel):
    done, notes = 0, []
    for di in sorted({d for d, _ in sel}):
        ids = {i for d, i in sel if d == di}
        out = []
        done += len(apply_dir(recs[di]["sub"], True, ids, out.append))
        notes += [x for x in out if x.startswith("SKIP")]
    skipped = f"; {len(notes)} skipped (note changed since the audit)" * (
        bool(notes))
    return f"applied {done}{skipped}"


def cmd_review(args):
    run = resolve_run(args.run)
    if not sys.stdout.isatty():
        sys.stdout.write(render_summary(run))
        return
    os.environ.setdefault("ESCDELAY", "25")
    curses.wrapper(tui, run)


def cmd_summary(args):
    sys.stdout.write(render_summary(resolve_run(args.run)))


def cmd_apply(args):
    run = resolve_run(args.run)
    recs = [
        r for r in load_run(run)
        if r["result"] and (not args.dir or r["label"] in args.dir)
    ]
    if args.yes and not (args.only or args.all):
        sys.exit("--yes needs --only IDS (with --dir) or --all")
    if args.only and len(recs) != 1:
        sys.exit("--only ids are per project: pass one --dir")
    only = set(args.only.split(",")) if args.only else None
    for r in recs:
        print(f"== {r['label']}")
        apply_dir(r["sub"], args.yes, only, pretty=sys.stdout.isatty())
    if not args.yes:
        print("dry run: nothing written; add --yes to apply")


def make_view(sub, name, notes, extra=None):
    view = sub / name
    (view / "notes").mkdir(parents=True)
    for n, t in notes.items():
        (view / "notes" / n).write_text(t)
        (view / "notes" / n).chmod(0o444)
    for fname, text in (extra or {}).items():
        (view / fname).write_text(text)
    return view


def run_agent(name, prompt, cwd, sub, budget, timeout):
    cmd = [
        "claude", "-p", "--output-format", "json",
        "--json-schema", json.dumps(SCHEMA),
        "--permission-mode", "dontAsk",
        "--tools", "Read,Grep,Glob,Bash",
        "--allowedTools", *READ_ONLY_TOOLS,
        "--disallowedTools", "Edit", "Write", "NotebookEdit",
        "--add-dir", str(HOME / "dotfiles"), str(HOME / "projects"),
        "--no-session-persistence",
        "--max-budget-usd", str(budget),
    ]
    env = {**os.environ, "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1"}
    try:
        r = subprocess.run(
            cmd, input=prompt, cwd=cwd, capture_output=True, text=True,
            timeout=timeout, env=env,
        )
    except subprocess.TimeoutExpired:
        return name, None, f"timed out after {timeout}s"
    (sub / f"{name}.raw.json").write_text(r.stdout)
    (sub / f"{name}.err").write_text(r.stderr)
    try:
        out = json.loads(r.stdout)
    except json.JSONDecodeError:
        return name, None, f"unreadable output (exit {r.returncode})"
    data = out.get("structured_output")
    if data is None and isinstance(out.get("result"), str):
        with contextlib.suppress(json.JSONDecodeError):
            data = json.loads(out["result"])
    if out.get("is_error") or not isinstance(data, dict):
        why = str(out.get("result", "no structured output"))
        return name, None, why[:200]
    return name, data, None


def slug_of(mem):
    mem = Path(mem).resolve()
    return mem.parent.name if mem.name == "memory" else mem.name


def discover():
    found = []
    for mem in sorted(PROJECTS.glob("*/memory")):
        slug = mem.parent.name
        if slug.startswith("-tmp-") or "memory-audit" in slug:
            continue
        notes = [p for p in mem.glob("*.md") if p.name != INDEX]
        if (mem / INDEX).exists() and notes:
            found.append(mem)
    return found


def drop_agent_projects(run):
    """Remove the project dirs Claude Code made for the agents' cwds."""
    for d in PROJECTS.glob(f"*memory-audit-{run.name}-*"):
        shutil.rmtree(d, ignore_errors=True)


def audit_dir(mem, run, today, args):
    notes = load_notes(mem)
    sub = run / slug_of(mem)
    sub.mkdir()
    (sub / "source.txt").write_text(str(Path(mem).resolve()))
    findings = scan(notes, today)
    (sub / "scan.json").write_text(json.dumps(findings, indent=1))
    view_a = make_view(
        sub, "a", notes, {"findings.json": json.dumps(findings, indent=1)}
    )
    view_b = make_view(sub, "b", notes)
    rules = {"today": today.isoformat()}
    jobs = [
        ("a", PROMPT_A.format(**rules), view_a),
        ("b", PROMPT_B.format(**rules), view_b),
    ]
    with ThreadPoolExecutor(2) as pool:
        futs = [
            pool.submit(run_agent, n, p, v, sub, args.budget, args.timeout)
            for n, p, v in jobs
        ]
        results = [f.result() for f in futs]
    ok = {n.upper(): d for n, d, err in results if not err}
    failures = {n.upper(): err for n, d, err in results if err}
    if not ok:
        (sub / "failed.txt").write_text("; ".join(failures.values()))
        return False
    result = reconcile(
        {s: d.get("proposals", []) for s, d in ok.items()}, notes
    )
    result["failures"], result["coverage"] = failures, ok
    (sub / "proposals.json").write_text(json.dumps(result, indent=1))
    (sub / "review.md").write_text(
        render_review(result, notes, failures, label(sub.name))
    )
    return True


def cmd_scan(args):
    for mem in args.dir or discover():
        print(f"== {label(slug_of(mem))}")
        for f in scan(load_notes(mem), dt.date.today()):
            print(f"{f['kind']:15} {f['file']}: {f['detail']}")


def cmd_run(args):
    dirs = [Path(d) for d in args.dir] or discover()
    for mem in dirs:
        if not (mem / INDEX).exists():
            sys.exit(f"no {INDEX} in {mem}")
    STATE.mkdir(parents=True, exist_ok=True)
    lock = os.open(STATE / "lock", os.O_CREAT | os.O_WRONLY)
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        sys.exit("another memory-audit run is in progress")
    run = STATE / dt.datetime.now().strftime("%Y-%m-%d-%H%M")
    run.mkdir()
    today = dt.date.today()
    with ThreadPoolExecutor(3) as pool:
        oks = list(pool.map(
            lambda m: audit_dir(m, run, today, args), dirs))
    drop_agent_projects(run)
    if not any(oks):
        tell(args, "Memory audit failed", f"no project finished: {run}")
        sys.exit("every project failed; see failed.txt under " + str(run))
    pieces = [
        f"# {label(r['sub'].name)}\n\n" + (r["sub"] / "review.md").read_text()
        for r in load_run(run) if r["result"]
    ]
    (run / "review.md").write_text("\n".join(pieces))
    summary = render_summary(run)
    (run / "summary.txt").write_text(summary)
    latest = STATE / "latest"
    latest.unlink(missing_ok=True)
    latest.symlink_to(run.name)
    sys.stdout.write(summary)
    recs = load_run(run)
    n = sum(len(pending(r)) for r in recs)
    conf = sum(len(r["result"]["conflicts"]) for r in recs if r["result"])
    body = (f"{n} change{'' if n == 1 else 's'} ready"
            f"{f', {conf} conflicts' if conf else ''}. Click to review.")
    notify(args, run, "Memory audit finished", body)


def notify_cmd():
    return shlex.split(os.environ.get("MEMORY_AUDIT_NOTIFY", "notify-send"))


def open_cmd():
    return shlex.split(os.environ.get("MEMORY_AUDIT_OPEN", "hypr-pane --"))


def tell(args, title, body):
    if not args.no_notify:
        subprocess.run(
            [*notify_cmd(), "-a", "memory-audit", title, body], check=False
        )


def notify(args, run, title, body):
    """Send a toast whose click opens the review in a tmux pane."""
    if args.no_notify:
        return
    me = [sys.executable, str(Path(__file__).resolve()), "notify-wait",
          str(run), title, body]
    # A oneshot service kills its leftovers when it exits, so the waiter
    # runs as its own transient unit.
    unit = ["systemd-run", "--user", "--collect", "--quiet",
            "-p", "RuntimeMaxSec=3d", *me]
    try:
        subprocess.run(unit, check=True)
    except (OSError, subprocess.CalledProcessError):
        subprocess.Popen(me, start_new_session=True)


def cmd_notify_wait(args):
    r = subprocess.run(
        [*notify_cmd(), "--wait", "--action=default=Review",
         "-a", "memory-audit", args.title, args.body],
        capture_output=True, text=True, check=False,
    )
    if r.stdout.strip() == "default":
        subprocess.run(
            [*open_cmd(), "memory-audit", "review", args.run], check=False
        )


def selftest_fixture(tmp):
    note_t = (
        "---\nname: {s}\ndescription: {d}\nmetadata:\n  type: project\n"
        "---\n\n{b}\n"
    )
    notes = {
        f"{n}.md": note_t.format(s=n, d=n, b=f"body {n}") for n in "abc"
    }
    notes[INDEX] = "".join(f"- [{n}]({n}.md) — hook {n}\n" for n in "abc")
    return note_t, notes


def cmd_selftest(_args):
    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        note_t, notes = selftest_fixture(tmp)
        src = tmp / "-home-jaeho-projects-demo" / "memory"
        src.mkdir(parents=True)
        for n, t in notes.items():
            (src / n).write_text(t)
        new_a = note_t.format(s="a", d="a", b="shorter")
        other = new_a.replace("shorter", "different")

        def prop(f, act, **kw):
            return {"file": f, "action": act, "summary": "s",
                    "reason": "r", "evidence": "e", **kw}

        delete_b = prop("b.md", "delete")
        res = reconcile(
            {
                "A": [delete_b, prop("a.md", "rewrite", new_content=new_a),
                      prop("ghost.md", "delete")],
                "B": [delete_b, prop("a.md", "rewrite", new_content=other)],
            },
            notes,
        )
        assert len(res["ready"]) == 1, res["ready"]
        assert res["ready"][0]["sources"] == ["A", "B"]
        assert len(res["conflicts"]) == 1
        assert [d["why"] for d in res["dropped"]] == ["unknown file"]
        merge = prop("c.md", "merge", into="a.md", new_content=new_a)
        res2 = reconcile(
            {"A": [merge], "B": [delete_b, prop("a.md", "delete")]}, notes
        )
        assert len(res2["conflicts"]) == 1, res2
        run = tmp / "run"
        sub = run / src.parent.name
        (sub / "b" / "notes").mkdir(parents=True)
        for n, t in notes.items():
            (sub / "b" / "notes" / n).write_text(t)
        (sub / "source.txt").write_text(str(src))
        res["coverage"] = {"B": {"notes_read": ["a.md"], "dismissed": [
            {"finding": "f1", "why": "w"}]}}
        (sub / "proposals.json").write_text(json.dumps(res))
        text = render_review(res, notes, {"A": "boom"}, "demo")
        assert "read 1/3" in text and "not read: b.md, c.md" in text
        assert "dismissed f1: w" in text and "produced nothing" in text
        summary = render_summary(run)
        assert "1 change ready, 1 conflict, 1 projects" in summary, summary
        assert "p1  delete  b\n      s\n" in summary, summary
        assert max(map(len, summary.splitlines())) <= 78
        rows = tui_rows(load_run(run))
        assert [r[0] for r in rows] == ["head", "ready", "conflict"]
        detail = "\n".join(
            map(line_text, detail_lines(load_run(run), rows[2], 60)))
        assert "[1] agent A" in detail and "[2] agent B" in detail, detail
        old_p = "keep this part, but old words change here, then more text"
        new_p = "keep this part, but new words change here, then more text"
        spans = diff_spans(old_p + "\nfixed", new_p + "\nfixed", "n.md")
        marks = [(s, t) for ln in spans for s, t in ln if t.endswith("w")]
        assert marks == [("old", "delw"), ("new", "addw")], marks
        for ln in wrap_spans([("+ ", "add"), ("word " * 30, "add")], 40):
            assert len(line_text(ln)) <= 40, line_text(ln)
        assert len(wrap_spans([("x" * 100, "add")], 40)) == 3
        if DELTA:
            shown = delta_diff(old_p, new_p, "n.md", 80)
            assert "old" in shown and "new" in shown, shown
            side = delta_diff(old_p, new_p, "n.md", 100, side=True)
            assert "new" in side, side
        probe = tmp / "probe"
        shutil.copytree(sub, probe)
        pid = promote(probe, 0, 1)
        got = json.loads((probe / "proposals.json").read_text())
        assert got["conflicts"] == [] and got["ready"][-1]["id"] == pid
        assert got["ready"][-1]["new_content"] == other
        assert set(got["ready"][-1]["base"]) == {"a.md"}
        dismiss(probe, 0) if got["conflicts"] else None
        apply_dir(sub)
        assert (src / "b.md").exists(), "dry run wrote"
        (src / "b.md").write_text("changed meanwhile")
        out = []
        apply_dir(sub, True, None, out.append)
        assert (src / "b.md").read_text() == "changed meanwhile"
        assert any(x.startswith("SKIP") for x in out)
        (src / "b.md").write_text(notes["b.md"])
        apply_dir(sub, True)
        assert not (src / "b.md").exists()
        assert (sub / "backup" / "b.md").read_text() == notes["b.md"]
        assert "b.md" not in (src / INDEX).read_text()
        assert "a.md" in (src / INDEX).read_text()
        assert json.loads((sub / "proposals.json").read_text())["applied"] \
            == ["p1"]
        assert not pending(load_run(run)[0])
        apply_dir(sub, True)  # a second apply must be a no-op
        # click path: the stub toast "is clicked", the pane opener runs
        log = tmp / "calls.txt"
        stub = tmp / "stub.sh"
        stub.write_text(
            f'#!/bin/sh\necho "$@" >> {log}\n'
            '[ "$1" = "--wait" ] && echo default\nexit 0\n'
        )
        stub.chmod(0o755)
        os.environ["MEMORY_AUDIT_NOTIFY"] = str(stub)
        os.environ["MEMORY_AUDIT_OPEN"] = f"{stub} PANE --"
        cmd_notify_wait(argparse.Namespace(
            run=str(run), title="T", body="B"))
        calls = log.read_text()
        assert "--wait --action=default=Review" in calls, calls
        assert f"PANE -- memory-audit review {run}" in calls, calls
    print("selftest ok")


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("run")
    p.add_argument("--dir", action="append", default=[])
    p.add_argument("--budget", type=float, default=5)
    p.add_argument("--timeout", type=int, default=1800)
    p.add_argument("--no-notify", action="store_true")
    p.set_defaults(fn=cmd_run)
    p = sub.add_parser("scan")
    p.add_argument("--dir", action="append", type=Path, default=[])
    p.set_defaults(fn=cmd_scan)
    for name, fn in (("summary", cmd_summary), ("review", cmd_review)):
        p = sub.add_parser(name)
        p.add_argument("run", nargs="?")
        p.set_defaults(fn=fn)
    p = sub.add_parser("apply")
    p.add_argument("run", nargs="?")
    p.add_argument("--dir", action="append")
    p.add_argument("--yes", action="store_true")
    p.add_argument("--only")
    p.add_argument("--all", action="store_true")
    p.set_defaults(fn=cmd_apply)
    p = sub.add_parser("notify-wait")
    for a in ("run", "title", "body"):
        p.add_argument(a)
    p.set_defaults(fn=cmd_notify_wait)
    sub.add_parser("selftest").set_defaults(fn=cmd_selftest)
    args = ap.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
