#!/bin/sh
# Print one field of ~/.config/vdirsyncer/google.env for vdirsyncer.
# usage: google-oauth-secret client_id|client_secret
set -eu
key=$1
case $key in
    client_id) name=GOOGLE_CLIENT_ID ;;
    client_secret) name=GOOGLE_CLIENT_SECRET ;;
    *) echo "usage: google-oauth-secret client_id|client_secret" >&2; exit 2 ;;
esac
sed -n "s/^${name}=//p" "$HOME/.config/vdirsyncer/google.env" | tr -d '\n'
