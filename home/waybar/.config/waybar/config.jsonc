{
    "layer": "top",
    // style.css (and anything it @imports) applies on save; config changes
    // still need a restart
    "reload_style_on_change": true,
    "position": "top",
    "height": 34,
    "spacing": 4,
    "margin-top": 6,
    "margin-bottom": 0,
    "margin-left": 8,
    "margin-right": 8,

    "modules-left": [
        "hyprland/workspaces",
        "custom/window"
    ],
    "modules-center": [
        "mpris",
        "clock"
    ],
    // Clustered by what a glance is for; style.css draws a divider before each
    // cluster after the first. Groups default to vertical on a top bar, so
    // every one needs "orientation": "horizontal".
    "modules-right": [
        "group/status",
        "group/load",
        "group/output",
        "group/link",
        "group/session"
    ],

    // Things that want your attention: recording, apps, notifications
    "group/status": {
        "orientation": "horizontal",
        "modules": [
            // Drawer first: the bar is right-anchored, so an opening drawer
            // only grows the island's left edge instead of shoving the
            // always-visible indicators after it sideways.
            "group/tray-drawer",
            "privacy",
            "custom/idle-inhibitor",
            "custom/swaync",
            "custom/reboot-needed",
            "systemd-failed-units"
        ]
    },
    // The tray lives behind one glyph, like Windows' hidden-icons chevron.
    // Click the glyph to slide the icons out to its left; click it again to
    // tuck them away. Leaving with the pointer does not close it, so a tray
    // icon's right-click menu is safe to reach. Not "group/tray": a group's CSS
    // id is its name, and #tray is already the tray module itself.
    "group/tray-drawer": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 250,
            "transition-left-to-right": false,
            "click-to-reveal": true
        },
        "modules": ["custom/tray-toggle", "tray"]
    },
    // No on-click: the group's own click handler does the toggling, and a
    // module that handles the click itself would swallow it.
    "custom/tray-toggle": {
        "format": "󰅁",
        "tooltip": false
    },
    // Which app has the mic or is sharing the screen. Steno says when it is
    // recording; this says who is listening. Hidden while nothing is. No
    // audio-out: anything playing music would keep it lit.
    "privacy": {
        "icon-size": 14,
        "icon-spacing": 6,
        "modules": [
            { "type": "screenshare" },
            { "type": "audio-in" }
        ]
    },
    // Hidden while nothing has failed. Counts system and user units alike.
    "systemd-failed-units": {
        "format": "󰀨 {nr_failed}",
        "on-click": "~/.local/bin/hypr-settings-menu failed-units"
    },
    // Glyphs only; numbers and details drop down in the tooltip on hover
    "group/load": {
        "orientation": "horizontal",
        "modules": ["custom/load"]
    },
    "group/output": {
        "orientation": "horizontal",
        "modules": ["backlight", "pulseaudio"]
    },
    // Battery and the radios: what keeps the machine up and connected
    "group/link": {
        "orientation": "horizontal",
        "modules": ["group/power", "bluetooth", "network"]
    },
    "group/session": {
        "orientation": "horizontal",
        "modules": ["custom/power"]
    },

    "group/power": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 500,
            "children-class": "drawer-child",
            "transition-left-to-right": false
        },
        "modules": ["battery", "power-profiles-daemon"]
    },

    "hyprland/workspaces": {
        // {windows} is required even in taskbar mode: waybar only reads the
        // workspace-taskbar block when the format string contains it.
        "format": "{name} {windows}",
        // Special workspaces (the scratchpad) render here too, so they get the
        // same real icons as everything else. They appear only while populated.
        "show-special": true,
        // "default" sorts normal workspaces by id then specials last. "number"
        // would throw on the specials' glyph names and fall back to string order.
        "sort-by": "default",
        // No "on-click": the workspace button's own handler switches, and needs
        // waybar-git (0.15.0 sends legacy dispatch strings the Lua config
        // rejects, so only the window icons would respond).
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
        "smooth-scrolling-threshold": 6,
        // Real app icons resolved from the window class -> .desktop file -> icon
        // theme, so every app gets its own icon with nothing hardcoded here.
        // Papirus-Dark is tried first (widest app coverage), Adwaita as fallback.
        "workspace-taskbar": {
            "enable": true,
            "icon-size": 14,
            "icon-theme": ["Papirus-Dark", "Adwaita"],
            "update-active-window": true,
            "ignore-list": ["chrome-sharing-indicator"],
            "on-click-window": "~/.local/bin/hypr-waybar-window-click {address}"
        }
    },

    // NOT hyprland/window: that module resolves the title through
    // `activeworkspace`, which Hyprland reports as the workspace *underneath* a
    // raised special workspace -- so the scratchpad would show the window behind
    // it. The script asks `activewindow` instead. See its header.
    "custom/window": {
        "exec": "~/.local/bin/hypr-active-window",
        "return-type": "json",
        // Bounded so a long title cannot push the centre island off-centre;
        // the full title stays in the tooltip.
        "max-length": 60,
        "escape": true
    },

    "clock": {
        "format": "{:%a %b %d  %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%Y-%m-%d %H:%M:%S}"
    },

    "mpris": {
        "format": "{player_icon} {dynamic}",
        "format-paused": "{status_icon} {dynamic}",
        "player-icons": {
            "default": "▶",
            "mpv": "󰐌",
            "spotify": "󰓇",
            "spotify_player": "󰓇",
            "vesktop": "󰙯",
            "discord": "󰙯",
            "vlc": "󰐌",
            "firefox": "󰈹",
            "[Gg]oogle-chrome": "󰊯"
        },
        "status-icons": {
            "paused": "⏸"
        },
        "dynamic-len": 45,
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-click-middle": "playerctl previous"
    },

    // CPU, RAM and GPU ramps in one label; hover for the panel
    "custom/load": {
        "exec": "~/.config/waybar/scripts/load.py",
        "return-type": "json",
        "restart-interval": 10,
        "on-click": "~/.local/bin/hypr-settings-menu monitor"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-connected": "󰂱",
        "format-connected-battery": "󰂱",
        "format-off": "󰂲",
        "format-alt": "󰂯 {num_connections}",
        "on-click-right": "~/.local/bin/hypr-settings-menu bluetooth",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}\t{device_battery_percentage}%"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        // The number only shows when it matters; otherwise it is in the tooltip
        "format": "{icon}",
        "format-warning": "{icon} {capacity}%",
        "format-critical": "{icon} {capacity}%",
        "format-charging": "󰂄",
        "format-plugged": "󰚥",
        "format-alt": "{icon} {time}",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "{capacity}%  ·  {timeTo}\n{power:.1f} W  ·  Health {health}%",
        "on-click-right": "~/.local/bin/hypr-settings-menu battery"
    },

    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Profile: {profile}\nDriver: {driver}",
        "format-icons": {
            "default": "󰗑",
            "performance": "󱐋",
            "balanced": "󰗑",
            "power-saver": "󰌪"
        }
    },

    "network": {
        "format-wifi": "󰤨",
        "format-ethernet": "󰈀",
        "format-linked": "󰈀",
        "format-disconnected": "󰤭",
        "format-alt": "{ifname}  {ipaddr}/{cidr}",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ifname} via {gwaddr}\n{ipaddr}/{cidr}\n↑ {bandwidthUpBits} ↓ {bandwidthDownBits}",
        "tooltip-format-ethernet": "{ifname} via {gwaddr}\n{ipaddr}/{cidr}\n↑ {bandwidthUpBits} ↓ {bandwidthDownBits}",
        "tooltip-format-disconnected": "Disconnected",
        "tooltip-format": "{ifname} via {gwaddr}\n{ipaddr}/{cidr}",
        "on-click-right": "~/.local/bin/hypr-settings-menu wifi"
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-bluetooth": "󰂰",
        "format-muted": "󰝟",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "tooltip-format": "{desc}  ·  {volume}%",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "~/.local/bin/hypr-settings-menu audio",
        "on-scroll-up": "hypr-level volume up",
        "on-scroll-down": "hypr-level volume down"
    },

    "backlight": {
        "format": "{icon}",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "tooltip-format": "Brightness {percent}%",
        "on-scroll-up": "hypr-level brightness up",
        "on-scroll-down": "hypr-level brightness down"
    },

    "custom/idle-inhibitor": {
        "exec": "if pgrep -x hypridle > /dev/null; then echo '{\"text\": \"󰾪\", \"tooltip\": \"Stay awake: OFF\", \"class\": \"off\"}'; else echo '{\"text\": \"󰅶\", \"tooltip\": \"Stay awake: ON (idle + lid)\", \"class\": \"on\"}'; fi",
        "return-type": "json",
        "interval": 2,
        "signal": 11,
        "on-click": "~/.local/bin/hypr-settings-menu awake"
    },

    "custom/swaync": {
        "tooltip": true,
        // {icon}{text}: jq adds the space only when there is a count to show.
        // Under DND the count is hidden (the tooltip still has it).
        "format": "{icon}{text}",
        "format-icons": {
            "notification": "󰂚",
            "none": "󰂚",
            "dnd-notification": "󰂛",
            "dnd-none": "󰂛",
            "inhibited-notification": "󰂚",
            "inhibited-none": "󰂚",
            "dnd-inhibited-notification": "󰂛",
            "dnd-inhibited-none": "󰂛"
        },
        "return-type": "json",
        "exec-if": "command -v swaync-client",
        "exec": "swaync-client -swb | jq --unbuffered -c '.text = (if .text == \"0\" or (.alt | startswith(\"dnd\")) then \"\" else \" \" + .text end)'",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "~/.local/bin/hypr-settings-menu dnd",
        "escape": true
    },

    "custom/reboot-needed": {
        "exec": "~/.config/waybar/scripts/reboot-needed.sh",
        "return-type": "json",
        "interval": 300,
        // A one-item menu is the confirmation: click, then click "Reboot now"
        "menu": "on-click",
        "menu-file": "~/.config/waybar/reboot_menu.xml",
        "menu-actions": {
            "reboot": "~/.local/bin/hypr-settings-menu reboot"
        }
    },

    // Which icons appear here is not decided in this file: the tray is a
    // StatusNotifierItem host, so it shows whatever running app registers on
    // D-Bus (`busctl --user call org.kde.StatusNotifierWatcher \
    // /StatusNotifierWatcher org.freedesktop.DBus.Properties Get ss \
    // org.kde.StatusNotifierWatcher RegisteredStatusNotifierItems` lists them).
    // To drop one, stop the app tray-ing itself; there is no filter here.
    // Passive items (udiskie with no removable media) are hidden by default.
    "tray": {
        "icon-size": 16,
        // Adds to the 4px each item carries in the stylesheet: 14px between
        // icons. Tray icons fill their whole 16px square (glyphs have side
        // bearings, these do not), so they need more box gap than the text
        // modules to look as far apart.
        "spacing": 6
    },

    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "~/.config/waybar/power_menu.xml",
        "menu-actions": {
            "lock": "~/.local/bin/hypr-settings-menu lock",
            "logout": "~/.local/bin/hypr-settings-menu logout",
            "suspend": "~/.local/bin/hypr-settings-menu suspend",
            "reboot": "~/.local/bin/hypr-settings-menu reboot",
            "shutdown": "~/.local/bin/hypr-settings-menu shutdown"
        }
    }
}
