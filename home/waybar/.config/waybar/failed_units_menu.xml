<?xml version="1.0" encoding="UTF-8"?>
<!-- Menu for systemd-failed-units: hand the failures to Claude, or read them
     yourself. The ids are keys in that module's "menu-actions" in config.jsonc,
     which holds the command; hypr-failed-units owns what they do. -->
<interface>
  <object class="GtkMenu" id="menu">
    <child>
      <object class="GtkMenuItem" id="fix">
        <property name="label">Fix with Claude</property>
      </object>
    </child>
    <child>
      <object class="GtkMenuItem" id="log">
        <property name="label">Status and journal</property>
      </object>
    </child>
  </object>
</interface>
