# Cooper University servers
# Requires sshpass: pacman -S sshpass
# Password stored in ~/.ssh/jump_pass (gitignored, chmod 600)
# To set up: echo 'YOUR_PASSWORD' > ~/.ssh/jump_pass && chmod 600 ~/.ssh/jump_pass

Host ice
    HostName ice00.ee.cooper.edu
    Port 31415
    User jaeho.cho
    ConnectTimeout 10
    ServerAliveInterval 15
    ServerAliveCountMax 3

# Same lab, alternate host. Use this when ice00 is down. X2Go works on both
# since the Rocky 8 migration (ISSUES.md) -- ice00's old login env put the AFS
# ADS-2019 perl 5.22 ahead of the system perl, so x2golistsessions couldn't
# find X2Go::Server::DB; the rebuild cleared it. Verified 2026-09-01.
Host conway
    HostName conway.ee.cooper.edu
    Port 31415
    User jaeho.cho
    ConnectTimeout 10
    ServerAliveInterval 15
    ServerAliveCountMax 3

# Homelab (Nextcloud). Login asks for a TOTP code, so the
# first session is shared: later ssh/scp calls reuse it without prompting.
# ControlPath must NOT use %C: that hashes %h, so wonlab and wonhomelab.net
# open separate masters and each re-prompts. One literal path shares across
# both names and raider's ProxyJump. ControlPersist cannot survive suspend
# (hypridle sleeps at 30 min idle) -- after wake, TOTP again.
Host wonhomelab.net wonlab
    ControlMaster auto
    ControlPath /run/user/%i/ssh-wonhomelab
    ControlPersist 12h
    ServerAliveInterval 15
    ServerAliveCountMax 3

# Windows 11 laptop on the main-router 192.168.1.0/24 side of the double-NAT.
# ICMP is blocked; TCP/22 is open. Pubkey auth via administrators_authorized_keys.
# Default shell is cmd.exe — for non-interactive work, pipe PowerShell:
#   ssh msi 'powershell -NoProfile -Command -' <<'PS' ... PS
Host msi
    HostName 192.168.1.14
    User jaeho
    # Dual-boot with `raider` on the same IP: keep each OS's host key separate.
    HostKeyAlias msi
    ConnectTimeout 10
    ServerAliveInterval 15
    ServerAliveCountMax 3

# Same box as `msi`, Ubuntu side (MSI Raider dual-boot). Passwordless from
# wonlab; Ollama (Docker) on :11434. For nvim minuet:
#   ssh -N -L 21434:127.0.0.1:11434 raider
Host raider
    HostName 192.168.1.14
    User jaeho
    ProxyJump wonlab
    HostKeyAlias raider
    ConnectTimeout 10
    ServerAliveInterval 15
    ServerAliveCountMax 3
