# Cooper University servers
# Requires sshpass: pacman -S sshpass
# Password stored in ~/.ssh/jump_pass (gitignored, chmod 600)
# To set up: echo 'YOUR_PASSWORD' > ~/.ssh/jump_pass && chmod 600 ~/.ssh/jump_pass

Host ice
    HostName ice00.ee.cooper.edu
    Port 31415
    User jaeho.cho
    ConnectTimeout 10
    ServerAliveInterval 15
    ServerAliveCountMax 3

# Same lab, alternate host. Use this when ice00 is down. X2Go works on both
# since the Rocky 8 migration (ISSUES.md) -- ice00's old login env put the AFS
# ADS-2019 perl 5.22 ahead of the system perl, so x2golistsessions couldn't
# find X2Go::Server::DB; the rebuild cleared it. Verified 2026-09-01.
Host conway
    HostName conway.ee.cooper.edu
    Port 31415
    User jaeho.cho
    ConnectTimeout 10
    ServerAliveInterval 15
    ServerAliveCountMax 3

# Homelab (Nextcloud). Login asks for a TOTP code, so the
# first session is shared: later ssh/scp calls reuse it without prompting.
Host wonhomelab.net
    ControlMaster auto
    ControlPath /run/user/%i/ssh-%C
    ControlPersist 4h
    ServerAliveInterval 15
    ServerAliveCountMax 3
