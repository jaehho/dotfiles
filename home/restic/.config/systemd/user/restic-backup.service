[Unit]
Description=Restic backup to homelab Nextcloud
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# restic exit 3 = some source files couldn't be read (e.g. a file changed mid-backup);
# the snapshot is still saved, so don't mark the unit failed.
SuccessExitStatus=3
# Skip, don't fail, when the repo can't be reached: off the home network, or on
# the home subnet whose hairpin serves a snakeoil cert (curl rejects it). A
# failing ExecCondition leaves the unit inactive rather than failed, and
# ExecStopPost still runs (SERVICE_RESULT=exec-condition), so the stale-backup
# alarm below still counts it. The retries ride out DNS coming up after resume.
ExecCondition=/usr/bin/curl -sf -o /dev/null --max-time 10 \
    --retry 3 --retry-delay 5 --retry-all-errors --retry-max-time 60 \
    https://nextcloud.wonhomelab.net/status.php
Environment=RESTIC_REPOSITORY=rclone:nextcloud:Backups/restic
Environment=RESTIC_PASSWORD_FILE=%h/.config/restic/password
ExecStart=/usr/bin/restic backup \
    --exclude-file %h/.config/restic/excludes \
    --exclude %h/mnt \
    --one-file-system \
    --tag systemd.timer \
    --verbose \
    %h
ExecStart=/usr/bin/restic forget \
    --keep-daily 7 \
    --keep-weekly 4 \
    --keep-monthly 6 \
    --prune
# Records the success, or complains if there hasn't been one in two days.
ExecStopPost=%h/.local/bin/backup-outcome
