#!/usr/bin/env bash
# tablet-display on|off|toggle|status|state|audio: use the Galaxy Tab as a second screen.
#
# `on` starts Sunshine and opens the stream in Moonlight on the tablet. The
# headless Hyprland output exists only while a stream does: Sunshine runs
# `create` before it starts capturing (the Desktop app's prep command) and
# `remove` when the app ends. monitors.lua treats the output as any other
# external, so it sits right of the laptop and takes workspaces 2, 4, and so
# on; when it goes, the workspaces fall back to the laptop.
#
# The app's own command is `hold`, which exits when the client disconnects.
# Sunshine treats that as the app ending and runs `remove`, so pausing the
# stream closes the display and the next connect is a fresh launch (a resume
# would skip `create`, and capture would silently fall back to the laptop).
# `create` sizes the output from the client's request (Moonlight's resolution)
# through the SUNSHINE_CLIENT_WIDTH/HEIGHT variables Sunshine passes to prep
# commands. The refresh stays 60 whatever FPS the client asks for: Sunshine
# drops frames to the stream rate, and a 30 Hz desktop feels worse. After the
# mode lands it restarts hyprpaper: it paints on output add, will not repaint
# when the size changes, and an IPC set leaves that first surface up.
#
# Sunshine resolves output_name when capture starts, by name, and falls back
# to the first monitor if the name is missing. The name is read from
# sunshine.conf so the two cannot drift.
#
# Stream over USB tethering, not Tailscale. On a Wi-Fi that isolates clients,
# Tailscale falls back to a DERP relay, and a relayed stream glitches as soon as
# anything on screen moves. The USB link is direct and about 2 ms. Android drops
# tethering whenever the cable is replugged, so with USB debugging on and the
# laptop authorized, this turns it back on over adb (`svc usb setFunctions
# rndis`) and launches Moonlight's shortcut activity by PC and app name. Without
# adb it still works if tethering is already on; it then only warns.
#
# The tablet must be unlocked: a secure lock screen holds Moonlight behind it,
# so `on` wakes the screen and waits for the unlock instead of bypassing it.
#
# Sunshine is not enabled at login: it listens on every interface, so it runs
# only while this is on.
#
# Meant to run from a keybind, so it takes a lock (a second press while the
# first waits for an unlock does nothing), reports through notifications when
# there is no terminal, checks the tablet before starting anything, and undoes
# what it started if a later step fails. `toggle` turns it off whenever either
# half is up. `state` is for the display menu: on (streaming), ready (host up,
# Moonlight not showing), off, or starting while another run holds the lock;
# when off, a second line says why the tablet cannot be reached, if it cannot.
# `audio on|off|toggle|status` is whether Moonlight also plays the PC's sound
# (Sunshine `stream_audio`). Default off: the tablet is a display, not a second
# pair of speakers. The setting lives in sunshine.conf, which Sunshine reads
# only at startup, so changing it restarts the unit and drops any live stream;
# reconnect after. `create`, `remove` and `hold` are Sunshine's, not for typing.

set -uo pipefail

SUNSHINE_CONF="$HOME/.config/sunshine/sunshine.conf"
APPS_JSON="$HOME/.config/sunshine/apps.json"
UNIT=app-dev.lizardbyte.app.Sunshine.service
WEB_UI=https://localhost:47990
MOONLIGHT=com.limelight
DEFAULT_SIZE=1920x1080   # when a client sends no size (running `create` by hand)
REFRESH=60
READY_TIMEOUT=30    # seconds; the unit sleeps 5 before it starts Sunshine
UNLOCK_TIMEOUT=60   # seconds to wait for the tablet to be unlocked

# Terminal: print. Keybind: notify, since there is nowhere to read stderr.
say() {
    if [ -t 2 ]; then echo "tablet-display: $*" >&2; else notify-send -a tablet-display "Tablet display" "$*"; fi
}

STARTED=0   # this run started Sunshine

rollback() {
    [ "$STARTED" = 1 ] && systemctl --user stop "$UNIT"
    STARTED=0
}

die() { say "$*"; exit 1; }
# A failure after something was started: undo it.
fail() { rollback; die "$*"; }

LOCK="${XDG_RUNTIME_DIR:-/tmp}/tablet-display.lock"
lock() {
    exec 9>"$LOCK"
    flock -n 9 || die "already running"
}

# Read one key from sunshine.conf. Comments are skipped so the prose above
# cannot be mistaken for a setting.
conf_get() {
    awk -F'[[:space:]]*=[[:space:]]*' -v key="$1" \
        '$1 !~ /^#/ && $1 == key { print $2 }' "$SUNSHINE_CONF" 2>/dev/null | tail -1
}

# Write one key. Stow made the conf a symlink into the repo; edit the target
# so sed does not replace the link with a regular file.
conf_set() {
    local key=$1 value=$2 target
    target=$(readlink -f "$SUNSHINE_CONF") || die "cannot resolve $SUNSHINE_CONF"
    if grep -q "^${key} *=" "$target"; then
        sed -i "s|^${key} *=.*|${key} = ${value}|" "$target"
    else
        printf '%s = %s\n' "$key" "$value" >>"$target"
    fi
}

OUTPUT=$(conf_get output_name)
[ -n "$OUTPUT" ] || die "no output_name in $SUNSHINE_CONF"
# Moonlight lists the host under Sunshine's name (the hostname unless set) and
# the first app Sunshine offers.
PC_NAME=$(uname -n)
APP_NAME=$(jq -r '.apps[0].name' "$APPS_JSON" 2>/dev/null)
[ -n "$APP_NAME" ] && [ "$APP_NAME" != null ] || die "no app in $APPS_JSON"

output_exists() {
    # `all`: a mirrored output (Super+P) drops out of the plain listing.
    hyprctl monitors all -j 2>/dev/null | jq -e --arg n "$OUTPUT" 'any(.[]; .name == $n)' >/dev/null
}

sunshine_active() {
    systemctl --user is-active --quiet "$UNIT"
}

# IPv4 of each USB network interface (the tethered tablet). The tablet's own
# address is the link's gateway; Moonlight connects to the laptop's.
usb_addrs() {
    local dev
    for dev in /sys/class/net/*; do
        [[ "$(readlink -f "$dev/device" 2>/dev/null)" == */usb* ]] || continue
        ip -j -4 addr show dev "${dev##*/}" | jq -r '.[].addr_info[].local'
    done
}

tether_up() {
    [ -n "$(usb_addrs)" ]
}

# True when exactly one authorized tablet is attached over adb.
have_tablet() {
    command -v adb >/dev/null && [ "$(timeout 10 adb get-state 2>/dev/null)" = device ]
}

# Why the tablet cannot be reached, or nothing and success when it can: the
# tether link is up, or adb sees exactly one authorized device to turn it on.
tablet_problem() {
    local states
    tether_up && return 0
    command -v adb >/dev/null || { echo "USB tethering is off and adb is not installed"; return 1; }
    mapfile -t states < <(timeout 10 adb devices 2>/dev/null | awk 'NR > 1 && NF { print $2 }')
    case "${#states[@]}:${states[0]:-}" in
        1:device) return 0 ;;
        1:unauthorized) echo "approve USB debugging on the tablet, then try again"; return 1 ;;
        1:offline) echo "tablet is offline on adb; replug the cable"; return 1 ;;
        0:) if lsusb -d 04e8: >/dev/null 2>&1; then
                echo "tablet is plugged in but USB debugging is off; turn it on, or turn on USB tethering"
            else
                echo "tablet is not connected over USB"
            fi
            return 1 ;;
        *) echo "more than one adb device attached; unplug the others"; return 1 ;;
    esac
}

wait_for() {
    local what="$1" i
    shift
    for ((i = 0; i < READY_TIMEOUT * 4; i++)); do
        "$@" && return 0
        sleep 0.25
    done
    fail "$what did not come up within ${READY_TIMEOUT}s"
}

sunshine_ready() {
    curl -ks -o /dev/null --max-time 1 "$WEB_UI"
}

# adb drops while the USB function changes, so the command's exit status says
# nothing; the link coming up is the check.
enable_tether() {
    timeout 10 adb shell svc usb setFunctions rndis >/dev/null 2>&1
}

keyguard_showing() {
    timeout 10 adb shell dumpsys window 2>/dev/null | grep -q 'isKeyguardShowing=true'
}

moonlight_foreground() {
    timeout 10 adb shell dumpsys activity activities 2>/dev/null | grep -m1 topResumedActivity | grep -q "$MOONLIGHT"
}

launch_moonlight() {
    local i
    timeout "$READY_TIMEOUT" adb wait-for-device || { say "tablet did not come back on adb"; return 1; }
    timeout 10 adb shell input keyevent KEYCODE_WAKEUP
    for ((i = 0; i < UNLOCK_TIMEOUT; i++)); do
        keyguard_showing || break
        [ "$i" = 0 ] && say "unlock the tablet"
        sleep 1
    done
    if keyguard_showing; then
        say "tablet still locked; open $APP_NAME on $PC_NAME in Moonlight yourself"
        return 1
    fi
    timeout 10 adb shell am start -n "$MOONLIGHT/.ShortcutTrampoline" --es Name "$PC_NAME" --es AppName "$APP_NAME" 2>&1 |
        grep -q '^Error' && { say "Moonlight did not start on the tablet"; return 1; }
    return 0
}

report_address() {
    local addrs
    addrs=$(usb_addrs)
    if [ -n "$addrs" ]; then
        echo "Moonlight host $(echo "$addrs" | paste -sd' ')"
    else
        echo "no USB tether link, so Moonlight goes through Tailscale and glitches on motion"
    fi
}

# monitors.lua hears of a headless output only from here (it fires no event).
# Its layout then covers the tablet, and a turned-off state cannot outlive it.
sync_layout() {
    hyprctl eval "require(\"monitors\").forget(\"$OUTPUT\")" >/dev/null 2>&1
}

cmd_on() {
    local adb_ok=0 problem
    hyprctl version >/dev/null 2>&1 || die "Hyprland is not running"
    # Check the tablet before creating anything.
    problem=$(tablet_problem) || die "$problem"
    # Start the tether switch first; it takes about as long as Sunshine does.
    if have_tablet; then
        adb_ok=1
        tether_up || enable_tether
    fi

    if ! sunshine_active; then
        STARTED=1
        systemctl --user start "$UNIT" || fail "could not start $UNIT (is another Sunshine running?)"
    fi
    wait_for Sunshine sunshine_ready

    if [ "$adb_ok" = 1 ]; then
        wait_for "USB tether link" tether_up
        launch_moonlight
    fi
    say "on: $(report_address)"
}

# Wallpaper at the final mode. hyprpaper paints when the output appears, before
# `mode`/`scale` land, and does not repaint on a mode change, so the image stays
# at the create-time size in the top-left. An IPC set draws a full cover but
# leaves that first surface up. Restart hyprpaper once the output is at its
# client size; the next paint is a single cover at that size. Cosmetic, so a
# restart failure must not fail the stream.
apply_wallpaper() {
    pkill -x hyprpaper 2>/dev/null
    sleep 0.2
    setsid hyprpaper >/dev/null 2>&1 </dev/null &
    return 0
}

# Sunshine's prep `do`: runs before capture starts, so the output must exist
# and have its mode when this returns.
cmd_create() {
    local size="${SUNSHINE_CLIENT_WIDTH:-}x${SUNSHINE_CLIENT_HEIGHT:-}"
    [ "$size" = x ] && size=$DEFAULT_SIZE
    output_exists && hyprctl output remove "$OUTPUT" >/dev/null 2>&1
    hyprctl output create headless "$OUTPUT" >/dev/null || die "could not create output $OUTPUT"
    wait_for "output $OUTPUT" output_exists
    hyprctl eval "hl.monitor({ output = \"$OUTPUT\", mode = \"$size@$REFRESH\", position = \"auto\", scale = \"auto\" })" >/dev/null ||
        die "could not set $OUTPUT to $size@$REFRESH"
    # Wait for the mode to land so hyprpaper paints at the client size.
    wait_for "output $OUTPUT at $size" size_ready
    sync_layout
    apply_wallpaper
}

# True when the output has the client mode's physical size.
size_ready() {
    local w=${size%x*} h=${size#*x}
    hyprctl monitors -j 2>/dev/null | jq -e --arg n "$OUTPUT" --argjson w "$w" --argjson h "$h" \
        'any(.[]; .name == $n and .width == $w and .height == $h)' >/dev/null
}

# Sunshine's prep `undo`, also run when Sunshine stops.
cmd_remove() {
    if output_exists; then
        hyprctl output remove "$OUTPUT" >/dev/null 2>&1
        sync_layout
    fi
}

# Sunshine's app command. It exits when the client disconnects, which Sunshine
# takes as the app ending. Exiting within 5 s with status 0 would make
# Sunshine treat the app as detached and keep it, so it never exits that early.
# It also closes the display itself, since Sunshine only reaps the app lazily.
cmd_hold() {
    local start=$SECONDS line fd jpid
    exec {fd}< <(exec journalctl --user -u "$UNIT" -f -n 0 -o cat)
    jpid=$!
    while read -r line <&"$fd"; do
        [[ $line == *"CLIENT DISCONNECTED"* ]] && break
    done
    kill "$jpid" 2>/dev/null
    while ((SECONDS - start < 6)); do sleep 1; done
    # Sunshine notices the exit only when something next asks it (a client
    # connecting), so it would run `remove` late. Remove now; `remove` is idempotent.
    cmd_remove
}

cmd_off() {
    sunshine_active && systemctl --user stop "$UNIT"
    if output_exists; then
        hyprctl output remove "$OUTPUT" >/dev/null || die "could not remove output $OUTPUT"
        sync_layout
    fi
    say off
}

cmd_toggle() {
    if output_exists || sunshine_active; then cmd_off; else cmd_on; fi
}

# Sunshine defaults stream_audio to on when the key is missing; the conf
# spells it out. "on" means the tablet plays the PC's sound.
stream_audio_on() {
    [ "$(conf_get stream_audio)" != "disabled" ]
}

cmd_status() {
    if output_exists; then
        hyprctl monitors all -j | jq -r --arg n "$OUTPUT" '.[] | select(.name == $n) | "output: \(.name) \(.width)x\(.height)@\(.refreshRate | floor)"'
    else
        echo "output: none"
    fi
    if sunshine_active; then echo "sunshine: running"; else echo "sunshine: stopped"; fi
    if have_tablet; then echo "tablet: adb ready"; else echo "tablet: no adb"; fi
    if stream_audio_on; then echo "stream-audio: on"; else echo "stream-audio: off"; fi
    report_address
}

cmd_state() {
    exec 8>"$LOCK"
    if ! flock -n 8; then echo starting; return; fi
    if output_exists || sunshine_active; then
        # The host being up is not the stream being on: Moonlight has to be
        # in front on the tablet, which only adb can see.
        if have_tablet && moonlight_foreground; then echo on; else echo ready; fi
    else
        echo off
        tablet_problem
    fi
    return 0
}

# `audio` is a preference, not a stream control, so it does not take the
# flock: reading `status` while `on` waits for an unlock must not die.
cmd_audio() {
    local want=$1 current
    if stream_audio_on; then current=on; else current=off; fi
    case "$want" in
        status)
            echo "$current"
            return 0
            ;;
        toggle)
            if [ "$current" = on ]; then want=off; else want=on; fi
            ;;
        on|off) ;;
        *) die "usage: tablet-display audio on|off|toggle|status" ;;
    esac
    [ "$want" = "$current" ] && { say "stream audio already $want"; return 0; }

    if [ "$want" = on ]; then
        conf_set stream_audio enabled
    else
        conf_set stream_audio disabled
    fi

    # Sunshine reads sunshine.conf only at startup. Restarting is the only way
    # to make the new value real before the next client connects; a live stream
    # does not survive it (prep `undo` tears the output down).
    if sunshine_active; then
        systemctl --user restart "$UNIT" || die "could not restart $UNIT"
        say "stream audio $want; reconnect the stream"
    else
        say "stream audio $want"
    fi
}

case "${1:-status}" in
    on) lock; cmd_on ;;
    create) cmd_create ;;
    remove) cmd_remove ;;
    hold) cmd_hold ;;
    off) lock; cmd_off ;;
    toggle) lock; cmd_toggle ;;
    status) cmd_status ;;
    state) cmd_state ;;
    audio) cmd_audio "${2:-status}" ;;
    *) die "usage: tablet-display on|off|toggle|status|state|audio on|off|toggle|status" ;;
esac
