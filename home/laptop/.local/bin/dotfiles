#!/usr/bin/env bash
# dotfiles: this repo, by hand.
#
#   dotfiles           status: what would apply change?
#   dotfiles apply     stow + user units (the usual command)
#   dotfiles apply -s  system half (/etc, boot copies); needs sudo
#   dotfiles all       system then user; needs sudo (bootstrap)
#   dotfiles status    same as bare
#   dotfiles help      this text
#
# Packages are yours: `paru -Syu` to upgrade, manifests under packages/ are
# only the bootstrap shopping list. New machine: sudo scripts/bootstrap.sh

set -euo pipefail

export PATH="$HOME/.local/bin:$PATH"

DOTFILES="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../../../.." && pwd)"
APPLY="$DOTFILES/scripts/apply.sh"
STATUS="$DOTFILES/scripts/status.sh"

case "${1:-status}" in
  status|"") exec bash "$STATUS" ;;
  apply)
    shift
    case "${1:-}" in
      -s|system) exec bash "$APPLY" system ;;
      *)         exec bash "$APPLY" user ;;
    esac ;;
  all) exec bash "$APPLY" all ;;
  help|-h|--help)
    sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac
