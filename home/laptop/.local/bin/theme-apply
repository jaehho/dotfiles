#!/bin/bash
# theme-apply — read ~/.config/theme/palette and propagate colors everywhere.
#
# Every sink is a generated include (kitty, hypr, rofi, fish, tmux, nvim,
# waybar, swaync). No sed, no snapshot maps. Apps that can @import/include
# pull the include; theme-apply writes, stows, and reloads.
#
#   theme-apply           write generated files, stow, reload if anything changed
#   theme-apply --dry-run show what would change; write nothing
#   theme-apply --check   like --dry-run; exit 1 if anything is out of date

set -euo pipefail

PALETTE="${XDG_CONFIG_HOME:-$HOME/.config}/theme/palette"
DOTFILES="${DOTFILES:-$HOME/dotfiles}"

MODE=write
case "${1:-}" in
  '') ;;
  --dry-run) MODE=dry-run ;;
  --check) MODE=check ;;
  -h|--help)
    sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
    ;;
  *)
    echo "usage: theme-apply [--dry-run|--check]" >&2
    exit 2
    ;;
esac

if [[ ! -f "$PALETTE" ]]; then
  echo "No palette found at $PALETTE" >&2
  exit 1
fi

# ── Load palette ─────────────────────────────────────────────────────────────
declare -A C
while IFS='=' read -r key val; do
  [[ -z "$key" || "$key" =~ ^# ]] && continue
  C[$key]="$val"
done < "$PALETTE"

ROLES=(base mantle crust text subtext1 subtext0 surface0 surface1 surface2
       overlay0 overlay1 overlay2 blue lavender sapphire sky teal green
       yellow peach maroon red mauve pink flamingo rosewater)

for r in "${ROLES[@]}"; do
  if [[ -z "${C[$r]:-}" ]]; then
    echo "Missing color: $r" >&2; exit 1
  fi
done

hex() { echo "#${C[$1]}"; }

# rgba <role> <alpha 0-1> → rgba(r, g, b, a)
rgba() {
  local h="${C[$1]}" a="$2"
  local r=$((16#${h:0:2})) g=$((16#${h:2:2})) b=$((16#${h:4:2}))
  echo "rgba($r, $g, $b, $a)"
}

echo "Applying palette: $(head -1 "$PALETTE" | sed 's/^# *//')"
if [[ "$MODE" != write ]]; then
  echo "Mode: $MODE (no writes)"
fi

# ── Emit helpers ─────────────────────────────────────────────────────────────
CHANGED=0
UNCHANGED=0

# emit <dest>  (content on stdin)
# Writes when MODE=write and content differs; always reports the outcome.
# Always returns 0 so `set -e` does not treat "same" as a failure.
emit() {
  local dest="$1" rel tmp
  rel="${dest#"$DOTFILES/"}"
  tmp="$(mktemp)"
  cat > "$tmp"

  if [[ -f "$dest" ]] && cmp -s "$tmp" "$dest"; then
    rm -f "$tmp"
    printf '  %-42s same\n' "$rel"
    UNCHANGED=$((UNCHANGED + 1))
    return 0
  fi

  if [[ "$MODE" == write ]]; then
    # mktemp is 0600; generated includes stay 0644 like the rest of the repo.
    chmod 644 "$tmp"
    mv "$tmp" "$dest"
    printf '  %-42s wrote\n' "$rel"
  else
    rm -f "$tmp"
    printf '  %-42s would write\n' "$rel"
  fi
  CHANGED=$((CHANGED + 1))
  return 0
}

# ── 1. Kitty ─────────────────────────────────────────────────────────────────
emit "$DOTFILES/home/kitty/.config/kitty/colors.conf" << EOF
# Generated by theme-apply — do not edit
foreground              $(hex text)
background              $(hex base)
selection_foreground     $(hex base)
selection_background     $(hex rosewater)
cursor                  $(hex rosewater)
cursor_text_color       $(hex base)
url_color               $(hex blue)

# Tabs
active_tab_foreground   $(hex crust)
active_tab_background   $(hex mauve)
inactive_tab_foreground $(hex text)
inactive_tab_background $(hex surface0)

# Marks
mark1_foreground $(hex base)
mark1_background $(hex lavender)

# ANSI colors
color0  $(hex surface1)
color8  $(hex overlay0)
color1  $(hex red)
color9  $(hex red)
color2  $(hex green)
color10 $(hex green)
color3  $(hex yellow)
color11 $(hex yellow)
color4  $(hex blue)
color12 $(hex blue)
color5  $(hex pink)
color13 $(hex pink)
color6  $(hex teal)
color14 $(hex teal)
color7  $(hex subtext0)
color15 $(hex subtext1)
EOF

# ── 2. Hyprland ──────────────────────────────────────────────────────────────
# Only the four colors the config actually references.
emit "$DOTFILES/home/hypr/.config/hypr/colors.lua" << EOF
-- Generated by theme-apply — do not edit
return {
    active_1 = "rgba(${C[blue]}ee)",
    active_2 = "rgba(${C[green]}ee)",
    inactive = "rgba(${C[surface1]}ab)",
    shadow   = "rgba(${C[crust]}ee)",
}
EOF

# ── 3. Rofi ──────────────────────────────────────────────────────────────────
emit "$DOTFILES/home/rofi/.config/rofi/colors.rasi" << EOF
/* Generated by theme-apply — do not edit */
* {
  rosewater: $(hex rosewater);
  flamingo: $(hex flamingo);
  pink: $(hex pink);
  mauve: $(hex mauve);
  red: $(hex red);
  maroon: $(hex maroon);
  peach: $(hex peach);
  yellow: $(hex yellow);
  green: $(hex green);
  teal: $(hex teal);
  sky: $(hex sky);
  sapphire: $(hex sapphire);
  blue: $(hex blue);
  lavender: $(hex lavender);
  text: $(hex text);
  subtext1: $(hex subtext1);
  subtext0: $(hex subtext0);
  overlay2: $(hex overlay2);
  overlay1: $(hex overlay1);
  overlay0: $(hex overlay0);
  surface2: $(hex surface2);
  surface1: $(hex surface1);
  surface0: $(hex surface0);
  base: $(hex base);
  mantle: $(hex mantle);
  crust: $(hex crust);

  /* translucent variants — let the Hyprland rofi-blur layer rule show through */
  base-blur: $(hex base)d9;
  surface0-blur: $(hex surface0)e6;
}
EOF

# ── 4. Fish ──────────────────────────────────────────────────────────────────
emit "$DOTFILES/home/fish/.config/fish/conf.d/theme_colors.fish" << EOF
# Generated by theme-apply — do not edit
set -g thm_blue ${C[blue]}
set -g thm_overlay ${C[subtext0]}
set -g thm_yellow ${C[yellow]}
set -g thm_green ${C[green]}
set -g thm_red ${C[red]}
EOF

# ── 5. Tmux ──────────────────────────────────────────────────────────────────
emit "$DOTFILES/home/theme/.config/theme/tmux-colors.conf" << EOF
# Generated by theme-apply — do not edit
# @thm_* color vars for the hand-rolled status bar (see tmux/.tmux.conf)
set -gq @thm_bg "$(hex base)"
set -gq @thm_fg "$(hex text)"
set -gq @thm_rosewater "$(hex rosewater)"
set -gq @thm_flamingo "$(hex flamingo)"
set -gq @thm_pink "$(hex pink)"
set -gq @thm_mauve "$(hex mauve)"
set -gq @thm_red "$(hex red)"
set -gq @thm_maroon "$(hex maroon)"
set -gq @thm_peach "$(hex peach)"
set -gq @thm_yellow "$(hex yellow)"
set -gq @thm_green "$(hex green)"
set -gq @thm_teal "$(hex teal)"
set -gq @thm_sky "$(hex sky)"
set -gq @thm_sapphire "$(hex sapphire)"
set -gq @thm_blue "$(hex blue)"
set -gq @thm_lavender "$(hex lavender)"
set -gq @thm_subtext_1 "$(hex subtext0)"
set -gq @thm_subtext_0 "$(hex subtext1)"
set -gq @thm_overlay_2 "$(hex overlay2)"
set -gq @thm_overlay_1 "$(hex overlay1)"
set -gq @thm_overlay_0 "$(hex overlay0)"
set -gq @thm_surface_2 "$(hex surface2)"
set -gq @thm_surface_1 "$(hex surface1)"
set -gq @thm_surface_0 "$(hex surface0)"
set -gq @thm_mantle "$(hex mantle)"
set -gq @thm_crust "$(hex crust)"
EOF

# ── 6. Nvim — base16 palette table for mini.base16 ──────────────────────────
# base00-07 = bg→fg ramp, base08-0F = accents (base16 standard slots).
mkdir -p "$DOTFILES/home/nvim/.config/nvim/lua"
emit "$DOTFILES/home/nvim/.config/nvim/lua/theme_colors.lua" << EOF
-- Generated by theme-apply — do not edit
-- base16 palette consumed by mini.base16 (see nvim/init.lua)
return {
  base00 = "$(hex base)", -- default background
  base01 = "$(hex surface0)", -- lighter bg (status, line highlight)
  base02 = "$(hex surface1)", -- selection background
  base03 = "$(hex overlay0)", -- comments, invisibles
  base04 = "$(hex overlay2)", -- dark foreground (line numbers)
  base05 = "$(hex text)", -- default foreground
  base06 = "$(hex subtext1)", -- light foreground
  base07 = "$(hex subtext0)", -- lightest (rarely used)
  base08 = "$(hex red)", -- variables, errors
  base09 = "$(hex peach)", -- constants, numbers
  base0A = "$(hex yellow)", -- classes, search
  base0B = "$(hex green)", -- strings
  base0C = "$(hex teal)", -- support, regex
  base0D = "$(hex blue)", -- functions
  base0E = "$(hex mauve)", -- keywords
  base0F = "$(hex maroon)", -- deprecated, brackets
}
EOF

# ── 7. Waybar — GTK @define-color include (style.css @imports it) ────────────
# load-* must stay literal hex: scripts/load.py greps these lines.
emit "$DOTFILES/home/waybar/.config/waybar/colors.css" << EOF
/* Generated by theme-apply — do not edit */
@define-color base $(hex base);
@define-color mantle $(hex mantle);
@define-color crust $(hex crust);
@define-color text $(hex text);
@define-color subtext1 $(hex subtext1);
@define-color subtext0 $(hex subtext0);
@define-color surface0 $(hex surface0);
@define-color surface1 $(hex surface1);
@define-color surface2 $(hex surface2);
@define-color overlay0 $(hex overlay0);
@define-color overlay1 $(hex overlay1);
@define-color overlay2 $(hex overlay2);
@define-color blue $(hex blue);
@define-color lavender $(hex lavender);
@define-color sapphire $(hex sapphire);
@define-color sky $(hex sky);
@define-color teal $(hex teal);
@define-color green $(hex green);
@define-color yellow $(hex yellow);
@define-color peach $(hex peach);
@define-color maroon $(hex maroon);
@define-color red $(hex red);
@define-color mauve $(hex mauve);
@define-color pink $(hex pink);
@define-color flamingo $(hex flamingo);
@define-color rosewater $(hex rosewater);

/* Alpha steps used by style.css (island, pills, hairlines) */
@define-color base-88 $(rgba base 0.88);
@define-color blue-14 $(rgba blue 0.14);
@define-color blue-18 $(rgba blue 0.18);
@define-color blue-28 $(rgba blue 0.28);
@define-color red-14 $(rgba red 0.14);
@define-color pink-14 $(rgba pink 0.14);

/* load.py greps load-* hex from this file */
@define-color load-calm $(hex subtext0);
@define-color load-warn $(hex yellow);
@define-color load-alert $(hex red);
@define-color load-cpu $(hex mauve);
@define-color load-ram $(hex teal);
@define-color load-gpu $(hex blue);
@define-color load-track $(hex surface2);
@define-color load-dim $(hex overlay0);
EOF

# ── 8. Swaync — CSS custom properties (style.css @imports it) ────────────────
emit "$DOTFILES/home/swaync/.config/swaync/colors.css" << EOF
/* Generated by theme-apply — do not edit */
:root {
  --base: $(hex base);
  --mantle: $(hex mantle);
  --crust: $(hex crust);
  --text: $(hex text);
  --subtext1: $(hex subtext1);
  --subtext0: $(hex subtext0);
  --surface0: $(hex surface0);
  --surface1: $(hex surface1);
  --surface2: $(hex surface2);
  --overlay0: $(hex overlay0);
  --overlay1: $(hex overlay1);
  --overlay2: $(hex overlay2);
  --blue: $(hex blue);
  --lavender: $(hex lavender);
  --sapphire: $(hex sapphire);
  --sky: $(hex sky);
  --teal: $(hex teal);
  --green: $(hex green);
  --yellow: $(hex yellow);
  --peach: $(hex peach);
  --maroon: $(hex maroon);
  --red: $(hex red);
  --mauve: $(hex mauve);
  --pink: $(hex pink);
  --flamingo: $(hex flamingo);
  --rosewater: $(hex rosewater);
}
EOF

# ── Re-stow packages with generated files ────────────────────────────────────
# --no-folding matches scripts/converge.sh; without it stow collapses a fully-owned
# directory into a single dir symlink, which then diverges from what sync makes.
if [[ "$MODE" == write ]]; then
  echo "Stow..."
  if stow -d "$DOTFILES/home" -t "$HOME" -R --no-folding \
      hypr kitty rofi nvim theme swaync waybar fish 2>/dev/null; then
    echo "  stow ok"
  else
    echo "  stow failed" >&2
  fi
fi

# ── Reload running services (only when something was written) ────────────────
if [[ "$MODE" != write ]]; then
  echo
  if [[ "$CHANGED" -eq 0 ]]; then
    echo "All generated files up to date."
  else
    echo "$CHANGED file(s) out of date."
  fi
  if [[ "$MODE" == check && "$CHANGED" -gt 0 ]]; then
    exit 1
  fi
  exit 0
fi

if [[ "$CHANGED" -eq 0 ]]; then
  echo
  echo "Nothing to reload."
  exit 0
fi

echo
echo "Reloading..."
reload_fail=0

reload() {
  local name="$1" ok="$2"
  if [[ "$ok" == 0 ]]; then
    printf '  %-12s ok\n' "$name"
  else
    printf '  %-12s failed\n' "$name"
    reload_fail=1
  fi
}

skip() {
  printf '  %-12s skip (%s)\n' "$1" "$2"
}

# Hyprland + waybar CSS + swaync
if pgrep -x Hyprland >/dev/null 2>&1; then
  if hyprctl reload >/dev/null 2>&1; then
    reload hyprland 0
  else
    reload hyprland 1
  fi

  # waybar reloads on style.css change (reload_style_on_change). Touch the
  # stylesheet after colors.css so the watcher fires even if it does not
  # follow @import. Do not restart the bar.
  if pgrep -x waybar >/dev/null 2>&1; then
    touch "$HOME/.config/waybar/style.css" 2>/dev/null || true
    reload waybar 0
  else
    skip waybar "not running"
  fi

  if pgrep -x swaync >/dev/null 2>&1; then
    if swaync-client -rs >/dev/null 2>&1; then
      reload swaync 0
    else
      reload swaync 1
    fi
  else
    skip swaync "not running"
  fi
else
  skip hyprland "not running"
  skip waybar "not running"
  skip swaync "not running"
fi

# Kitty remote control
kitty_n=0
kitty_fail=0
for sock in /tmp/kitty-*; do
  [[ -e "$sock" ]] || continue
  if kitty @ --to "unix:$sock" set-colors --all --configured \
      "$HOME/.config/kitty/colors.conf" >/dev/null 2>&1; then
    kitty_n=$((kitty_n + 1))
  else
    kitty_fail=$((kitty_fail + 1))
  fi
done
if [[ "$kitty_n" -eq 0 && "$kitty_fail" -eq 0 ]]; then
  skip kitty "not running"
elif [[ "$kitty_fail" -eq 0 ]]; then
  reload kitty 0
else
  printf '  %-12s %d ok, %d failed\n' kitty "$kitty_n" "$kitty_fail"
  reload_fail=1
fi

# tmux
if tmux list-sessions >/dev/null 2>&1; then
  if tmux source-file "$HOME/.tmux.conf" >/dev/null 2>&1; then
    reload tmux 0
  else
    reload tmux 1
  fi
else
  skip tmux "not running"
fi

# Neovim sockets (mini.base16 re-setup; config.diff_hl re-applies via hook)
nvim_n=0
nvim_fail=0
while IFS= read -r -d '' addr; do
  if nvim --server "$addr" --remote-send \
      ":lua package.loaded.theme_colors=nil require('mini.base16').setup{palette=require('theme_colors'),use_cterm=true}<CR>" \
      >/dev/null 2>&1; then
    nvim_n=$((nvim_n + 1))
  else
    nvim_fail=$((nvim_fail + 1))
  fi
done < <(find /run/user/"$(id -u)"/ /tmp/ -name 'nvim.*' -type s -print0 2>/dev/null)
if [[ "$nvim_n" -eq 0 && "$nvim_fail" -eq 0 ]]; then
  skip nvim "not running"
elif [[ "$nvim_fail" -eq 0 ]]; then
  reload nvim 0
else
  printf '  %-12s %d ok, %d failed\n' nvim "$nvim_n" "$nvim_fail"
  reload_fail=1
fi

echo
if [[ "$reload_fail" -ne 0 ]]; then
  echo "Done with reload failures."
  exit 1
fi
echo "Done."
