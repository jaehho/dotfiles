#!/usr/bin/env fish
# Expand a bare GitHub issue ref (owner/repo#123 or #123) and open it.
# Used by kitty open-actions.conf after detect_url_regex.
set ref $argv[1]
if test -z "$ref"
    exit 1
end

if string match -rq '^(?<owner>[^/]+)/(?<repo>[^#]+)#(?<n>[0-9]+)$' -- $ref
    xdg-open "https://github.com/$owner/$repo/issues/$n"
else if string match -rq '^#(?<n>[0-9]+)$' -- $ref
    # Bare #123 in Claude / this dotfiles session defaults to jaehho/dotfiles.
    xdg-open "https://github.com/jaehho/dotfiles/issues/$n"
else
    xdg-open $ref
end
