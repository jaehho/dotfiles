#!/usr/bin/env python
"""Log which D-Bus client opens each Secret Service session.

gnome-keyring 51.1 aborts in OpenSession when it has no client record
for the caller (gnome-keyring#190, #206). The restarted daemon comes up
with the login keyring locked, and the next lookup asks for the
password. The core dump names the caller only by its unique bus name
(`caller` in service_method_open_session), which is gone by the time
anyone looks.

This monitor writes one line per OpenSession call with that name, the
caller's pid and command line, and its parent's. When the caller
disconnects, it writes how long after the open that was. It also logs
owner changes of org.freedesktop.secrets, so the order of the lines
around a crash shows whether the client hung up before the daemon died
(the disconnect theory, #194 and #199) or after it (the registration
race, #206).

The match rules cover OpenSession and NameOwnerChanged only, so no
call or reply carrying a secret reaches this process. Of the
OpenSession body only the algorithm name is read.

    journalctl --user -u secret-service-log
"""

import shlex
import sys
import time
from typing import NamedTuple

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib  # noqa: E402

SECRETS_NAME = "org.freedesktop.secrets"
MATCH_RULES = [
    "type='method_call',interface='org.freedesktop.Secret.Service',"
    "member='OpenSession'",
    "type='signal',sender='org.freedesktop.DBus',"
    "interface='org.freedesktop.DBus',member='NameOwnerChanged'",
]
CMD_LIMIT = 200


class Process(NamedTuple):
    """A process's command line and its parent's, as log text."""

    cmd: str
    parent_cmd: str


def command_text(proc_dir: str, *, limit: int = CMD_LIMIT) -> str:
    """Return the shell-quoted command line in proc_dir.

    An exited process reads as "?". Text over limit is cut with "…".
    """
    try:
        with open(f"{proc_dir}/cmdline", "rb") as f:
            raw = f.read()
    except OSError:
        return "?"
    args = [a.decode(errors="replace") for a in raw.split(b"\0") if a]
    text = shlex.join(args) if args else "?"
    return text if len(text) <= limit else text[: limit - 1] + "…"


def parent_pid(proc_dir: str) -> int:
    """Return the parent pid in proc_dir/stat.

    Raises OSError if the process has exited.
    """
    with open(f"{proc_dir}/stat") as f:
        stat = f.read()
    # The command name in parentheses may hold spaces; ppid is the
    # second field after the last ")".
    return int(stat.rsplit(")", 1)[1].split()[1])


def describe_process(pid: int, *, proc: str = "/proc") -> Process:
    """Return pid's command line and its parent's, read from proc."""
    proc_dir = f"{proc}/{pid}"
    try:
        parent_cmd = command_text(f"{proc}/{parent_pid(proc_dir)}")
    except OSError:
        parent_cmd = "?"
    return Process(command_text(proc_dir), parent_cmd)


def connection_pid(bus: Gio.DBusConnection, name: str) -> int:
    """Return the pid behind a unique bus name.

    Raises GLib.Error if the name has left the bus.
    """
    reply = bus.call_sync(
        "org.freedesktop.DBus",
        "/org/freedesktop/DBus",
        "org.freedesktop.DBus",
        "GetConnectionUnixProcessID",
        GLib.Variant("(s)", (name,)),
        GLib.VariantType("(u)"),
        Gio.DBusCallFlags.NONE,
        1000,
        None,
    )
    return reply.unpack()[0]


def become_monitor(rules: list[str]) -> Gio.DBusConnection:
    """Open a private session-bus connection that monitors rules."""
    address = Gio.dbus_address_get_for_bus_sync(Gio.BusType.SESSION)
    monitor = Gio.DBusConnection.new_for_address_sync(
        address,
        Gio.DBusConnectionFlags.AUTHENTICATION_CLIENT
        | Gio.DBusConnectionFlags.MESSAGE_BUS_CONNECTION,
        None,
        None,
    )
    # The bus closes a monitor connection on any error; exit then
    # instead of idling on a dead connection.
    monitor.set_exit_on_close(True)
    return monitor


def main() -> int:
    sys.stdout.reconfigure(line_buffering=True)
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    monitor = become_monitor(MATCH_RULES)
    opened_at: dict[str, float] = {}

    def on_open(name: str, algorithm: str, at: float) -> bool:
        opened_at.setdefault(name, at)
        try:
            pid = connection_pid(bus, name)
        except GLib.Error:
            print(f"open {name} {algorithm} pid=? (left before lookup)")
            return GLib.SOURCE_REMOVE
        process = describe_process(pid)
        print(
            f"open {name} {algorithm} pid={pid} cmd={process.cmd}"
            f" parent={process.parent_cmd}"
        )
        return GLib.SOURCE_REMOVE

    def on_owner_change(name: str, old: str, new: str, at: float) -> bool:
        if name == SECRETS_NAME:
            print(f"owner {SECRETS_NAME} {old or '-'} -> {new or '-'}")
        elif not new and name in opened_at:
            ms = (at - opened_at.pop(name)) * 1000
            print(f"gone {name} {ms:.0f} ms after open")
        return GLib.SOURCE_REMOVE

    # GDBus runs filters on its worker thread, where a blocking call
    # would deadlock, so each message is handed to the main loop.
    # Same-priority idles run in order, so lines keep bus order.
    # Returning None drops a message: the monitored ones are dropped
    # so GDBus never answers them (the bus disconnects a monitor that
    # sends anything), while our own BecomeMonitor call and its reply
    # must go through.
    def on_message(conn, msg, incoming):
        at = time.monotonic()
        kind = msg.get_message_type()
        member = msg.get_member()
        if not incoming:
            return msg
        if kind == Gio.DBusMessageType.METHOD_CALL and (
            member == "OpenSession"
        ):
            algorithm = msg.get_body().get_child_value(0).get_string()
            GLib.idle_add(on_open, msg.get_sender(), algorithm, at)
            return None
        if kind == Gio.DBusMessageType.SIGNAL and (
            member == "NameOwnerChanged"
        ):
            name, old, new = msg.get_body().unpack()
            GLib.idle_add(on_owner_change, name, old, new, at)
            return None
        return msg

    monitor.add_filter(on_message)
    monitor.call_sync(
        "org.freedesktop.DBus",
        "/org/freedesktop/DBus",
        "org.freedesktop.DBus.Monitoring",
        "BecomeMonitor",
        GLib.Variant("(asu)", (MATCH_RULES, 0)),
        None,
        Gio.DBusCallFlags.NONE,
        -1,
        None,
    )
    GLib.MainLoop().run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
