# Everforest Dark Medium: a hand recolor of the Catppuccin Mocha port
# (catppuccin/imv) with sainnhe/everforest palette.md.
[options]
background=343431
overlay_text_color=d3c6aa
overlay_background_color=292927

[binds]
# h/l step through images like the arrow keys; horizontal pan moves
# to H/L, and j/k still pan vertically.
h = prev
l = next
<Shift+H> = pan 50 0
<Shift+L> = pan -50 0
