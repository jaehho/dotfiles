{
  "zotero": {
    "command": "uvx",
    "args": ["--from", "zotero-mcp-server[all]", "zotero-mcp"],
    "env": {
      "ZOTERO_API_KEY": "${ZOTERO_API_KEY}",
      "ZOTERO_LIBRARY_ID": "${ZOTERO_LIBRARY_ID}",
      "ZOTERO_LIBRARY_TYPE": "user"
    }
  },
  "obsidian": {
    "type": "http",
    "url": "http://127.0.0.1:27123/mcp/",
    "headers": {
      "Authorization": "Bearer ${OBSIDIAN_API_KEY}"
    }
  }
}
