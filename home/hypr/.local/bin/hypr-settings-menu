#!/usr/bin/env bash
# Quick settings menu via rofi — central hub for system GUIs

choice=$(printf '%s\n' \
    "󰤨  Wi-Fi" \
    "󰂯  Bluetooth" \
    "󰕾  Audio" \
    "󰸉  Wallpaper" \
    | rofi -dmenu -p "Settings" -theme-str 'listview { lines: 4; }')

[[ -z "$choice" ]] && exit 0

tui() { kitty --class floating-tui -e "$@"; }

case "$choice" in
    *Wi-Fi*)       tui nmtui ;;
    *Bluetooth*)   tui bluetui ;;
    *Audio*)       tui wiremix ;;
    *Wallpaper*)   paperboy gui & ;;
esac
