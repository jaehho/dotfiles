#!/usr/bin/env python3
"""hypr-settings-menu — the quick settings table.

Every entry is one row in ITEMS. The bar's quick settings sheet lists them
(`hypr-settings-menu --json`) and runs them (`hypr-settings-menu <id>`), as
do the bar glyphs' clicks, so a command lives in exactly one place. An
entry whose tool is not installed is left out, not broken. With no
argument it opens the sheet on the focused monitor (Super + ;).
"""

from concurrent.futures import ThreadPoolExecutor
import json
import os
import shutil
import subprocess
import sys

HOME = os.path.expanduser("~")
BIN = f"{HOME}/.local/bin"

# ── helpers ──────────────────────────────────────────────────────────────────

def spawn(cmd):
    """Fire and forget: the child outlives this process."""
    subprocess.Popen(cmd, shell=True, start_new_session=True,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL)


def output(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=3).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return ""


def running(name):
    return output(["pgrep", "-x", name]) != ""


def tui(cmd, cls="floating-tui"):
    return f"kitty --class {cls} -e {cmd}"


# ── state probes ─────────────────────────────────────────────────────────────

EQ_PARAM = "audioconvert.filter-graph.0"
EQ_BYPASS = "speaker-eq.bypassed"


def speaker_eq_node():
    """The speaker sink and the EQ graph built into it (see CLAUDE.md).

    None while headphones are in: they replace the speaker sink.
    """
    try:
        objects = json.loads(output(["pw-dump"]) or "[]")
    except ValueError:
        return None, None
    for o in objects:
        props = (o.get("info") or {}).get("props") or {}
        if o.get("type") == "PipeWire:Interface:Node" and props.get(EQ_PARAM):
            return o["id"], props[EQ_PARAM]
    return None, None


def speaker_eq_bypassed(node):
    # A suspended node does not report its graph, so a bypass is recorded
    # against its id, the same way speaker-measure does, and PipeWire drops
    # the record along with the node.
    meta = output(["pw-metadata", "-n", "default", str(node)])
    return f"key:'{EQ_BYPASS}'" in meta


def speaker_eq_on():
    node, _ = speaker_eq_node()
    return None if node is None else not speaker_eq_bypassed(node)


def speaker_eq_toggle():
    node, graph = speaker_eq_node()
    if node is None:
        return
    on = not speaker_eq_bypassed(node)
    # Props params are read into a 4096-byte buffer: drop the indentation.
    value = "" if on else " ".join(graph.split())
    subprocess.run(["pw-cli", "set-param", str(node), "Props",
                    f'{{ params = [ "{EQ_PARAM}" {json.dumps(value)} ] }}'],
                   capture_output=True)
    args = [str(node), EQ_BYPASS, "true"] if on else ["-d", str(node), EQ_BYPASS]
    subprocess.run(["pw-metadata", "-n", "default", *args], capture_output=True)
    spawn(f"notify-send -u low 'Speaker EQ' '{'OFF — flat' if on else 'ON'}'")


PROFILES = ["power-saver", "balanced", "performance"]


def power_profile():
    return output(["powerprofilesctl", "get"]) or None


def power_profile_cycle():
    current = power_profile()
    available = [p for p in PROFILES if f"{p}:" in output(["powerprofilesctl", "list"])]
    if not available:
        return
    nxt = available[(available.index(current) + 1) % len(available)] \
        if current in available else available[0]
    subprocess.run(["powerprofilesctl", "set", nxt], capture_output=True)
    spawn(f"notify-send -u low 'Power profile' '{nxt}'")


def gamemode_on():
    raw = output(["hyprctl", "getoption", "animations:enabled", "-j"])
    try:
        return not json.loads(raw)["bool"]
    except (ValueError, KeyError):
        return None


def awake_on():
    """hypr-idle-toggle's stay awake: its hypr-lid-inhibit inhibitor
    held, as logind lists it. hypridle runs in both states; the bar
    shows it missing in red."""
    held = output(["systemd-inhibit", "--list", "--no-legend",
                   "--no-pager"])
    return any(line.split()[:1] == ["hypr-lid-inhibit"]
               for line in held.splitlines())


# ── the table ────────────────────────────────────────────────────────────────
# kind: "toggle" (state -> bool), "cycle" (state -> str), "open", "session".
# needs: executables that must exist for the entry to show.
# confirm: session entries that take a second press.

ITEMS = [
    dict(id="nightlight", kind="toggle", icon="󰖔", label="Night light",
         run=f"{BIN}/hypr-nightlight-toggle", needs=["hyprsunset"],
         state=lambda: running("hyprsunset") and output(
             ["hyprctl", "hyprsunset", "identity", "get"]) == "false"),
    dict(id="dnd", kind="toggle", icon="󰂛", label="Do not disturb",
         run=f"{BIN}/hypr-dnd-toggle", needs=["swaync-client"],
         state=lambda: output(["swaync-client", "-D"]) == "true"),
    dict(id="awake", kind="toggle", icon="󰅶", label="Stay awake",
         run=f"{BIN}/hypr-idle-toggle", needs=["hypridle", "systemd-inhibit"],
         state=awake_on),
    dict(id="gamemode", kind="toggle", icon="󰊗", label="Game mode",
         run=f"{BIN}/hypr-gamemode", needs=["hyprctl", "jq"],
         state=gamemode_on),
    dict(id="speaker-eq", kind="toggle", icon="󰓃", label="Speaker EQ",
         run=speaker_eq_toggle, needs=["pw-dump", "pw-cli", "pw-metadata"],
         state=speaker_eq_on),
    dict(id="power-profile", kind="cycle", icon="󰓅", label="Power profile",
         run=power_profile_cycle, needs=["powerprofilesctl"],
         state=power_profile),

    dict(id="wifi", kind="open", icon="󰤨", label="Wi-Fi",
         run=tui("nmtui"), needs=["kitty", "nmtui"]),
    dict(id="bluetooth", kind="open", icon="󰂯", label="Bluetooth",
         run=tui("bluetui"), needs=["kitty", "bluetui"]),
    dict(id="audio", kind="open", icon="󰕾", label="Audio",
         run=tui("wiremix"), needs=["kitty", "wiremix"]),
    dict(id="speaker-eq-tune", kind="open", icon="󰙪", label="Tune speakers",
         run="speaker-eq", needs=["speaker-eq"]),
    dict(id="displays", kind="open", icon="\U000F037A", label="Displays",
         run=f"{BIN}/hypr-display-menu", needs=["hyprctl"]),
    dict(id="wallpaper", kind="open", icon="󰸉", label="Wallpaper",
         run="wallhelper gui", needs=["wallhelper"]),
    dict(id="monitor", kind="open", icon="󰍛", label="System monitor",
         run=tui("btop", cls="floating-btop"), needs=["kitty", "btop"]),
    dict(id="failed-units", kind="open", icon="󰒏", label="Failed units",
         run=f"{BIN}/hypr-failed-units", needs=["systemctl"]),
    dict(id="battery", kind="open", icon="󰁹", label="Battery history",
         run="battery-log", needs=["battery-log"]),

    dict(id="lock", kind="session", icon="󰌾", label="Lock",
         run="loginctl lock-session", needs=["loginctl"]),
    dict(id="suspend", kind="session", icon="󰒲", label="Suspend",
         run="systemctl suspend", needs=["systemctl"]),
    dict(id="logout", kind="session", icon="󰍃", label="Log out", confirm=True,
         run="hyprctl dispatch 'hl.dsp.exit()'", needs=["hyprctl"]),
    dict(id="reboot", kind="session", icon="󰜉", label="Reboot", confirm=True,
         run="systemctl reboot", needs=["systemctl"]),
    dict(id="shutdown", kind="session", icon="󰐥", label="Shut down", confirm=True,
         run="systemctl poweroff", needs=["systemctl"]),
]


def installed(needs):
    return all(shutil.which(n) or os.access(n, os.X_OK) for n in needs)


def available():
    return [i for i in ITEMS if installed(i["needs"])]


def run(item):
    if callable(item["run"]):
        item["run"]()
    else:
        spawn(item["run"])


# ── entry point ──────────────────────────────────────────────────────────────


def listing(items):
    """The entries as the sheet reads them, with each one's state.

    The probes run side by side, so the sheet waits for the slowest
    (speaker-eq's pw-dump), not for their sum.
    """
    with ThreadPoolExecutor() as pool:
        states = {i["id"]: pool.submit(i["state"])
                  for i in items if "state" in i}
        return [dict(id=i["id"], kind=i["kind"], icon=i["icon"],
                     label=i["label"], confirm=i.get("confirm", False),
                     state=states[i["id"]].result()
                     if i["id"] in states else None)
                for i in items]


def main(args):
    if not args:
        os.execvp("qs", ["qs", "-c", "bar", "ipc", "call", "bar", "settings"])
    if args[0] == "--json":
        print(json.dumps(listing(available()), ensure_ascii=False))
        return 0
    match = next((i for i in ITEMS if i["id"] == args[0]), None)
    if match is None:
        return f"hypr-settings-menu: unknown entry '{args[0]}'"
    if not installed(match["needs"]):
        return (f"hypr-settings-menu: '{args[0]}' needs "
                f"{', '.join(match['needs'])}")
    run(match)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
