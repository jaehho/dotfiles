#!/usr/bin/env python3
"""hypr-hangul-hint -- what the bar's hangul hint shows, as JSON lines.

The hint is the Korean 2-set (dubeolsik) layout over the QWERTY keys, drawn
by the bar (HangulHint.qml, #89), which runs this as a child and reads one
JSON object per line from it:

  {"layout": {"rows": ..., "offsets": ..., "bumps": ...}}   first, once
  {"hangul": true}       whether the focused window is typing Hangul
  {"key": "q", "down": true}   a letter key going down or up, while Hangul
  {"cursor": [x, y]}     the pointer in global pixels, while Hangul

It follows fcitx5: the hint shows while the focused window is typing Hangul
and goes away when you switch back, so there is no key to remember. fcitx5
keeps input state per window, so the hint follows focus too.

    hypr-hangul-hint            the feed (the bar starts it)
    hypr-hangul-hint --always   Hangul regardless of fcitx5 (for testing)

The layout table is what fcitx5-hangul's "2" keyboard produces, and
tests/test_hangul_hint.py checks it against libhangul, so it cannot drift.
"""

import json
import os
from pathlib import Path
import socket
import struct
import sys

# The 2-set layout: (QWERTY key, jamo, jamo with Shift or "") per row. Rows are
# staggered like the physical keys, so ROW_OFFSETS is in key units.
ROWS = [
    [("q", "ㅂ", "ㅃ"), ("w", "ㅈ", "ㅉ"), ("e", "ㄷ", "ㄸ"),
     ("r", "ㄱ", "ㄲ"), ("t", "ㅅ", "ㅆ"), ("y", "ㅛ", ""),
     ("u", "ㅕ", ""), ("i", "ㅑ", ""), ("o", "ㅐ", "ㅒ"), ("p", "ㅔ", "ㅖ")],
    [("a", "ㅁ", ""), ("s", "ㄴ", ""), ("d", "ㅇ", ""), ("f", "ㄹ", ""),
     ("g", "ㅎ", ""), ("h", "ㅗ", ""), ("j", "ㅓ", ""), ("k", "ㅏ", ""),
     ("l", "ㅣ", "")],
    [("z", "ㅋ", ""), ("x", "ㅌ", ""), ("c", "ㅊ", ""), ("v", "ㅍ", ""),
     ("b", "ㅠ", ""), ("n", "ㅜ", ""), ("m", "ㅡ", "")],
]
ROW_OFFSETS = [0.0, 0.25, 0.75]

# The fcitx5 input method name of the Hangul engine.
HANGUL_IM = "hangul"
POLL_MS = 250

# Lighting keys as they are pressed reads the same post-remap stream apps see,
# keyd's virtual keyboard (Caps held = Ctrl), read-only and only while the hint
# is on screen. Nothing is stored or printed: just which keys are down now.
# HANGUL_HINT_DEVICE points it at another file, for tests.
KEYBOARD_NAME = "keyd virtual keyboard"
INPUT_EVENT = struct.Struct("llHHi")  # struct input_event on 64-bit Linux
EV_KEY = 1
KEY_CODES = {  # linux/input-event-codes.h
    16: "q", 17: "w", 18: "e", 19: "r", 20: "t", 21: "y", 22: "u", 23: "i",
    24: "o", 25: "p", 30: "a", 31: "s", 32: "d", 33: "f", 34: "g", 35: "h",
    36: "j", 37: "k", 38: "l", 44: "z", 45: "x", 46: "c", 47: "v", 48: "b",
    49: "n", 50: "m",
}


# The hint has no input region, so it cannot hear the pointer. Hyprland can
# say where the cursor is over its IPC socket; the bar clears the board around
# it. HANGUL_HINT_CURSOR="x,y" pins the cursor (global pixels), for tests.
CURSOR_MS = 33

# The keys with a tactile bump on a real keyboard.
HOME_BUMPS = ("f", "j")


def hypr_request(command):
    """Hyprland's JSON answer to an IPC command such as 'j/cursorpos'."""
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    if not runtime or not signature:
        return None
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
            sock.settimeout(0.1)
            sock.connect(f"{runtime}/hypr/{signature}/.socket.sock")
            sock.sendall(command.encode())
            chunks = []
            while chunk := sock.recv(65536):
                chunks.append(chunk)
        return json.loads(b"".join(chunks))
    except (OSError, ValueError):
        return None


def cursor_position():
    """(x, y) of the pointer in global pixels, or None."""
    pinned = os.environ.get("HANGUL_HINT_CURSOR")
    if pinned:
        x, y = pinned.split(",")
        return float(x), float(y)
    answer = hypr_request("j/cursorpos")
    return (answer["x"], answer["y"]) if answer else None


def keyboard_device():
    """Path of the evdev node to read, or None when there is none."""
    if os.environ.get("HANGUL_HINT_DEVICE"):
        return os.environ["HANGUL_HINT_DEVICE"]
    try:
        text = Path("/proc/bus/input/devices").read_text()
    except OSError:
        return None
    for block in text.split("\n\n"):
        if f'Name="{KEYBOARD_NAME}"' in block:
            for token in block.split():
                if token.startswith("event"):
                    return f"/dev/input/{token}"
    return None


def key_events(data):
    """[(letter, down)] for the letter keys in a chunk of input_event bytes.

    Auto-repeat (value 2) and every other key are left out.
    """
    whole = len(data) - len(data) % INPUT_EVENT.size
    return [(KEY_CODES[code], bool(value))
            for _, _, kind, code, value
            in INPUT_EVENT.iter_unpack(data[:whole])
            if kind == EV_KEY and code in KEY_CODES and value in (0, 1)]


class Visibility:
    """The hint shows while the focused window is typing Hangul."""

    def __init__(self, always=False):
        self.always = always
        self.hangul = False

    def update(self, hangul):
        """Feed the current state; True when the visible state changed."""
        before = self.visible
        self.hangul = hangul
        return self.visible != before

    @property
    def visible(self):
        return self.always or self.hangul


def layout_message():
    """The board, for the bar to draw: rows of (latin, jamo, shifted)."""
    return {"layout": {"rows": ROWS, "offsets": ROW_OFFSETS,
                       "bumps": list(HOME_BUMPS)}}


def emit(message):
    """One JSON object per line; a closed pipe (the bar gone) ends the feed."""
    try:
        print(json.dumps(message, ensure_ascii=False), flush=True)
    except BrokenPipeError:
        # Nothing left to flush to; leave without the interpreter trying.
        os._exit(0)


def feed(always):
    from gi.repository import Gio, GLib

    state = Visibility(always)
    device = {"fd": None, "watch": None}
    last = {"cursor": None}

    def listen(on):
        """Read the keyboard while Hangul is on, and only then."""
        if on and device["fd"] is None:
            path = keyboard_device()
            try:
                device["fd"] = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
            except (OSError, TypeError):
                return  # no device or no permission: the hint stays plain
            device["watch"] = GLib.io_add_watch(
                device["fd"], GLib.PRIORITY_DEFAULT,
                GLib.IOCondition.IN | GLib.IOCondition.HUP
                | GLib.IOCondition.ERR, on_keys)
        elif not on and device["fd"] is not None:
            GLib.source_remove(device["watch"])
            close_device()

    def close_device():
        os.close(device["fd"])
        device["fd"] = device["watch"] = None

    def on_keys(fd, condition):
        data = b""
        if not condition & (GLib.IOCondition.HUP | GLib.IOCondition.ERR):
            try:
                data = os.read(fd, INPUT_EVENT.size * 64)
            except BlockingIOError:
                return True
            except OSError:
                pass
        if not data:  # device gone or end of file: stop reading
            close_device()
            return False
        for letter, down in key_events(data):
            emit({"key": letter, "down": down})
        return True

    def follow_cursor():
        if state.visible:
            cursor = cursor_position()
            if cursor is not None and cursor != last["cursor"]:
                last["cursor"] = cursor
                emit({"cursor": [round(cursor[0]), round(cursor[1])]})
        return True

    def poll():
        # NO_AUTO_START: an fcitx5 that is not running stays that way.
        bus.call("org.fcitx.Fcitx5", "/controller",
                 "org.fcitx.Fcitx.Controller1", "CurrentInputMethod", None,
                 GLib.VariantType("(s)"), Gio.DBusCallFlags.NO_AUTO_START,
                 200, None, on_input_method)
        return True

    def on_input_method(connection, result):
        try:
            name = connection.call_finish(result).unpack()[0]
        except GLib.Error:
            name = ""
        if state.update(name == HANGUL_IM):
            emit({"hangul": state.visible})
            listen(state.visible)

    emit(layout_message())
    emit({"hangul": state.visible})
    listen(state.visible)
    if not always:
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        GLib.timeout_add(POLL_MS, poll)
    GLib.timeout_add(CURSOR_MS, follow_cursor)
    GLib.MainLoop().run()


def main():
    feed("--always" in sys.argv[1:])


if __name__ == "__main__":
    main()
