#!/usr/bin/env python3
"""hypr-hangul-hint -- the Korean 2-set (dubeolsik) layout over the QWERTY keys.

A translucent layer-shell overlay at the bottom of the screen. It takes no
keyboard and no pointer, so you type and click through it.

It follows fcitx5: the hint shows while the focused window is typing Hangul
and goes away when you switch back, so there is no key to remember. fcitx5
keeps input state per window, so the hint follows focus too.

    hypr-hangul-hint            start the follower; run again to flip the hint
    hypr-hangul-hint --always   show it regardless of fcitx5 (for testing)

A second run flips what you see now. Automatic mode comes back the next time
the focused window's input method changes.

The layout table is what fcitx5-hangul's "2" keyboard produces, and
tests/test_hangul_hint.py checks it against libhangul, so it cannot drift.
"""

import os
from pathlib import Path
import sys

# The 2-set layout: (QWERTY key, jamo, jamo with Shift or "") per row. Rows are
# staggered like the physical keys, so ROW_OFFSETS is in key units.
ROWS = [
    [("q", "ㅂ", "ㅃ"), ("w", "ㅈ", "ㅉ"), ("e", "ㄷ", "ㄸ"),
     ("r", "ㄱ", "ㄲ"), ("t", "ㅅ", "ㅆ"), ("y", "ㅛ", ""),
     ("u", "ㅕ", ""), ("i", "ㅑ", ""), ("o", "ㅐ", "ㅒ"), ("p", "ㅔ", "ㅖ")],
    [("a", "ㅁ", ""), ("s", "ㄴ", ""), ("d", "ㅇ", ""), ("f", "ㄹ", ""),
     ("g", "ㅎ", ""), ("h", "ㅗ", ""), ("j", "ㅓ", ""), ("k", "ㅏ", ""),
     ("l", "ㅣ", "")],
    [("z", "ㅋ", ""), ("x", "ㅌ", ""), ("c", "ㅊ", ""), ("v", "ㅍ", ""),
     ("b", "ㅠ", ""), ("n", "ㅜ", ""), ("m", "ㅡ", "")],
]
ROW_OFFSETS = [0.0, 0.25, 0.75]

# The fcitx5 input method name of the Hangul engine.
HANGUL_IM = "hangul"
POLL_MS = 250


class Visibility:
    """Whether the hint shows: follow fcitx5, unless flipped by hand.

    A flip holds until the focused window's input method changes, then
    automatic mode takes over again.
    """

    def __init__(self, always=False):
        self.always = always
        self.hangul = False
        self.override = None

    def update(self, hangul):
        """Feed the current state; True when the visible state changed."""
        before = self.visible
        if hangul != self.hangul:
            self.hangul = hangul
            self.override = None
        return self.visible != before

    def flip(self):
        self.override = not self.visible

    @property
    def visible(self):
        if self.always:
            return True
        return self.hangul if self.override is None else self.override


def palette():
    """name -> '#rrggbb' from the shared Everforest file."""
    colors = {}
    path = Path.home() / ".config/hypr/themes/everforest.conf"
    try:
        for line in path.read_text().splitlines():
            name, _, val = line.strip().partition("=")
            val = val.strip()
            if (name.startswith("$") and not name.endswith("Alpha")
                    and val.startswith("rgb(")):
                colors[name[1:].strip()] = "#" + val[4:-1]
    except OSError:
        pass
    return colors


PITCH = 62
GAP = 6
KEY = PITCH - GAP

# The keys with a tactile bump on a real keyboard.
HOME_BUMPS = ("f", "j")


def board_size():
    """(width, height) of the keys exactly: no slack on any side, so the
    board's padding is the same all round."""
    width = max((len(row) - 1 + offset) * PITCH + KEY
                for row, offset in zip(ROWS, ROW_OFFSETS))
    height = (len(ROWS) - 1) * PITCH + KEY
    return int(width), int(height)


# The board is dark glass the layer rule blurs behind; the keys sit on it
# nearly solid so the glyphs read over any window.
CSS = """
window.hangul-hint {{ background: transparent; }}

.board {{
  background: alpha({bg_dim}, 0.72);
  border: 1px solid alpha({bg3}, 0.7);
  border-radius: 12px;
  padding: 16px;
}}

.key {{
  background: alpha({bg2}, 0.94);
  border: 1px solid {bg3};
  border-bottom: 3px solid {bg_dim};
  border-radius: 8px;
}}

.jamo {{
  font-family: "Noto Sans CJK KR", sans-serif;
  font-size: 28px;
  font-weight: 600;
  color: {fg};
}}

.latin {{
  font-family: "JetBrainsMono Nerd Font", monospace;
  font-size: 10px;
  font-weight: 700;
  color: {grey1};
}}
.shifted {{
  font-family: "Noto Sans CJK KR", sans-serif;
  font-size: 13px;
  font-weight: 500;
  color: {grey2};
}}

.bump {{
  background: {grey1};
  border-radius: 2px;
}}
"""


def gui(always):
    # gtk4-layer-shell must be loaded before libwayland-client, and PyGObject
    # pulls libwayland in the moment Gdk is imported, so re-exec once with the
    # library preloaded (see hypr-keybind-cheatsheet).
    preload = "/usr/lib/libgtk4-layer-shell.so"
    if (os.path.exists(preload)
            and preload not in os.environ.get("LD_PRELOAD", "")):
        existing = os.environ.get("LD_PRELOAD", "")
        os.environ["LD_PRELOAD"] = f"{preload}:{existing}".rstrip(":")
        os.execv(sys.executable, [sys.executable, *sys.argv])

    import cairo
    import gi

    gi.require_version("Gtk", "4.0")
    gi.require_version("Gdk", "4.0")
    gi.require_version("Gtk4LayerShell", "1.0")
    from gi.repository import Gdk, Gio, GLib, Gtk
    from gi.repository import Gtk4LayerShell as LayerShell

    def key_widget(latin, jamo, shifted):
        box = Gtk.Overlay()
        box.add_css_class("key")
        box.set_size_request(KEY, KEY)
        main = Gtk.Label(label=jamo, halign=Gtk.Align.CENTER,
                         valign=Gtk.Align.CENTER)
        main.add_css_class("jamo")
        box.set_child(main)
        small = Gtk.Label(label=latin.upper(), halign=Gtk.Align.START,
                          valign=Gtk.Align.END, margin_start=6,
                          margin_bottom=3)
        small.add_css_class("latin")
        box.add_overlay(small)
        if latin in HOME_BUMPS:
            bump = Gtk.Box(halign=Gtk.Align.CENTER, valign=Gtk.Align.END,
                           margin_bottom=5)
            bump.set_size_request(20, 3)
            bump.add_css_class("bump")
            box.add_overlay(bump)
        if shifted:
            top = Gtk.Label(label=shifted, halign=Gtk.Align.END,
                            valign=Gtk.Align.START, margin_end=6,
                            margin_top=3)
            top.add_css_class("shifted")
            box.add_overlay(top)
        return box

    def build():
        board = Gtk.Box(halign=Gtk.Align.CENTER, valign=Gtk.Align.END)
        board.add_css_class("board")
        fixed = Gtk.Fixed()
        for top, (row, offset) in enumerate(zip(ROWS, ROW_OFFSETS)):
            for col, (latin, jamo, shifted) in enumerate(row):
                fixed.put(key_widget(latin, jamo, shifted),
                          (col + offset) * PITCH, top * PITCH)
        fixed.set_size_request(*board_size())
        board.append(fixed)
        return board

    class Hint(Gtk.Application):
        def __init__(self):
            super().__init__(application_id="dev.jaeho.hangulhint",
                             flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
            self.window = None
            self.state = Visibility(always)
            self.bus = None

        def do_activate(self):
            # The first run starts the follower; later runs reach it here and
            # flip what is on screen.
            if self.window:
                self.state.flip()
                self.sync()
                return

            self.hold()
            provider = Gtk.CssProvider()
            provider.load_from_string(CSS.format(**palette()))
            Gtk.StyleContext.add_provider_for_display(
                Gdk.Display.get_default(), provider,
                Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

            self.window = Gtk.ApplicationWindow(application=self)
            self.window.add_css_class("hangul-hint")

            LayerShell.init_for_window(self.window)
            LayerShell.set_namespace(self.window, "hangul-hint")
            LayerShell.set_layer(self.window, LayerShell.Layer.OVERLAY)
            LayerShell.set_keyboard_mode(
                self.window, LayerShell.KeyboardMode.NONE)
            LayerShell.set_anchor(self.window, LayerShell.Edge.BOTTOM, True)
            LayerShell.set_margin(self.window, LayerShell.Edge.BOTTOM, 56)

            # No input region: clicks fall through to what is underneath.
            self.window.connect("realize", self.pass_input_through)
            self.window.set_child(build())

            if always:
                self.sync()
            else:
                self.bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
                GLib.timeout_add(POLL_MS, self.poll)

        def sync(self):
            if self.state.visible:
                self.window.present()
            else:
                self.window.set_visible(False)

        def poll(self):
            # NO_AUTO_START: an fcitx5 that is not running stays that way.
            self.bus.call(
                "org.fcitx.Fcitx5", "/controller",
                "org.fcitx.Fcitx.Controller1", "CurrentInputMethod", None,
                GLib.VariantType("(s)"), Gio.DBusCallFlags.NO_AUTO_START,
                200, None, self.on_input_method)
            return True

        def on_input_method(self, bus, result):
            try:
                name = bus.call_finish(result).unpack()[0]
            except GLib.Error:
                name = ""
            if self.state.update(name == HANGUL_IM):
                self.sync()

        @staticmethod
        def pass_input_through(window):
            window.get_surface().set_input_region(cairo.Region())

    return Hint().run([sys.argv[0]])


def main():
    sys.exit(gui("--always" in sys.argv[1:]))


if __name__ == "__main__":
    main()
