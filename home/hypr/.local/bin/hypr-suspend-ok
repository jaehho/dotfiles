#!/usr/bin/env bash
# hypridle condition_cmd for the idle-suspend listener. Exit 0 allows
# `systemctl suspend`; non-zero defers it.
#
# Three things defer it:
#
# - stay awake (hypr-idle-toggle's hypr-lid-inhibit inhibitor, as logind
#   lists it): stay awake blocks suspend and nothing else, so the screen
#   still dims and turns off.
# - steno recording a meeting you started by hand, or finishing the notes
#   of any meeting, lid open or not. A room meeting has no call app and
#   often no typing, so nothing else marks the machine as in use. A call
#   steno detected on its own is not deferred: an open mic left in a tab
#   would otherwise hold the machine awake. Finishing ends on its own
#   (steno gives up on notes after 30 minutes).
# - a Claude session mid-turn (status "busy") with the lid open, so a long
#   turn is not cut by the idle timer. A session sitting at a prompt must
#   not block sleep.
#
# Lid close is logind's HandleLidSwitch and is not gated here.
#
# steno is asked through its CLI (docs/app-contract.md); steno's
# contract/ pins `class` and `manual` for this reader. Missing, slow or
# failing, it counts as not recording. Claude status lives in
# ~/.claude/sessions/<pid>.json (written by Claude Code; claude-open execs
# into claude, so the same store covers both).

if systemd-inhibit --list --no-legend --no-pager 2>/dev/null |
    awk '$1 == "hypr-lid-inhibit" { held = 1 } END { exit !held }'; then
    exit 1
fi

if bar=$(timeout 5 steno bar --once 2>/dev/null) &&
    jq -e '.class == "finalizing" or (.class == "recording" and .manual == true)' \
        <<<"$bar" >/dev/null 2>&1; then
    exit 1
fi

shopt -s nullglob
for f in "$HOME"/.claude/sessions/*.json; do
    read -r pid status < <(jq -r '[.pid // "", .status // ""] | @tsv' "$f" 2>/dev/null) || continue
    [[ $status == busy && $pid =~ ^[0-9]+$ && -d /proc/$pid ]] || continue
    while read -r _ state; do
        [[ $state == open ]] && exit 1
    done < <(cat /proc/acpi/button/lid/*/state 2>/dev/null)
done
exit 0
