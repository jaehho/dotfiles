#!/usr/bin/env bash
set -euo pipefail

# hypr-tab-nonempty — cycle through non-empty workspaces on the current
# monitor, skipping workspaces with no windows.

direction="${1:-next}"

mon_json=$(hyprctl monitors -j)
current_mon=$(echo "$mon_json" | jq -r '.[] | select(.focused) | .name')
current_ws=$(echo "$mon_json" | jq -r '.[] | select(.focused) | .activeWorkspace.id')

# Left-to-right order, the same layout monitors.lua applies and locks
# workspace ids to (slots_by_monitor). Do not force the laptop last: with one
# external it sits on the left and owns 1/3/5…, so "externals first" would look
# at the tablet's 2/4/6… and Super+Tab would no-op on the laptop.
mapfile -t ordered < <(echo "$mon_json" | jq -r 'sort_by(.x) | .[].name')

mon_count=${#ordered[@]}
mon_idx=0
for ((i=0; i<mon_count; i++)); do
    [[ "${ordered[$i]}" == "$current_mon" ]] && { mon_idx=$i; break; }
done

# Workspace IDs that have at least one window
mapfile -t occupied < <(hyprctl clients -j | jq '[.[].workspace.id] | unique | .[]')

# Build slots for this monitor, keeping only non-empty ones
slots=()
for slot in $(seq 1 10); do
    (( (slot - 1) % mon_count == mon_idx )) || continue
    ws_id=$slot
    for occ in "${occupied[@]}"; do
        (( occ == ws_id )) && { slots+=("$ws_id"); break; }
    done
done

(( ${#slots[@]} <= 1 )) && exit 0

# Find current position in the filtered list. An empty workspace (just closed
# the last window) is still focused but not in slots, so pick by id order
# instead of defaulting to index 0 — that made Super+Tab always land on
# slots[1] (workspace 2 once packing has densified the ids).
cur_idx=-1
for ((i=0; i<${#slots[@]}; i++)); do
    (( slots[i] == current_ws )) && { cur_idx=$i; break; }
done

if (( cur_idx >= 0 )); then
    if [[ "$direction" == "next" ]]; then
        target_idx=$(( (cur_idx + 1) % ${#slots[@]} ))
    else
        target_idx=$(( (cur_idx - 1 + ${#slots[@]}) % ${#slots[@]} ))
    fi
elif [[ "$direction" == "next" ]]; then
    # First occupied workspace after current_ws; wrap to the first slot.
    target_idx=0
    for ((i=0; i<${#slots[@]}; i++)); do
        if (( slots[i] > current_ws )); then
            target_idx=$i
            break
        fi
    done
else
    # Last occupied workspace before current_ws; wrap to the last slot.
    target_idx=$(( ${#slots[@]} - 1 ))
    for ((i=${#slots[@]} - 1; i>=0; i--)); do
        if (( slots[i] < current_ws )); then
            target_idx=$i
            break
        fi
    done
fi

hyprctl dispatch "hl.dsp.focus({ workspace = ${slots[$target_idx]} })" >/dev/null
