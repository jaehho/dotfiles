#!/bin/bash
# Toggle game mode — disables compositor effects for performance.
# Off is a config reload, so the restored look always matches hyprland.lua.

if [ "$(hyprctl getoption animations:enabled -j | jq '.bool')" = true ]; then
    hyprctl eval 'hl.config({
        animations = { enabled = false },
        decoration = { shadow = { enabled = false }, blur = { enabled = false }, rounding = 0 },
        general    = { gaps_in = 0, gaps_out = 0, border_size = 1 },
    })' >/dev/null
    notify-send -u low "Game Mode" "ON — effects disabled"
else
    hyprctl reload >/dev/null
    notify-send -u low "Game Mode" "OFF — effects restored"
fi
