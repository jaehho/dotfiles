#!/usr/bin/env python3
"""hypr-keybind-cheatsheet — a layer-shell overlay of the keys this machine binds.

Every section is parsed from the config that owns it, so the sheet cannot drift:
hyprland.lua for the WM, `tmux list-keys -N` for tmux. Kitty cannot report its
bindings, so its rows are the one hand-kept list here.

The sheet is organised by the prefix you hold, not by the app, because that is
how the hand works: Super, Super + Shift, tmux's C-a, kitty_mod.

Labels come from, in order: the trailing `--` comment on the bind's own line,
the comment block directly above it when that block covers only this one key,
then the dispatcher itself. A bind that ends up with no label lands in
"Unfiled" rather than being dropped, so it shows up and can be fixed.
"""

import os
import re
import subprocess
import sys

# gtk4-layer-shell must be loaded before libwayland-client, and PyGObject pulls
# libwayland in the moment Gdk is imported, so re-exec once with the library
# preloaded. Not liblayer-shell-preload.so, which ships alongside it: that one
# auto-inits every window under its own namespace, taking the blur layerrule
# with it.
PRELOAD = "/usr/lib/libgtk4-layer-shell.so"
if os.path.exists(PRELOAD) and PRELOAD not in os.environ.get("LD_PRELOAD", ""):
    existing = os.environ.get("LD_PRELOAD", "")
    os.environ["LD_PRELOAD"] = f"{PRELOAD}:{existing}".rstrip(":")
    os.execv(sys.executable, [sys.executable, *sys.argv])

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
gi.require_version("Gtk4LayerShell", "1.0")
from gi.repository import Gdk, Gio, GLib, Gtk, Pango  # noqa: E402
from gi.repository import Gtk4LayerShell as LayerShell  # noqa: E402

HOME = os.path.expanduser("~")
HYPR_CONFIG = f"{HOME}/.config/hypr/hyprland.lua"
PALETTE = os.environ.get("XDG_CONFIG_HOME", f"{HOME}/.config") + "/theme/palette"
COLUMNS = 4


# ── palette ──────────────────────────────────────────────────────────────────

# Read live rather than through a theme-apply include: the palette is already a
# plain key=value file, so generating a CSS copy of it would only add a step
# that can go stale.
FALLBACK = {
    "crust": "0c1315", "base": "141c1e", "surface0": "20282a",
    "surface1": "2f3739", "surface2": "41494c", "overlay0": "778184",
    "text": "cfdadc", "subtext1": "b6c0c2", "sapphire": "3daab0",
}


def palette():
    colors = dict(FALLBACK)
    try:
        with open(PALETTE) as fh:
            for line in fh:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    key, val = line.split("=", 1)
                    colors[key.strip()] = val.strip()
    except OSError:
        pass
    return {k: f"#{v}" for k, v in colors.items()}


# ── key names ────────────────────────────────────────────────────────────────

KEY_NAMES = {
    "SUPER": "Super", "SHIFT": "Shift", "CTRL": "Ctrl", "ALT": "Alt",
    "escape": "Esc", "BackSpace": "Backspace", "Tab": "Tab", "space": "Space",
    "Print": "Print", "slash": "/", "semicolon": ";", "period": ".",
    "comma": ",", "left": "←", "right": "→", "up": "↑", "down": "↓",
    "mouse_down": "Wheel ↓", "mouse_up": "Wheel ↑",
    "mouse:272": "Drag LMB", "mouse:273": "Drag RMB",
    "XF86AudioRaiseVolume": "Vol +", "XF86AudioLowerVolume": "Vol −",
    "XF86AudioMute": "Mute", "XF86AudioMicMute": "Mic mute",
    "XF86MonBrightnessUp": "Bright +", "XF86MonBrightnessDown": "Bright −",
    "XF86AudioNext": "Next", "XF86AudioPrev": "Prev",
    "XF86AudioPlay": "Play", "XF86AudioPause": "Pause",
    "XF86Calculator": "Calc",
}

MODIFIERS = ("SUPER", "SHIFT", "CTRL", "ALT")
SECONDARY = ("SHIFT", "CTRL", "ALT")


def key_name(token):
    if token in KEY_NAMES:
        return KEY_NAMES[token]
    if re.fullmatch(r"<\d+-\d+>", token):
        return token[1:-1].replace("-", "–")
    return token.upper() if len(token) == 1 else token


# ── lua scanning ─────────────────────────────────────────────────────────────

def strip_trailing_comment(line):
    """Split a Lua line into code and its `--` comment.

    Not a simple find: several binds exec shell one-liners full of `--flags`,
    and one wraps its command in a [[long string]].
    """
    in_string, quote, i = False, "", 0
    while i < len(line):
        ch = line[i]
        if in_string:
            if ch == "\\":
                i += 2
                continue
            if ch == quote:
                in_string = False
        elif ch in "\"'":
            in_string, quote = True, ch
        elif line.startswith("[[", i):
            end = line.find("]]", i)
            i = len(line) if end < 0 else end + 2
            continue
        elif line.startswith("--", i):
            return line[:i], line[i + 2:].strip()
        i += 1
    return line, ""


def split_top_level(text, sep=","):
    """Split on `sep` at bracket depth 0, ignoring quoted sections."""
    parts, depth, in_string, quote, start, i = [], 0, False, "", 0, 0
    while i < len(text):
        ch = text[i]
        if in_string:
            if ch == "\\":
                i += 2
                continue
            if ch == quote:
                in_string = False
        elif ch in "\"'":
            in_string, quote = True, ch
        elif ch in "([{":
            depth += 1
        elif ch in ")]}":
            depth -= 1
        elif ch == sep and depth == 0:
            parts.append(text[start:i])
            start = i + 1
        i += 1
    parts.append(text[start:])
    return parts


def resolve_string(expr, locals_):
    """Fold a Lua concatenation of literals and known locals into one string."""
    out = []
    for piece in expr.split(".."):
        piece = piece.strip()
        literal = (re.fullmatch(r'"(.*)"', piece, re.S)
                   or re.fullmatch(r"\[\[(.*)\]\]", piece, re.S))
        if literal:
            out.append(literal.group(1))
        elif piece in locals_:
            out.append(locals_[piece])
        else:
            out.append(piece)
    return "".join(out)


def humanize_action(action, locals_):
    """Last resort: make the dispatcher itself readable."""
    action = re.sub(r"^hl\.dsp\.", "", action.strip())

    exec_call = re.match(r"exec_cmd\((.*)\)$", action, re.S)
    if exec_call:
        arg = exec_call.group(1).strip()
        # `exec_cmd(terminal)` — the variable name is the better label of the
        # two, since the value is just whichever program currently fills it.
        if arg in locals_:
            return re.sub(r"(?<=[a-z])(?=[A-Z])", " ", arg).lower()
        cmd = re.sub(r"^env \w+=\S+ ", "", resolve_string(arg, locals_))
        cmd = cmd.replace("~/.local/bin/", "")
        # A long shell one-liner has no useful short form; name the program.
        if any(c in cmd for c in "|&;"):
            return cmd.split()[0]
        flag = re.search(r"--([\w-]+)", cmd)
        if flag:
            return flag.group(1).replace("-", " ")
        return re.sub(r"^hypr-", "", cmd).replace("-", " ").strip()

    call = re.match(r"([\w.]+)\((.*)\)$", action, re.S)
    if not call:
        return ""
    name, args = call.group(1), call.group(2)
    verb = name.split(".")[-1].replace("_", " ")
    direction = re.search(r'direction\s*=\s*"(\w+)"', args)
    workspace = re.search(r'workspace\s*=\s*"?([\w<>+-]+)', args)
    if direction:
        noun = direction.group(1)
    elif workspace:
        noun = "workspace " + workspace.group(1)
    elif re.fullmatch(r'"[^"]*"', args.strip()):
        noun = args.strip().strip('"')
    else:
        noun = "window" if name.startswith("window.") else ""
    return f"{verb} {noun}".strip()


def block_label(block):
    """First line of a comment block, minus the how-to-press and see-also asides."""
    if not block:
        return ""
    text = re.sub(r"\s+with\s+mainMod.*$", "", block[0], flags=re.I)
    text = re.sub(r"\s*[—-]+\s*see\s.*$", "", text, flags=re.I)
    text = re.sub(r"[:.].*$", "", text)
    trimmed = re.sub(r"\s*\([^)]*\)\s*$", "", text)
    if len(trimmed.split()) >= 2:
        text = trimmed
    return text.strip().rstrip(".:")


def parse_hyprland():
    """Yield one record per hl.bind() in the config, in source order."""
    try:
        with open(HYPR_CONFIG) as fh:
            lines = fh.read().splitlines()
    except OSError as exc:
        print(f"cannot read {HYPR_CONFIG}: {exc}", file=sys.stderr)
        return []

    binds, locals_, block, blocks = [], {}, [], {}
    block_id, submap, loop = 0, "", None
    buf, buf_comment, depth = "", "", 0

    def record(text, comment):
        bind = emit_bind(text, comment, block_id, submap, loop, locals_)
        if bind:
            binds.append(bind)

    for raw in lines:
        code, comment = strip_trailing_comment(raw)
        stripped = code.strip()

        if buf:
            buf += " " + stripped
            buf_comment = buf_comment or comment
            depth += stripped.count("(") - stripped.count(")")
            if depth <= 0:
                record(buf, buf_comment)
                buf, buf_comment, depth = "", "", 0
            continue

        # A comment-only line has empty code, so it has to be tested first.
        if not stripped:
            if comment:
                block.append(comment)
                blocks[block_id] = list(block)
            else:
                block, block_id = [], block_id + 1
            continue

        assign = re.match(r'local (\w+)\s*=\s*"([^"]*)"\s*$', stripped)
        if assign:
            locals_[assign.group(1)] = assign.group(2)
            continue

        submap_def = re.match(r'hl\.define_submap\("([^"]+)"', stripped)
        if submap_def:
            submap, block, block_id = submap_def.group(1), [], block_id + 1
            continue
        if stripped.startswith("end)"):
            submap, block, block_id = "", [], block_id + 1
            continue

        # `for i = 1, 9 do` binds the loop range; `local key = i % 10` remaps
        # 10 onto 0, so the keys actually bound there are 0-9.
        for_loop = re.match(r"for (\w+) = (\d+), (\d+) do", stripped)
        if for_loop:
            var, lo, hi = for_loop.group(1), for_loop.group(2), for_loop.group(3)
            loop = {"var": var, "alias": None, "range": f"<{lo}-{hi}>"}
            continue
        alias = re.match(r"local (\w+) = (\w+) % 10", stripped)
        if alias and loop and alias.group(2) == loop["var"]:
            loop["alias"], loop["range"] = alias.group(1), "<0-9>"
            continue
        if stripped == "end":
            loop, block, block_id = None, [], block_id + 1
            continue

        if stripped.startswith("hl.bind("):
            depth = stripped.count("(") - stripped.count(")")
            if depth > 0:
                buf, buf_comment = stripped, comment
            else:
                record(stripped, comment)
            continue

    label_binds(binds, blocks)
    return binds


def label_binds(binds, blocks):
    """A comment block only names a bind when it covers that one key alone."""
    keys_per_block = {}
    for bind in binds:
        keys_per_block.setdefault(bind["block"], set()).add(bind["key"])

    for bind in binds:
        label = bind["comment"]
        if not label and len(keys_per_block[bind["block"]]) == 1:
            label = block_label(blocks.get(bind["block"], []))
        bind["label"] = (label or bind["derived"]).strip()


def emit_bind(text, comment, block_id, submap, loop, locals_):
    body = re.sub(r"\)\s*$", "", re.sub(r"^hl\.bind\(", "", text.strip()))
    parts = split_top_level(body)
    if len(parts) < 2:
        return None

    key = resolve_string(parts[0].replace("mainMod", '"SUPER"'), locals_)
    # Bind options (`{ repeating = true }`) trail the dispatcher; drop them.
    action = split_top_level(",".join(parts[1:]).strip())[0].strip()

    if loop:
        for var in (loop["var"], loop["alias"]):
            if var:
                key = re.sub(rf"\b{re.escape(var)}\b", loop["range"], key)
                action = re.sub(rf"\b{re.escape(var)}\b", "<n>", action)

    key = re.sub(r"\s*\+\s*", " + ", key.strip())
    if "catchall" in key:
        return None
    tokens = key.split(" + ")
    return {"key": key, "comment": comment, "block": block_id, "submap": submap,
            "mods": frozenset(KEY_NAMES[t] for t in tokens[:-1] if t in MODIFIERS),
            "derived": humanize_action(action, locals_)}


# ── grouping ─────────────────────────────────────────────────────────────────

SUBMAP_GROUPS = {"resize": "Resize mode", "swaync": "Notification panel"}

GROUP_ORDER = [
    "Super", "Super + Shift", "Super + Ctrl", "No prefix",
    "Resize mode", "Notification panel", "Tmux", "Kitty", "Unfiled",
]


def group_of(tokens, submap):
    """Return (group, keys shown in the row). The group is the prefix you hold."""
    if submap:
        return SUBMAP_GROUPS.get(submap, submap.capitalize()), tokens
    mods = [t for t in tokens[:-1] if t in MODIFIERS]
    rest = tokens[len(mods):]
    if "SUPER" not in mods:
        return "No prefix", tokens
    secondary = next((m for m in SECONDARY if m in mods), None)
    if not secondary:
        return "Super", rest
    extra = [m for m in SECONDARY if m in mods and m != secondary]
    return f"Super + {KEY_NAMES[secondary]}", extra + rest


def collapse_directions(rows):
    """Four rows bound to h/j/k/l under one verb read better as a single row."""
    out, i = [], 0
    while i < len(rows):
        window = rows[i:i + 4]
        keys = sorted(r["keys"][-1].lower() for r in window)
        stems = {re.sub(r"\s+(left|right|up|down)$", "", r["label"], flags=re.I).strip()
                 for r in window}
        heads = {tuple(r["keys"][:-1]) for r in window}
        if len(window) == 4 and keys == ["h", "j", "k", "l"] \
                and len(stems) == 1 and len(heads) == 1:
            out.append({"keys": list(heads.pop()) + ["H", "J", "K", "L"],
                        "label": stems.pop(), "chord": window[0]["chord"]})
            i += 4
        else:
            out.append(rows[i])
            i += 1
    return out


def hyprland_groups():
    groups = {}
    for bind in parse_hyprland():
        name, keys = group_of(bind["key"].split(" + "), bind["submap"])
        if not bind["label"]:
            name = "Unfiled"
        groups.setdefault(name, []).append({
            "keys": [key_name(t) for t in keys],
            # The key column already shows the digits a loop label stands for.
            "label": (bind["label"] or bind["key"]).replace(" <n>", "").capitalize(),
            "chord": bind["mods"],
        })

    # A chord with only a row or two of its own is noise as a column heading;
    # fold it back into Super and let the row carry the extra modifier.
    for name in [n for n in groups if n.startswith("Super + ") and len(groups[n]) < 3]:
        held = name.split(" + ")[1]
        for row in groups.pop(name):
            row["keys"] = [held] + row["keys"]
            groups["Super"].append(row)

    for name, rows in groups.items():
        # Two dispatchers on one key (float, then raise) is one bind to a
        # reader; keep the first, which is the one the comment describes.
        # Two bare keys with one label (Play, Pause) share a row the same way.
        seen, deduped = set(), []
        for row in collapse_directions(rows):
            if tuple(row["keys"]) in seen:
                continue
            seen.add(tuple(row["keys"]))
            twin = next((r for r in deduped if r["label"] == row["label"]
                         and r["chord"] == row["chord"] and len(row["keys"]) == 1
                         and not set(r["keys"]) & set(CHORD_ORDER)),
                        None)
            if twin:
                twin["keys"].append(row["keys"][0])
            else:
                deduped.append(row)
        groups[name] = deduped
    return groups


# ── tmux ─────────────────────────────────────────────────────────────────────

# tmux ships a note on every binding it considers worth documenting — the set
# `prefix ?` shows. These are the ones that are still noise on a sheet you scan.
TMUX_SKIP = re.compile(
    r"client|paste buffer|marked pane|Show messages|Customize options|"
    r"window information|Describe key binding|List key bindings|Show a clock|"
    r"visible part of the window|pane numbers|by 1$|mirrored layout|"
    r"Prompt for window index|window with an alert|in reverse|"
    r"^Resize the pane (up|down|left|right)( by 5)?$|menu$|floating pane|"
    r"^Move the current window$|^Break pane|^Swap the active pane|"
    r"^Spread panes|^Rotate through|and scroll up$")

TMUX_COLLAPSE = [
    (re.compile(r"^Select window \d$"), ["0–9"], "Select window by number"),
    (re.compile(r"^(Set|Select) the \S+ layout$"), ["Alt", "1–5"], "Set a layout"),
    (re.compile(r"^Resize pane (up|down|left|right)$"), ["H", "J", "K", "L"], "Resize pane"),
    (re.compile(r"^Select the pane (above|below|to the left of|to the right of) "
                r"the active pane$"), ["←", "↓", "↑", "→"], "Select pane"),
]

# C-a is a prefix you press and release, not a chord you keep down: nothing is
# still held by the time you type the second key, so no chord reaches these and
# holding Ctrl must not summon the whole tmux table. Empty, not None -- they are
# reachable, just not by holding something.
TMUX_PREFIX = frozenset()

TMUX_KEY_NAMES = {"PPage": ["PgUp"], "NPage": ["PgDn"],
                  "C-o": ["Ctrl", "O"], "C-y": ["Ctrl", "Y"]}


def tmux_keys():
    """(key, note) for every noted binding under the C-a prefix."""
    try:
        out = subprocess.run(["tmux", "list-keys", "-N"], capture_output=True,
                             text=True, timeout=3)
    except (OSError, subprocess.SubprocessError):
        return []
    if out.returncode != 0:
        return []
    keys = []
    for line in out.stdout.splitlines():
        parts = line.split(None, 2)
        if len(parts) == 3 and parts[0] == "C-a":
            keys.append((parts[1], parts[2].strip()))
    return keys


def tmux_rows(keys):
    rows, collapsed = [], set()
    for key, note in keys:
        if TMUX_SKIP.search(note):
            continue
        for pattern, keys, label in TMUX_COLLAPSE:
            if pattern.match(note):
                if label not in collapsed:
                    collapsed.add(label)
                    rows.append({"keys": list(keys), "label": label,
                                 "chord": TMUX_PREFIX})
                break
        else:
            rows.append({"keys": TMUX_KEY_NAMES.get(key, [key]), "label": note,
                         "chord": TMUX_PREFIX})
    return rows


# ── kitty ────────────────────────────────────────────────────────────────────

# The one hand-kept list on the sheet. kitty has no way to report its bindings,
# and its shipped config lists 94 defaults, which is documentation, not a sheet.
# kitty_mod, unlike tmux's prefix, is a genuine chord: Ctrl and Shift stay down
# while you press the key.
KITTY_MOD = frozenset({"Ctrl", "Shift"})

KITTY_ROWS = [
    (["Enter"], "New split"), (["W"], "Close split"),
    (["]"], "Next split"), (["["], "Previous split"),
    (["T"], "New tab"), (["Q"], "Close tab"),
    (["→"], "Next tab"), (["←"], "Previous tab"),
    (["↑"], "Scroll one line up"), (["↓"], "Scroll one line down"),
    (["H"], "Open the scrollback in a pager"),
    (["F5"], "Reload kitty.conf"),
]


# ── sheet ────────────────────────────────────────────────────────────────────

def build_sheet(tmux_bindings):
    groups = hyprland_groups()
    tmux = tmux_rows(tmux_bindings)
    if tmux:
        groups["Tmux"] = tmux
    groups["Kitty"] = [{"keys": list(k), "label": v, "chord": KITTY_MOD}
                       for k, v in KITTY_ROWS]

    ordered = [(n, groups[n]) for n in GROUP_ORDER if groups.get(n)]
    ordered += [(n, r) for n, r in sorted(groups.items()) if n not in GROUP_ORDER and r]
    return ordered


# Every heading answers the same question: what do you hold to get here.
GROUP_HEAD = {
    "Super": (["Super"], None),
    "Super + Shift": (["Super", "Shift"], None),
    "Super + Ctrl": (["Super", "Ctrl"], None),
    "Super + Alt": (["Super", "Alt"], None),
    "Resize mode": (["Super", "A"], "resize mode, Esc to leave"),
    "Notification panel": (["Super", "."], "while the panel is open"),
    "Tmux": (["Ctrl", "A"], "tmux"),
    "Kitty": (["Ctrl", "Shift"], "kitty"),
    "No prefix": (None, "no prefix"),
    "Unfiled": (None, "no label — add a trailing -- comment in hyprland.lua"),
}


CHORD_ORDER = ("Super", "Ctrl", "Alt", "Shift")


# Tracked as key presses and releases rather than through a modifier bitmask.
# Under Hyprland neither GdkDevice's modifier-state nor the key controller's
# "modifiers" signal moves when a modifier is held on its own -- the first never
# updates for Super at all, the second only fires alongside some other key --
# but the bare Super_L press itself is delivered.
MOD_KEYS = {
    Gdk.KEY_Super_L: "Super", Gdk.KEY_Super_R: "Super",
    Gdk.KEY_Control_L: "Ctrl", Gdk.KEY_Control_R: "Ctrl",
    Gdk.KEY_Alt_L: "Alt", Gdk.KEY_Alt_R: "Alt",
    Gdk.KEY_Meta_L: "Alt", Gdk.KEY_Meta_R: "Alt",
    Gdk.KEY_Shift_L: "Shift", Gdk.KEY_Shift_R: "Shift",
}


def pack(groups, columns=COLUMNS):
    """Balance the columns, then put each one back into reading order.

    Placing the groups in reading order leaves whichever big group comes last
    stacked onto an already-tall column, which is what makes one column run to
    the bottom of the screen while its neighbour ends halfway. Longest-first
    fixes that; the sheet's height is then just its largest single group.
    """
    order = {name: i for i, (name, _) in enumerate(groups)}
    cols = [[] for _ in range(columns)]
    heights = [0] * columns
    for name, rows in sorted(groups, key=lambda g: -len(g[1])):
        i = heights.index(min(heights))
        cols[i].append((name, rows))
        heights[i] += len(rows) + 3
    cols = [sorted(c, key=lambda g: order[g[0]]) for c in cols if c]
    return sorted(cols, key=lambda c: order[c[0][0]])


# ── keyboard ─────────────────────────────────────────────────────────────────

# The same binds, filed by the physical key instead of by row: a layer is the
# mode you are in (a submap, tmux's prefix, or none) plus the modifiers held,
# and every key is named by the legend on its unshifted cap.

CAP_ALIASES = {
    "escape": "esc", "bspace": "backspace", "return": "enter", "kp_enter": "enter",
    "iso_left_tab": "tab", "slash": "/", "semicolon": ";", "period": ".",
    "comma": ",", "minus": "-", "equal": "=", "grave": "`", "apostrophe": "'",
    "bracketleft": "[", "bracketright": "]", "backslash": "\\",
    "←": "left", "→": "right", "↑": "up", "↓": "down",
    "ppage": "pgup", "prior": "pgup", "npage": "pgdn", "next": "pgdn", "dc": "delete",
}

CAP_LEGENDS = {
    "esc": "Esc", "print": "Prt", "backspace": "⌫", "tab": "Tab", "caps": "Caps",
    "enter": "Enter", "shift": "Shift", "ctrl": "Ctrl", "super": "Super",
    "alt": "Alt", "space": "", "left": "←", "right": "→", "up": "↑", "down": "↓",
    "pgup": "PgUp", "pgdn": "PgDn", "delete": "Del",
}

MOD_CAPS = {"super": "Super", "ctrl": "Ctrl", "alt": "Alt", "shift": "Shift"}

# (top edge, [(cap, width)]) in key units; a None cap is a gap. "updown" is the
# half-height ↑ over ↓ pair of a laptop arrow cluster.
BOARD_ROWS = [
    (0.0, [("esc", 1), (None, 0.5)] + [(f"f{i}", 1) for i in range(1, 13)]
     + [(None, 0.5), ("print", 1)]),
    (1.25, [(c, 1) for c in "`1234567890-="] + [("backspace", 2)]),
    (2.25, [("tab", 1.5)] + [(c, 1) for c in "qwertyuiop[]"] + [("\\", 1.5)]),
    (3.25, [("caps", 1.75)] + [(c, 1) for c in "asdfghjkl;'"] + [("enter", 2.25)]),
    (4.25, [("shift", 2.25)] + [(c, 1) for c in "zxcvbnm,./"] + [("shift", 2.75)]),
    (5.25, [("ctrl", 1.25), ("super", 1.25), ("alt", 1.25), ("space", 5.75),
            ("alt", 1.25), ("ctrl", 1.25), ("left", 1), ("updown", 1), ("right", 1)]),
]
BOARD_PITCH = 50
BOARD_GAP = 5

SHIFTED = dict(zip('~!@#$%^&*()_+{}|:"<>?', "`1234567890-=[]\\;',./"))
TMUX_MODS = {"C": "Ctrl", "M": "Alt", "S": "Shift"}
PREFIX_GROUP = {**SUBMAP_GROUPS, "tmux": "Tmux"}


def cap_id(token):
    token = token.lower()
    return CAP_ALIASES.get(token, token)


def cap_legend(cap, fallback=None):
    if cap in CAP_LEGENDS:
        return CAP_LEGENDS[cap]
    return cap.upper() if len(cap) <= 3 else (fallback or cap)


def board_binds(tmux_bindings):
    """{(mode, held modifiers, cap): [bind]} plus a legend for every cap seen."""
    board, legends = {}, {}

    def add(mode, mods, token, combo, label, note=""):
        cap = cap_id(token)
        legends.setdefault(cap, cap_legend(cap, key_name(token)))
        binds = board.setdefault((mode, frozenset(mods), cap), [])
        if all(b["combo"] != combo for b in binds):
            binds.append({"combo": combo, "label": label, "note": note})

    for bind in parse_hyprland():
        tokens = bind["key"].split(" + ")
        head = [m for m in CHORD_ORDER if m in bind["mods"]]
        label = (bind["label"] or "no label").capitalize()
        span = re.fullmatch(r"<(\d+)-(\d+)>", tokens[-1])
        if not span:
            add(bind["submap"], bind["mods"], tokens[-1],
                head + [key_name(tokens[-1])], label)
            continue
        lo, hi = int(span.group(1)), int(span.group(2))
        for digit in range(lo, hi + 1):
            # `i % 10` puts workspace 10 on the 0 key.
            n = 10 if lo == 0 and digit == 0 else digit
            named = (label.replace("<n>", str(n)) if "<n>" in label
                     else f"{label} {n}" if label.endswith("workspace") else label)
            add(bind["submap"], bind["mods"], str(digit), head + [str(digit)], named)

    for key, note in tmux_bindings:
        mods, token = set(), key
        while (m := re.fullmatch(r"([CMS])-(.+)", token)):
            mods.add(TMUX_MODS[m.group(1)])
            token = m.group(2)
        shown = [m for m in CHORD_ORDER if m in mods]
        legend = TMUX_KEY_NAMES.get(token, [token])[-1]
        if token in SHIFTED:
            # `%` is typed as Shift + 5, but reads better as itself.
            mods.add("Shift")
            base = SHIFTED[token]
        elif len(token) == 1 and token.isupper():
            mods.add("Shift")
            shown.append("Shift")
            base = token
        else:
            base = token
        add("tmux", mods, base, ["Ctrl", "A"] + shown + [key_name(legend)], note)

    for keys, label in KITTY_ROWS:
        add("", KITTY_MOD, keys[-1], ["Ctrl", "Shift", *keys], label, "kitty")

    return board, legends


# ── ui ───────────────────────────────────────────────────────────────────────

