#!/usr/bin/env python3
"""hypr-accent: set the active-window border from the wallpaper's dominant hue.

Same sampler as the dash visualizer (~/projects/dash/qml/Dashboard.qml): a
48x48 downscale, saturated mid-tone pixels bucketed by hue in 15 degree bins,
the heaviest bin wins. Only the hue comes from the picture; saturation and
lightness are clamped so the border reads the same on every wallpaper. A
monochrome picture keeps the fallback blue.

Writes ~/.cache/hypr-accent (hyprland.lua reads it at config load, so a reload
keeps the color) and applies it live with `hyprctl eval`.

usage: hypr-accent [image]   default: ~/Media/wallpapers/.current
"""
import colorsys
import math
import os
import subprocess
import sys

FALLBACK = "0080ff"
SIZE = 48
CACHE = os.path.expanduser("~/.cache/hypr-accent")


def dominant_hue(path):
    raw = subprocess.run(
        ["magick", path + "[0]", "-resize", f"{SIZE}x{SIZE}!", "-depth", "8", "rgb:-"],
        check=True, capture_output=True,
    ).stdout
    w = [0.0] * 24
    sh = [0.0] * 24
    ch = [0.0] * 24
    sa = [0.0] * 24
    n = [0] * 24
    for i in range(0, len(raw) - 2, 3):
        r, g, b = raw[i] / 255, raw[i + 1] / 255, raw[i + 2] / 255
        mx, mn = max(r, g, b), min(r, g, b)
        light, c = (mx + mn) / 2, mx - mn
        if c < 0.12 or light < 0.08 or light > 0.92:
            continue
        if mx == r:
            h = ((g - b) / c) % 6
        elif mx == g:
            h = (b - r) / c + 2
        else:
            h = (r - g) / c + 4
        h = (h * 60) % 360
        s = c / ((1 - abs(2 * light - 1)) or 1)
        k = int(h // 15) % 24
        wt = s * (1 - abs(light - 0.55) * 1.2)
        w[k] += wt
        sh[k] += math.sin(math.radians(h)) * wt
        ch[k] += math.cos(math.radians(h)) * wt
        sa[k] += s
        n[k] += 1
    best = max(range(24), key=lambda k: w[k])
    if w[best] <= 0:
        return None
    hue = math.degrees(math.atan2(sh[best], ch[best])) % 360
    sat = min(0.85, max(0.4, sa[best] / n[best] * 1.15)) if n[best] else 0.5
    return hue, sat


def main():
    path = sys.argv[1] if len(sys.argv) > 1 else os.path.expanduser("~/Media/wallpapers/.current")
    try:
        found = dominant_hue(os.path.realpath(path))
    except (OSError, subprocess.CalledProcessError) as e:
        print(f"hypr-accent: {e}", file=sys.stderr)
        found = None
    if found:
        hue, sat = found
        r, g, b = colorsys.hls_to_rgb(hue / 360, 0.76, sat)
        color = f"{round(r * 255):02x}{round(g * 255):02x}{round(b * 255):02x}"
    else:
        color = FALLBACK
    os.makedirs(os.path.dirname(CACHE), exist_ok=True)
    with open(CACHE, "w") as f:
        f.write(color + "\n")
    subprocess.run(
        ["hyprctl", "eval",
         f'hl.config({{ general = {{ col = {{ active_border = "rgba({color}ee)" }} }} }})'],
        check=False, capture_output=True,
    )
    print(color)


main()
