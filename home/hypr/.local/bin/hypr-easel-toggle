#!/usr/bin/env bash
# Super+E: show or hide Easel. Focused: Easel hides to its tray icon, its
# boards still open. Shown but not focused: bring it to the workspace on
# screen, floating at 80% of the monitor, centred and focused. Hidden, or
# not running: launch it, which shows the windows it hid or starts it;
# hyprland.lua's easel-float rule floats each window that way as it maps.
# A board floating over the screen (Easel's overlay mode, Ctrl+Shift+O)
# is a layer surface named after the app, and its window is hidden
# meanwhile: this then only ends the board's click-through (Ctrl+Shift+Y),
# the one way back from it, since the board takes no input while it lasts.
# The development window (dev.jaeho.Easel.Devel) is never matched.

class=dev.jaeho.Easel

# The window to show: the last focused.
easel_window() {
    hyprctl clients -j | jq -r --arg c "$class" '
        map(select(.class == $c)) | sort_by(.focusHistoryID) | .[0].address // empty'
}

# Place and focus window $1 in one eval, so it never shows half placed. The
# target is what the focused monitor shows: a raised special workspace (the
# scratchpad) covers the regular one, which is all activeworkspace reports.
# The resize dispatcher takes pixels, so easel-float's 80% of the monitor
# is worked out here.
show() {
    local width height ws lua
    read -r width height ws < <(hyprctl monitors -j | jq -r '
        .[] | select(.focused)
        | (if .transform % 2 == 1 then [.height, .width] else [.width, .height] end) as [$pw, $ph]
        | ($pw / .scale * 0.8 | floor) as $w
        | ($ph / .scale * 0.8 | floor) as $hh
        | (if .specialWorkspace.name != "" then .specialWorkspace.name
           else .activeWorkspace.id end | tojson) as $ws
        | "\($w) \($hh) \($ws)"')
    [[ -n $ws ]] || return 1
    lua="local w = 'address:$1'"
    lua+=" hl.dispatch(hl.dsp.window.move({ workspace = $ws, window = w }))"
    lua+=" hl.dispatch(hl.dsp.window.float({ action = 'enable', window = w }))"
    lua+=" hl.dispatch(hl.dsp.window.resize({ x = $width, y = $height, window = w }))"
    lua+=" hl.dispatch(hl.dsp.window.center({ window = w }))"
    lua+=" hl.dispatch(hl.dsp.focus({ window = w }))"
    hyprctl eval "$lua" >/dev/null
}

# The PID of the Easel whose board floats over the screen, if one does.
floating_pid() {
    hyprctl layers -j | jq -r --arg c "$class" '
        [.[].levels[][] | select(.namespace == $c) | .pid] | .[0] // empty'
}

# Run the easel CLI built beside Easel $1's binary, so a branch build
# answers too.
easel_of() {
    local cli
    cli=$(dirname "$(readlink "/proc/$1/exe")")/easel
    [[ -x $cli ]] || cli=easel
    shift
    EASEL_NO_REBUILD=1 "$cli" "$@" >/dev/null
}

active=$(hyprctl activewindow -j)
if pid=$(floating_pid) && [[ -n $pid ]]; then
    easel_of "$pid" click-through off
elif [[ $(jq -r '.class // empty' <<<"$active") == "$class" ]]; then
    easel_of "$(jq -r '.pid' <<<"$active")" hide
elif addr=$(easel_window) && [[ -n $addr ]]; then
    show "$addr"
else
    setsid -f easel-gtk >/dev/null 2>&1
fi
