#!/usr/bin/env bash
# hypr-failed-units — the waybar 󰀨 click menu (and the settings panel row).
#
# The menu lists each failed unit once. Picking a row opens its status in a
# tmux pane and prints the journalctl command to copy. waybar loads menu-file
# once at startup and runs static menu-actions, so this script *writes* the
# menu (labels + the action map) and restarts the bar when the unit list
# changes.
#
#   hypr-failed-units          same as menu (settings panel)
#   hypr-failed-units sync     write the menu; restart waybar if it changed
#   hypr-failed-units menu     Gtk.Menu at the pointer (settings panel only)
#   hypr-failed-units open N   open map row N's status in a tmux pane
set -euo pipefail

PANE="$HOME/.local/bin/hypr-pane"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles"
MAP="$STATE/failed-units.map"
XML="$STATE/failed-units-menu.xml"
ACTIONS="$STATE/failed-units-menu-actions.jsonc"
MAX_UNITS=12

# ── gather ───────────────────────────────────────────────────────────────────
# Map lines: "scope<TAB>unit". Menu rows follow the same order.
write_map() {
    mkdir -p "$STATE"
    local tmp scope flag unit
    tmp=$(mktemp)
    for scope in system user; do
        flag=""
        [ "$scope" = user ] && flag="--user"
        # shellcheck disable=SC2086  # flag is "" or --user
        systemctl $flag --failed --no-pager -o json 2>/dev/null |
            jq -r --argjson limit "$MAX_UNITS" \
                '.[:$limit][] | .unit // .name' 2>/dev/null |
            while read -r unit; do
                [ -n "$unit" ] || continue
                printf '%s\t%s\n' "$scope" "$unit"
            done
    done | sort >"$tmp"
    mv "$tmp" "$MAP"
}

xml_escape() {
    local s=$1
    s=${s//&/&amp;}
    s=${s//</&lt;}
    s=${s//>/&gt;}
    s=${s//\"/&quot;}
    printf '%s' "$s"
}

# One GtkMenuItem per map row. id "itemN" pairs with menu-actions "itemN".
write_menu() {
    local n=0 scope unit what label
    {
        printf '%s\n' '<?xml version="1.0" encoding="UTF-8"?>'
        printf '%s\n' '<!-- Generated by hypr-failed-units sync. Do not edit. -->'
        printf '%s\n' '<interface>'
        printf '%s\n' '  <object class="GtkMenu" id="menu">'
        while IFS=$'\t' read -r scope unit; do
            label="$scope · $unit"
            printf '    <child>\n'
            printf '      <object class="GtkMenuItem" id="item%s">\n' "$n"
            printf '        <property name="label">%s</property>\n' "$(xml_escape "$label")"
            printf '      </object>\n'
            printf '    </child>\n'
            n=$((n + 1))
        done <"$MAP"
        printf '%s\n' '  </object>'
        printf '%s\n' '</interface>'
    } >"$XML"

    {
        printf '%s\n' '{'
        printf '%s\n' '  // Generated by hypr-failed-units sync. Do not edit.'
        printf '%s\n' '  "systemd-failed-units": {'
        printf '%s\n' '    "menu-actions": {'
        n=0
        while IFS= read -r _; do
            [ "$n" -gt 0 ] && printf '%s\n' ','
            printf '      "item%s": "~/.local/bin/hypr-failed-units open %s"' "$n" "$n"
            n=$((n + 1))
        done <"$MAP"
        [ "$n" -gt 0 ] && printf '\n'
        printf '%s\n' '    }'
        printf '%s\n' '  }'
        printf '%s\n' '}'
    } >"$ACTIONS"
}

map_sig() {
    # A cheap content hash so we restart only when the row list changed.
    md5sum "$MAP" 2>/dev/null | awk '{print $1}'
}

restart_waybar() {
    pkill -x waybar 2>/dev/null || true
    sleep 0.3
    # Straight to /dev/null, no `| grep` pipeline: waybar's long-lived
    # on-update children (the custom/swaync exec stream) inherit the pipe's
    # write end, so grep never sees EOF and this subshell waits forever.
    # The pipeline's output went to /dev/null anyway. The spawn outlives this
    # sync, so drop the lock fd before exec.
    (exec 9>&-
        cd "$HOME/.config/waybar" && setsid waybar >/dev/null 2>&1) &
}

sync_menu() {
    local before after
    # Serialize the read-decide-restart. Two on-update syncs can be in flight
    # at once: waybar runs the module's on-update twice at bar startup (the
    # module constructor's updateData emits on the dispatcher before bar setup
    # connects it, and glibmm queues that emit), and once per failed-units
    # change per bar. Both read the map before either writes, so both see a
    # change and both restart; restart_waybar's pkill/sleep/spawn cannot
    # dedupe a caller that lands in its sleep window, so both spawns survive
    # and the double feeds itself at the next change. Held through the
    # restart so the second run finds the map current and skips it.
    mkdir -p "$STATE"
    exec 9>"$STATE/hypr-failed-units.lock"
    flock 9
    before=$(map_sig || true)
    write_map
    write_menu
    after=$(map_sig)
    if [ "$before" != "$after" ] && pgrep -x waybar >/dev/null; then
        restart_waybar
    fi
    exec 9>&-
}

# ── open one view in a tmux pane ─────────────────────────────────────────────
sh_quote() {
    local s=$1
    printf "'%s'" "${s//\'/\'\\\'\'}"
}

open_index() {  # $1: map row number
    local n=$1 scope unit
    local -a cmd
    [ -f "$MAP" ] || { echo "hypr-failed-units: no map at $MAP" >&2; exit 1; }
    IFS=$'\t' read -r scope unit < <(sed -n "$((n + 1))p" "$MAP")
    [ -n "${scope:-}" ] || { echo "hypr-failed-units: map row $n missing" >&2; exit 1; }
    local flag=""
    [ "$scope" = user ] && flag="--user"
    if [ -n "$flag" ]; then
        cmd=(systemctl --user status "$unit" --no-pager -l)
    else
        cmd=(systemctl status "$unit" --no-pager -l)
    fi
    # Build the pane script with real newlines. A single-quoted '\n' is a
    # literal backslash-n and leaves `echo\necho` as one command name.
    local inner="" a
    for a in "${cmd[@]}"; do inner+=$(sh_quote "$a")' '; done
    inner+=$'\n'
    inner+="echo"$'\n'
    inner+="echo \"journal: journalctl${flag:+ $flag} -u $(sh_quote "$unit")\""$'\n'
    inner+="exec fish"
    exec "$PANE" -- sh -c "$inner"
}

# ── Gtk.Menu for the settings panel (waybar uses the generated menu-file) ────
menu_popup() {
    STATE="$STATE" python3 - <<'PY'
import os, sys
import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, Gtk

state = os.environ["STATE"]
path = os.path.join(state, "failed-units.map")
rows = []
if os.path.isfile(path):
    with open(path) as fh:
        for i, line in enumerate(fh):
            scope, unit = line.rstrip("\n").split("\t", 1)
            rows.append((i, f"{scope} · {unit}"))

if not rows:
    import subprocess
    subprocess.run(["notify-send", "-u", "low", "Failed units",
                    "Nothing failed in either scope."], check=False)
    sys.exit(0)

menu = Gtk.Menu()
for i, label in rows:
    item = Gtk.MenuItem(label=label)
    item.connect("activate", lambda _w, n=i: os.execv(
        os.path.expanduser("~/.local/bin/hypr-failed-units"),
        ["hypr-failed-units", "open", str(n)]))
    menu.append(item)
menu.connect("selection-done", Gtk.main_quit)
menu.connect("deactivate", Gtk.main_quit)
menu.show_all()
menu.popup_at_pointer(None)
Gtk.main()
PY
}

none_failed() {
    notify-send -u low 'Failed units' 'Nothing failed in either scope.'
}

case "${1:-menu}" in
    sync) sync_menu ;;
    open) shift; open_index "${1:?open needs a row index}" ;;
    menu)
        sync_menu
        if [ ! -s "$MAP" ]; then none_failed; exit 0; fi
        menu_popup
        ;;
    *) echo "usage: hypr-failed-units [sync|menu|open N]" >&2; exit 2 ;;
esac
