#!/usr/bin/env bash
# hypr-failed-units — what the waybar 󰀨 count and the settings panel's
# "Failed units" row open. Each failed unit contributes two rows, status and
# journal; picking one opens that view in a tmux pane.
set -euo pipefail

PANE="$HOME/.local/bin/hypr-pane"

# specs[i] is "scope unit what"; lines[i] is its rofi row.
specs=() lines=()
gather() {
    while IFS=$'\t' read -r scope unit load desc; do
        if [ "$load" = "not-found" ]; then desc="unit file missing, still referenced"; fi
        specs+=("$scope $unit status")
        lines+=("$scope · $unit · status — $desc")
        specs+=("$scope $unit journal")
        lines+=("$scope · $unit · journal")
    done < <(
        systemctl --failed --no-pager -o json 2>/dev/null | jq -r '.[] | ["system", .unit, .load, .description] | @tsv'
        systemctl --user --failed --no-pager -o json 2>/dev/null | jq -r '.[] | ["user", .unit, .load, .description] | @tsv'
    )
}

none_failed() {
    notify-send -u low 'Failed units' 'Nothing failed in either scope.'
}

# One unit's status or journal in a tmux pane (splits the focused client's
# pane when the focus is on tmux; a fresh kitty+tmux otherwise). A shell
# follows so you can keep poking at it.
open_view() {  # $1: "scope unit status|journal"
    local scope unit what flag
    read -r scope unit what <<<"$1"
    flag=""
    if [ "$scope" = user ]; then flag="--user"; fi
    exec "$PANE" -- env FLAG="$flag" UNIT="$unit" WHAT="$what" sh -c '
        set -- $FLAG
        if [ "$WHAT" = journal ]; then
            journalctl "$@" -u "$UNIT" -n 150 --no-pager
        else
            systemctl "$@" status "$UNIT" --no-pager -l
        fi
        echo
        echo "a shell follows — exit closes this pane"
        exec fish'
}

menu() {
    local choice
    # -format i prints the picked row's index.
    choice=$(printf '%s\n' "${lines[@]}" |
        rofi -dmenu -i -format i -p 'Failed units') || exit 0
    [ -n "$choice" ] || exit 0
    open_view "${specs[$choice]}"
}

gather
[ ${#specs[@]} -gt 0 ] || { none_failed; exit 0; }

case "${1:-menu}" in
    menu) menu ;;
    *) echo "usage: hypr-failed-units [menu]" >&2; exit 2 ;;
esac
