#!/usr/bin/env bash
# hypr-failed-units — the waybar 󰀨 click handler (and the settings panel row).
#
# Opens the failed unit(s) in a tmux pane: status first, then the journalctl
# line to copy, then a shell. No picker. If nothing has failed, a notify.
# Each unit is a fake prompt block (OSC 133;A), so prefix C-y copies the last
# unit's status and journal hint the same way it copies a real command's
# output. Waybar is never restarted for this (a bar load drops the SNI tray
# host and pops tray-hidden apps such as Spotify).
#
#   hypr-failed-units          open the failed unit(s) in a tmux pane
#   hypr-failed-units open N   open map row N only
set -euo pipefail

PANE="$HOME/.local/bin/hypr-pane"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles"
MAP="$STATE/failed-units.map"
MAX_UNITS=12

# ── gather ───────────────────────────────────────────────────────────────────
# Map lines: "scope<TAB>unit". Pane content follows the same order.
write_map() {
    mkdir -p "$STATE"
    local tmp scope flag unit
    tmp=$(mktemp)
    for scope in system user; do
        flag=""
        [ "$scope" = user ] && flag="--user"
        # shellcheck disable=SC2086  # flag is "" or --user
        systemctl $flag --failed --no-pager -o json 2>/dev/null |
            jq -r --argjson limit "$MAX_UNITS" \
                '.[:$limit][] | .unit // .name' 2>/dev/null |
            while read -r unit; do
                [ -n "$unit" ] || continue
                printf '%s\t%s\n' "$scope" "$unit"
            done
    done | sort >"$tmp"
    mv "$tmp" "$MAP"
}

# ── pane script ──────────────────────────────────────────────────────────────
sh_quote() {
    local s=$1
    printf "'%s'" "${s//\'/\'\\\'\'}"
}

# Prefix C-y ("copy last command and its output") walks OSC 133;A marks
# (theme.fish). The dump is one prompt block per unit: mark on the context
# line, a fake ❯ line, then status and the journal hint. C-y's two
# cursor-downs from the mark land on the first status line, so the yank is
# the message (status + journal hint), not the fake prompt. Without marks
# there is no previous-prompt target and C-y collapses onto the live ❯
# (gotcha #47).
emit_prompt_block() {  # $1 = context, $2 = command text (no ❯)
    inner+=$'\n'
    inner+="printf '\\n\\033]133;A\\033\\\\'"$'\n'
    inner+="echo $(sh_quote "$1")"$'\n'
    inner+="echo $(sh_quote "❯ $2")"$'\n'
}

# Build the pane script with real newlines. A single-quoted '\n' is a
# literal backslash-n and leaves `echo\necho` as one command name.
pane_open() {  # "$@" = map row numbers (default: every row)
    local scope unit flag a display unit_q inner=""
    local -a rows=() cmd
    if [ "$#" -gt 0 ]; then
        rows=("$@")
    else
        local n=0
        while IFS= read -r _; do rows+=("$n"); n=$((n + 1)); done <"$MAP"
    fi
    [ "${#rows[@]}" -gt 0 ] || {
        notify-send -u low 'Failed units' 'Nothing failed in either scope.'
        return 0
    }
    for n in "${rows[@]}"; do
        IFS=$'\t' read -r scope unit < <(sed -n "$((n + 1))p" "$MAP")
        [ -n "${scope:-}" ] || continue
        flag=""
        [ "$scope" = user ] && flag="--user"
        unit_q=$(sh_quote "$unit")
        if [ -n "$flag" ]; then
            cmd=(systemctl --user status "$unit" --no-pager -l)
            display="systemctl --user status $unit_q --no-pager -l"
        else
            cmd=(systemctl status "$unit" --no-pager -l)
            display="systemctl status $unit_q --no-pager -l"
        fi
        emit_prompt_block "$scope/$unit" "$display"
        for a in "${cmd[@]}"; do inner+=$(sh_quote "$a")' '; done
        inner+=$'\n'
        inner+="echo"$'\n'
        inner+="echo \"journal: journalctl${flag:+ $flag} -u $unit_q\""$'\n'
        inner+="echo"$'\n'
    done
    inner+="exec fish"
    exec "$PANE" -- sh -c "$inner"
}

write_map
if [ "${1:-}" = "open" ]; then
    shift
    pane_open "${1:?open needs a row index}"
else
    pane_open
fi
