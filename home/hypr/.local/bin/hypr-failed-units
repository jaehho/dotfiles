#!/usr/bin/env bash
# hypr-failed-units — the waybar 󰀨 click menu (and the settings panel row).
#
# The menu lists each failed unit once. Picking a row opens its status in a
# tmux pane and prints the journalctl command to copy. The map is rebuilt on
# each open. The popup is our own layer-shell Gtk menu, styled like waybar's
# power/reboot menus. Waybar is never restarted or reloaded for this: both
# drop the SNI tray host and pop tray-hidden apps such as Spotify.
#
#   hypr-failed-units          same as menu (settings panel)
#   hypr-failed-units menu     Gtk menu at the pointer
#   hypr-failed-units open N   open map row N's status in a tmux pane
set -euo pipefail

PANE="$HOME/.local/bin/hypr-pane"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles"
MAP="$STATE/failed-units.map"
MAX_UNITS=12

# ── gather ───────────────────────────────────────────────────────────────────
# Map lines: "scope<TAB>unit". Menu rows follow the same order.
write_map() {
    mkdir -p "$STATE"
    local tmp scope flag unit
    tmp=$(mktemp)
    for scope in system user; do
        flag=""
        [ "$scope" = user ] && flag="--user"
        # shellcheck disable=SC2086  # flag is "" or --user
        systemctl $flag --failed --no-pager -o json 2>/dev/null |
            jq -r --argjson limit "$MAX_UNITS" \
                '.[:$limit][] | .unit // .name' 2>/dev/null |
            while read -r unit; do
                [ -n "$unit" ] || continue
                printf '%s\t%s\n' "$scope" "$unit"
            done
    done | sort >"$tmp"
    mv "$tmp" "$MAP"
}

# ── open one view in a tmux pane ─────────────────────────────────────────────
sh_quote() {
    local s=$1
    printf "'%s'" "${s//\'/\'\\\'\'}"
}

open_index() {  # $1: map row number
    local n=$1 scope unit
    local -a cmd
    [ -f "$MAP" ] || { echo "hypr-failed-units: no map at $MAP" >&2; exit 1; }
    IFS=$'\t' read -r scope unit < <(sed -n "$((n + 1))p" "$MAP")
    [ -n "${scope:-}" ] || { echo "hypr-failed-units: map row $n missing" >&2; exit 1; }
    local flag=""
    [ "$scope" = user ] && flag="--user"
    if [ -n "$flag" ]; then
        cmd=(systemctl --user status "$unit" --no-pager -l)
    else
        cmd=(systemctl status "$unit" --no-pager -l)
    fi
    # Build the pane script with real newlines. A single-quoted '\n' is a
    # literal backslash-n and leaves `echo\necho` as one command name.
    local inner="" a
    for a in "${cmd[@]}"; do inner+=$(sh_quote "$a")' '; done
    inner+=$'\n'
    inner+="echo"$'\n'
    inner+="echo \"journal: journalctl${flag:+ $flag} -u $(sh_quote "$unit")\""$'\n'
    inner+="exec fish"
    exec "$PANE" -- sh -c "$inner"
}

# ── popup: same Gtk look as waybar's power menu ──────────────────────────────
# waybar's menu-file is read once per bar load, and any load (pkill or
# SIGUSR2 reload) drops the SNI tray host. A layer-shell window can pop at
# the cursor without touching the bar. Styled from waybar style.css's menu
# block (Catppuccin Mocha, 12px window / 8px item radii).
menu_popup() {
    STATE="$STATE" python3 - <<'PY'
import os, sys, subprocess
import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import Gdk, GLib, Gtk, GtkLayerShell

state = os.environ["STATE"]
path = os.path.join(state, "failed-units.map")
rows = []
if os.path.isfile(path):
    with open(path) as fh:
        for i, line in enumerate(fh):
            if not line.strip():
                continue
            scope, unit = line.rstrip("\n").split("\t", 1)
            rows.append((i, f"{scope} · {unit}"))

if not rows:
    subprocess.run(["notify-send", "-u", "low", "Failed units",
                    "Nothing failed in either scope."], check=False)
    sys.exit(0)

try:
    out = subprocess.check_output(["hyprctl", "cursorpos"], text=True)
    x, y = (int(p) for p in out.strip().split(",", 1))
except Exception:
    x, y = 400, 300

# Menu chrome, matching waybar's menu / menuitem rules.
css = b"""
window { background: transparent; }
.menu {
    background-color: #1e1e2e;
    color: #cdd6f4;
    border: 1px solid rgba(137, 180, 250, 0.18);
    border-radius: 12px;
    padding: 4px;
    font: 11px "Inter", "Cantarell", sans-serif;
}
.row {
    border-radius: 8px;
    padding: 4px 12px;
}
.row:hover { background-color: rgba(137, 180, 250, 0.14); }
"""
provider = Gtk.CssProvider()
provider.load_from_data(css)
screen = Gdk.Screen.get_default()
if screen is not None:
    Gtk.StyleContext.add_provider_for_screen(
        screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

# Full-output catcher: a click anywhere else dismisses, like a real menu.
win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
win.set_title("failed-units")
GtkLayerShell.init_for_window(win)
GtkLayerShell.set_layer(win, GtkLayerShell.Layer.OVERLAY)
for edge in (GtkLayerShell.Edge.TOP, GtkLayerShell.Edge.LEFT,
             GtkLayerShell.Edge.RIGHT, GtkLayerShell.Edge.BOTTOM):
    GtkLayerShell.set_anchor(win, edge, True)
GtkLayerShell.set_namespace(win, "failed-units-menu")
GtkLayerShell.set_keyboard_mode(win, GtkLayerShell.KeyboardMode.ON_DEMAND)

overlay = Gtk.EventBox()
overlay.set_visible_window(False)
outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
outer.set_halign(Gtk.Align.START)
outer.set_valign(Gtk.Align.START)
outer.set_margin_top(max(0, y))
outer.set_margin_start(max(0, x))
overlay.add(outer)
win.add(overlay)

box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
box.get_style_context().add_class("menu")
outer.pack_start(box, False, False, 0)

def close(*_args):
    win.destroy()
    return False

def on_pick(_row, n):
    win.destroy()
    # Same argv shape as the old menu-actions "itemN" commands.
    os.execv(os.path.expanduser("~/.local/bin/hypr-failed-units"),
             ["hypr-failed-units", "open", str(n)])

for i, label in rows:
    row = Gtk.EventBox()
    row.get_style_context().add_class("row")
    lab = Gtk.Label(label=label, xalign=0)
    lab.set_margin_top(2)
    lab.set_margin_bottom(2)
    lab.set_margin_start(8)
    lab.set_margin_end(8)
    row.add(lab)
    row.connect("button-press-event", lambda _w, _e, n=i: on_pick(None, n))
    box.pack_start(row, False, False, 0)

overlay.connect("button-press-event", lambda *_: close())
win.connect("key-press-event", lambda _w, ev: close() if ev.keyval == Gdk.KEY_Escape else False)
win.connect("destroy", Gtk.main_quit)
win.show_all()
win.present()
Gtk.main()
PY
}

case "${1:-menu}" in
    open) shift; open_index "${1:?open needs a row index}" ;;
    menu)
        write_map
        menu_popup
        ;;
    *) echo "usage: hypr-failed-units [menu|open N]" >&2; exit 2 ;;
esac
