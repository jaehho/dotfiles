#!/usr/bin/env bash
# Failed-units menu — what the waybar 󰀨 count and the settings panel's
# "Failed units" row open, instead of a bare systemctl dump. Enter on the top
# row hands every failed unit to Claude the way `dotfiles decide` hands over
# decisions (claude-open --dangerously-skip-permissions in a tmux window);
# picking a unit offers the same per unit, or status and journal to read.
set -euo pipefail

DOTFILES="$HOME/dotfiles"
PANE="$HOME/.local/bin/hypr-pane"

# Single-quote argv for `fish -c`. In fish '', only \\ and \' are escapes.
# (Same helper as the dotfiles dispatcher.)
fish_cmd() {
    local out=() a
    for a in "$@"; do
        a=${a//\\/\\\\}
        a=${a//\'/\\\'}
        out+=("'$a'")
    done
    printf '%s' "${out[*]}"
}

BRIEF=$(cat <<'EOF'
This session was opened from the failed-units indicator (waybar or the settings panel): systemd reports failed units in the system and/or user scope. Diagnose each one yourself from status and journals; never ask the owner to paste output.

Usual resolutions:
- a broken unit: journalctl [--user] -e -u <unit> shows the failure; fix the unit or its config, restart it, verify with systemctl [--user] --failed.
- a not-found unit: something still references a unit file that no longer exists (Wants=/Requires=, an enablement symlink, a timer left in memory). Remove the reference at the source; reset-failed only hides it until the next trigger.
- a unit stowed from ~/dotfiles (home/*/.config/systemd/user): fix it there, small WIP commits.
- a unit owned by an app under ~/projects: the app owns the fix; work there.
Anything needing root: write a reviewed script to /tmp/<name>.sh for the owner to run with sudo; never run sudo yourself. The waybar indicator clears when both scopes list no failed units.
EOF
)

# The `dotfiles decide` launch: a Claude window in the most recently used tmux
# session, its terminal focused; a fresh kitty+tmux when no client is attached.
# Through fish so config.fish env applies; tmux execs a multi-arg command
# directly, which skips fish.
open_claude() {
    local cmd=(claude-open --dangerously-skip-permissions
        --append-system-prompt "$BRIEF" "$1")
    local fcmd=(fish -c "$(fish_cmd "${cmd[@]}")")
    local client addr
    client=$({ tmux list-clients -F '#{client_activity} #{client_pid}' 2>/dev/null || true; } |
        sort -rn | head -1 | cut -d' ' -f2)
    if [ -z "$client" ]; then
        exec kitty tmux new-session -c "$DOTFILES" "${fcmd[@]}"
    fi
    tmux new-window -c "$DOTFILES" -n failed-units "${fcmd[@]}"
    addr=$(hyprctl clients -j | jq -r --argjson pid "$(ps -o ppid= -p "$client")" \
        '.[] | select(.pid == $pid) | .address')
    [ -z "$addr" ] ||
        hyprctl dispatch "hl.dsp.focus({ window = \"address:$addr\" })" >/dev/null
}

# specs[i] is "scope unit"; lines[i] is its rofi row.
specs=() lines=()
while IFS=$'\t' read -r scope unit load desc; do
    specs+=("$scope $unit")
    if [ "$load" = "not-found" ]; then desc="unit file missing, still referenced"; fi
    lines+=("$scope · $unit — $desc")
done < <(
    systemctl --failed --no-pager -o json 2>/dev/null | jq -r '.[] | ["system", .unit, .load, .description] | @tsv'
    systemctl --user --failed --no-pager -o json 2>/dev/null | jq -r '.[] | ["user", .unit, .load, .description] | @tsv'
)

if [ ${#specs[@]} -eq 0 ]; then
    notify-send -u low 'Failed units' 'Nothing failed in either scope.'
    exit 0
fi

# -format i prints the picked row's index; row 0 is the hand-it-all-over row.
choice=$(printf '%s\n' "Fix with Claude (${#specs[@]} failed)" "${lines[@]}" |
    rofi -dmenu -i -format i -p 'Failed units') || exit 0
[ -n "$choice" ] || exit 0

if [ "$choice" -eq 0 ]; then
    open_claude "systemd reports ${#specs[@]} failed unit(s) across the system and user scopes. List them with systemctl --failed and systemctl --user --failed, diagnose each, and fix them."
    exit 0
fi

read -r scope unit <<<"${specs[$((choice - 1))]}"
action=$(printf '%s\n' 'Fix with Claude' 'Status & journal' |
    rofi -dmenu -i -p "$scope · $unit") || exit 0

case $action in
    'Fix with Claude')
        open_claude "The $scope-scope unit $unit is failing. Diagnose it and fix it." ;;
    'Status & journal')
        flag=""
        if [ "$scope" = user ]; then flag="--user"; fi
        # The failure to read, then a shell in the same pane to poke at it.
        exec "$PANE" --float floating-tui -- env FLAG="$flag" UNIT="$unit" sh -c '
            set -- $FLAG
            systemctl "$@" status "$UNIT" --no-pager -l
            echo
            journalctl "$@" -u "$UNIT" -n 100 --no-pager
            echo
            echo "a shell follows — exit closes this pane"
            exec fish' ;;
esac
