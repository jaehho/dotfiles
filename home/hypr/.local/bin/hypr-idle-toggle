#!/usr/bin/env bash
# Stay awake: no suspend, nothing else. One logind handle-lid-switch
# inhibitor, so closing the lid doesn't suspend; hypr-suspend-ok sees it
# and defers hypridle's idle suspend. The screen still dims, turns off and
# locks as usual. hypridle keeps running in both states: its lock_cmd is
# the only thing that answers logind's Lock, so Super+Escape, the bar's and
# the menu's Lock and the lock before a menu Suspend work with stay awake
# on. A menu Suspend still suspends.
#
#   hypr-idle-toggle        on, or off when it is on; with hypridle
#                           missing it only starts hypridle and leaves
#                           stay awake as it was (the bar shows that red)
#   hypr-idle-toggle off    off: Hyprland's start runs this in place of
#                           a bare `hypridle`
#
# The state is what is running, not a pidfile. The pidfile named only the
# newest inhibitor: a Hyprland restart relaunched hypridle under a held
# inhibitor, the next toggle saw hypridle and started a second one, and
# the first held the lid until a reboot. Off ends every inhibitor of ours.

WHO=hypr-lid-inhibit

# The systemd-inhibit processes holding our inhibitor, as logind lists them.
holders() {
    systemd-inhibit --list --no-legend --no-pager 2>/dev/null |
        awk -v who="$WHO" '$1 == who { print $4 }'
}

start_hypridle() {
    if ! pgrep -x hypridle > /dev/null; then
        hypridle &
    fi
}

off() {
    local pid
    for pid in $(holders); do
        # Its `sleep infinity` first, so systemd-inhibit exits on its own.
        pkill -P "$pid" 2>/dev/null
        kill "$pid" 2>/dev/null
    done
    start_hypridle
}

on() {
    nohup systemd-inhibit \
        --what=handle-lid-switch \
        --who="$WHO" \
        --why="Stay awake: no idle or lid suspend" \
        --mode=block \
        sleep infinity </dev/null >/dev/null 2>&1 &
}

if [[ $1 == off ]]; then
    off
elif ! pgrep -x hypridle > /dev/null; then
    start_hypridle
elif [[ -n $(holders) ]]; then
    off
else
    on
fi

# Refresh the bar's stay-awake glyph so it updates immediately instead of
# waiting for its 30-second poll.
qs -c bar ipc call bar refreshAwake >/dev/null 2>&1 || true
