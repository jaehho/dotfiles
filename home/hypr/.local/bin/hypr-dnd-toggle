#!/bin/bash
# Toggle Do Not Disturb in the bar's notification daemon (Notifs.qml).
# When turning DND on, notify first so the toast is visible before silencing.

ipc() { qs -c bar ipc call notifs "$@"; }

if [[ "$(ipc dnd 2>/dev/null)" == "true" ]]; then
    ipc setDnd false
    notify-send -u low "Notifications" "Do Not Disturb OFF"
else
    notify-send -u low "Notifications" "Do Not Disturb ON"
    sleep 1
    ipc setDnd true
fi
