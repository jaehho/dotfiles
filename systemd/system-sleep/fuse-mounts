#!/bin/bash
# Stop user-scope FUSE mounts before system sleep and restart them after.
# Invoked by systemd-{suspend,hibernate,suspend-then-hibernate} with
# positional args ($1 $2) = (pre <op>) before sleep, (post <op>) after.
#
# Without this hook, Bun/node threads walking into sshfs or rclone mounts
# can stall in D-state (fuse_dentry_revalidate → request_wait_answer) and
# refuse to freeze, which hangs suspend-then-hibernate entirely.
#
# ExecStop on each unit uses `fusermount3 -uz` (lazy unmount) so stopping
# cannot itself hang even if the backend is stalled.

set -u

TARGET_UID=1000
TARGET_USER=jaeho
# Auto-start mounts: always restart on resume.
AUTO_MOUNTS=(sshfs-ice.service sshfs-mililab.service)
# Opt-in mounts: capture pre-suspend state, restore only what was active.
# (Otherwise resume would auto-start a service the user had deliberately
# stopped — same policy as the NM dispatcher hook 50-restart-sshfs.)
OPT_IN_MOUNTS=(sshfs-cdn.service sshfs-msi.service)
# /run is root-owned tmpfs: persists across suspend, cleared on reboot
# (which is what we want — pre-reboot state is meaningless on resume).
STATE_FILE=/run/fuse-mounts-was-active

run_user() {
    runuser -u "$TARGET_USER" -- env \
        "XDG_RUNTIME_DIR=/run/user/$TARGET_UID" \
        "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$TARGET_UID/bus" \
        "$@"
}

case "$1" in
    pre)
        : > "$STATE_FILE"
        for svc in "${OPT_IN_MOUNTS[@]}"; do
            if run_user systemctl --user is-active --quiet "$svc"; then
                echo "$svc" >> "$STATE_FILE"
            fi
        done
        for svc in "${AUTO_MOUNTS[@]}" "${OPT_IN_MOUNTS[@]}"; do
            timeout 10 run_user systemctl --user stop "$svc" || true
        done
        ;;
    post)
        for svc in "${AUTO_MOUNTS[@]}"; do
            run_user systemctl --user start "$svc" || true
        done
        if [[ -f "$STATE_FILE" ]]; then
            while IFS= read -r svc; do
                [[ -n "$svc" ]] && run_user systemctl --user start "$svc" || true
            done < "$STATE_FILE"
            rm -f "$STATE_FILE"
        fi
        ;;
esac

exit 0
