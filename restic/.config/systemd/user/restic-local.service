[Unit]
Description=Local fallback restic backup
OnFailure=backup-failed@%n.service

# A stopgap, not a backup. It lives on the same disk as the data, so it
# survives an `rm -rf`, a bad script or a git mistake -- the failures that
# actually keep happening here -- and nothing else. It exists because the
# homelab repo went unreachable on 2026-09-06 and the machine then had no
# recovery path at all.
#
# Delete this unit once `restic snapshots` against Nextcloud works again.

[Service]
Type=oneshot
# 3 = some files could not be read (something changed mid-run); the snapshot
# is still written, so that is not a failure.
SuccessExitStatus=3
Environment=RESTIC_REPOSITORY=%h/.local/state/restic-local
Environment=RESTIC_PASSWORD_FILE=%h/.config/restic/password
Nice=10
IOSchedulingClass=idle

ExecStartPre=-/usr/bin/restic init
ExecStart=/usr/bin/restic backup \
    --exclude-file %h/.config/restic/excludes \
    --exclude-file %h/.config/restic/excludes-local \
    --one-file-system \
    --tag local-fallback \
    %h/projects \
    %h/dotfiles \
    %h/.thunderbird \
    %h/.claude \
    %h/.config \
    %h/.ssh \
    %h/.gnupg \
    %h/.local/bin \
    %h/.local/state \
    %h/.local/share/applications \
    %h/Pictures
ExecStart=/usr/bin/restic forget --keep-daily 7 --keep-weekly 4 --prune
