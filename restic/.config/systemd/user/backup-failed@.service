[Unit]
Description=Report that %i failed

# Instantiated by OnFailure= in the backup units. Their failures used to be
# silent: restic-backup.service failed three nights running in September 2026
# and nothing said so — the gap was found by hand, days later.

[Service]
Type=oneshot
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
ExecStart=/usr/bin/notify-send -u critical -a "backup" \
    "Backup failed" \
    "%i — journalctl --user -u %i -n 30"
